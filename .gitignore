# dependencies
node_modules/
.pnp
.pnp.js

# production build
.next/
out/
.vercel/

# environment variables – NEVER commit .env.local
.env.local
.env.*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo

