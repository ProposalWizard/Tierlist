# dependencies
node_modules/
.pnp
.pnp.js

# production build
.next/
out/
.vercel/

# environment variables – NEVER commit .env.local
.env.local
.env.*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo

# python
__pycache__/
*.pyc
.audit/

# claude code agent scratch worktrees
.claude/worktrees/

# Playtest driver scratch files. The sandbox harness (and the star-playtest
# agent) writes throwaway Playwright drivers next to the real scripts; they are
# never part of the repo. Any leading underscore, not just _tmp_ — an agent
# writing _repl_tmp.mjs slipped straight past the narrower rule.
scripts/star-sandbox/_*

# Throwaway Next routes an agent spins up to render a canvas in isolation so it
# can SEE a figure at several sizes and poses. Every real graphics bug in this
# project has been found by looking at a rendered frame, so these get written
# often — and they are never part of the app.
app/gfx-harness-tmp/

# Throwaway measurement scripts an agent writes beside the real suites to put a
# number on something (how noisy a 3-rep stage is, where the time actually
# goes) before deciding anything. This project settles arguments by measuring,
# so these get written often — a keeper becomes a real test with a real name.
tests/star/_*
