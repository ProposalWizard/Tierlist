__pycache__/
*.pyc
.audit/

# claude code agent scratch worktrees
.claude/worktrees/

# Playtest driver scratch files. The sandbox harness (and the star-playtest
# agent) writes throwaway Playwright drivers next to the real scripts; they are
# never part of the repo. Any leading underscore, not just _tmp_ — an agent
# writing _repl_tmp.mjs slipped straight past the narrower rule.
scripts/star-sandbox/_*
