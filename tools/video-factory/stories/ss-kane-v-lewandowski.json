          },
          {
            "kind": "bigears",
            "label": "Champions League"
          }
        ]
      }
    },
    {
      "text": "Kane's: the Supercup, the league, and a hat-trick in the cup final.",
      "scene": {
        "type": "trophies",
        "person": "kane",
        "items": [
          {
            "kind": "cup",
            "label": "German Supercup"
          },
          {
            "kind": "league",
            "label": "Bundesliga"
          },
          {
            "kind": "cup",
            "label": "German Cup"
          }
        ]
      }
    },
    {
      "text": "Now the twist. Both seasons were decided by the same club. PSG.",
      "scene": {
        "type": "text",
        "heading": "THE TWIST",
        "body": "Lewandowski's Bayern beat PSG in the 2020 final. Kane's Bayern were knocked out by PSG in the 2026 semi-final.",
        "stamp": "PSG"
      }
    },
    {
      "text": "Twenty twenty: Bayern one, PSG nil. Champions of Europe.",
      "scene": {
        "type": "score",
        "home": "psg",
        "away": "bayern",
        "hs": 0,
        "as": 1,
        "date": "23 Aug 2020",
        "comp": "Champions League final"
      }
    },
    {
      "text": "Twenty twenty-six: PSG win six-five on aggregate. Kane scores in stoppage time. Too late.",
      "scene": {
        "type": "score",
        "home": "bayern",
        "away": "psg",
        "hs": 1,
        "as": 1,
        "date": "6 May 2026",
        "comp": "Champions League semi-final",
        "note": "PSG through 6-5 on aggregate",
        "stamp": "OUT"
      }
    },
    {
      "text": "But there's one prize Lewandowski never got for that season. There was no Ballon d'Or in twenty twenty.",
      "scene": {
        "type": "whatif",
        "title": "THE MISSING BALLON D'OR",
        "real": {
          "label": "Lewandowski 2020",
          "value": "No award held"
        },
        "alt": {
          "label": "Kane 2026",
          "value": "Ballon d'Or"
        }
      }
    },
    {
      "text": "And Lewandowski kept the Bundesliga record too. Forty-one goals, a year later. Kane got to thirty-six.",
      "scene": {
        "type": "versus",
        "title": "BUNDESLIGA SEASON RECORD",
        "left": {
          "person": "lewa",
          "label": "Lewandowski 20-21",
          "value": "41"
        },
        "right": {
          "person": "kane",
          "label": "Kane 25-26",
          "value": "36"
        }
      }
    },
    {
      "text": "Kane has the goals and the golden ball. Lewandowski has Europe. The treble wins it. Lewandowski.",
      "scene": {
        "type": "stamp",
        "text": "LEWANDOWSKI",
        "person": "lewa",
