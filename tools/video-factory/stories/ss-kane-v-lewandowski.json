        "title": "BAYERN GOALS, ALL COMPETITIONS",
        "left": {
          "person": "lewa",
          "label": "Lewandowski 19-20",
          "value": "55"
        },
        "right": {
          "person": "kane",
          "label": "Kane 25-26",
          "value": "61"
        }
      }
    },
    {
      "text": "Lewandowski's trophies: the treble.",
      "scene": {
        "type": "trophies",
        "person": "lewa",
        "items": [
          {
            "kind": "league",
            "label": "Bundesliga"
