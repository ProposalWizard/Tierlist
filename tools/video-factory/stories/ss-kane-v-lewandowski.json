        "type": "score",
        "home": "barca",
        "away": "bayern",
        "hs": 2,
        "as": 8,
        "date": "14 Aug 2020",
        "comp": "Champions League quarter-final",
        "stamp": "EIGHT"
      }
    },
    {
      "text": "Harry Kane, last season. Sixty-one goals for Bayern, seventy-three counting England.",
      "scene": {
        "type": "stats",
        "title": "KANE 2025-26",
        "person": "kane",
        "items": [
          {
            "n": "61",
            "l": "goals for Bayern"
          },
          {
            "n": "73",
            "l": "with England"
          },
          {
            "n": "36",
            "l": "Bundesliga goals"
          }
        ]
      }
    },
    {
      "text": "Club goals only? Kane wins by six.",
