            "value": "56",
            "club": "fio"
          }
        ]
      }
    },
    {
      "text": "Without the deduction? Seventy-two, level with Inter in the top four.",
      "scene": {
        "type": "whatif",
        "title": "Without the deduction",
        "real": {
          "label": "Juventus, 7th",
          "value": "62"
        },
        "alt": {
          "label": "Top four",
          "value": "72"
        }
      }
    },
    {
      "text": "Seventh still meant the Conference League. Then UEFA stepped in.",
      "scene": {
        "type": "timeline",
        "title": "2023",
        "items": [
          {
            "year": "Jan",
            "label": "-15 points"
          },
          {
            "year": "Apr",
            "label": "Points back"
          },
          {
            "year": "May",
            "label": "-10 points"
          },
          {
            "year": "Jul",
            "label": "Out of Europe"
          }
        ]
      }
    },
    {
      "text": "Juve agreed a deal with UEFA over its financial rules: a fine, and no European football for a season.",
      "scene": {
        "type": "stamp",
        "text": "OUT OF EUROPE",
        "color": "red"
      }
    },
    {
      "text": "Eighth-placed Fiorentina took their Conference League spot.",
      "scene": {
        "type": "text",
        "heading": "Lucky Fiorentina",
        "body": "Eighth in Serie A, Fiorentina took Juventus's place in the 2023-24 Conference League."
      }
    },
    {
      "text": "A second case, over players' wages in the Covid years, ended in a plea deal: seven hundred and eighteen thousand euros, and no extra points.",
      "scene": {
        "type": "stats",
        "title": "The wages case",
        "items": [
          {
            "n": "€718,000",
            "l": "fine"
          },
          {
            "n": "0",
            "l": "extra points lost"
          }
        ]
      }
    },
    {
      "text": "Two cases. Ten points, a top-four finish and a whole season of Europe gone.",
      "scene": {
        "type": "person",
        "person": "allegri",
        "label": "JUVENTUS 2022-23",
        "mood": "worried"
      }
    },
