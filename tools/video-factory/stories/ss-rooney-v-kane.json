  "lines": [
    { "text": "England's two greatest goalscorers. Their best seasons. Only one ends with a medal.", "scene": { "type": "title", "heading": "ROONEY v KANE", "sub": "2009-10 v 2017-18", "pill": "SETTLED", "person": "rooney" } },
    { "text": "Wayne Rooney, twenty oh nine, ten. Ronaldo has just left for Madrid. Rooney becomes the main man.", "scene": { "type": "person", "person": "rooney", "label": "Man United · 2009-10", "mood": "happy" } },
    { "text": "Twenty-six league goals, thirty-four in all. Football Writers' Player of the Year.", "scene": { "type": "stats", "title": "ROONEY 2009-10", "person": "rooney", "items": [ { "n": "26", "l": "league goals" }, { "n": "34", "l": "all competitions" } ] } },
    { "text": "Harry Kane, twenty seventeen, eighteen. Spurs at Wembley.", "scene": { "type": "person", "person": "kane", "label": "Spurs · 2017-18", "mood": "happy" } },
    { "text": "Thirty league goals, forty-one in all. And in twenty seventeen he broke Shearer's record: thirty-nine Premier League goals in a calendar year.", "scene": { "type": "stats", "title": "KANE 2017-18", "person": "kane", "items": [ { "n": "30", "l": "league goals" }, { "n": "41", "l": "all competitions" }, { "n": "39", "l": "PL goals in 2017" } ] } },
    { "text": "Numbers? Kane, clearly.", "scene": { "type": "versus", "title": "ALL COMPETITIONS", "left": { "person": "rooney", "label": "Rooney 09-10", "value": "34" }, "right": { "person": "kane", "label": "Kane 17-18", "value": "41" } } },
    { "text": "Trophies? Rooney won the League Cup. Kane won nothing.", "scene": { "type": "score", "home": "manutd", "away": "villa", "hs": 2, "as": 1, "date": "28 Feb 2010", "comp": "League Cup final" } },
    { "text": "And Rooney's United missed the title by one point. Kane's Spurs finished third.", "scene": { "type": "list", "title": "WHERE THEY FINISHED", "rows": [ { "name": "Chelsea 2009-10", "value": "86 pts", "club": "chelsea" }, { "name": "Man United 2009-10", "value": "85 pts", "club": "manutd", "hl": true }, { "name": "Spurs 2017-18 (3rd)", "value": "77 pts", "club": "spurs", "hl": true } ] } },
    { "text": "Now the twist. Neither of them won the Golden Boot.", "scene": { "type": "stamp", "text": "NO GOLDEN BOOT", "color": "red" } },
    { "text": "Drogba beat Rooney with twenty-nine. Salah beat Kane with thirty-two.", "scene": { "type": "list", "title": "WHO BEAT THEM", "rows": [ { "name": "Drogba 2009-10", "value": "29", "club": "chelsea", "hl": true }, { "name": "Rooney 2009-10", "value": "26", "club": "manutd" }, { "name": "Salah 2017-18", "value": "32", "club": "liverpool", "hl": true }, { "name": "Kane 2017-18", "value": "30", "club": "spurs" } ] } },
    { "text": "Rooney's what-if: he got injured against Bayern in the spring, and United lost to Chelsea without him.", "scene": { "type": "whatif", "title": "IN THIS ALTERNATE WORLD", "real": { "label": "Rooney injured", "value": "United 2nd by a point" }, "alt": { "label": "Imagined fit Rooney", "value": "Title race goes on" } } },
    { "text": "Kane scored more. Rooney came closer to winning it all, and got a medal. Settled: Rooney.", "scene": { "type": "stamp", "text": "ROONEY", "person": "rooney", "color": "white" } },
    { "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.", "scene": { "type": "cta" } }
  ]
