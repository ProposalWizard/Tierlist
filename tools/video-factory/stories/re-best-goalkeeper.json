  "lines": [
    {
      "text": "Ten of the best goalkeepers alive. Three rules. One pair of gloves left.",
      "scene": {
        "type": "title",
        "heading": "BEST GOALKEEPER",
        "sub": "November 2026",
        "pill": "THREE RULES",
        "person": "simon"
      }
    },
    {
      "text": "Simón, Raya, Donnarumma, Courtois, Alisson, Martínez, Oblak, Maignan, Joan García and Kobel.",
      "scene": {
        "type": "list",
        "title": "Our ten keepers",
        "rows": [
          {
            "name": "Unai Simón",
            "value": "Athletic",
            "club": "ath"
          },
          {
            "name": "David Raya",
            "value": "Arsenal",
            "club": "ars"
          },
          {
            "name": "Gianluigi Donnarumma",
            "value": "Man City",
            "club": "mci"
          },
          {
            "name": "Thibaut Courtois",
            "value": "Real Madrid",
            "club": "rma"
          },
          {
            "name": "Alisson",
            "value": "Liverpool",
            "club": "liv"
          },
          {
            "name": "Emiliano Martínez",
            "value": "Argentina",
            "club": "arg"
          },
          {
            "name": "Oblak · Maignan",
            "value": "+2"
          },
          {
            "name": "Joan García · Kobel",
            "value": "+2"
          }
        ]
      }
    },
    {
      "text": "Rule one. You must have won the Yashin Trophy, the Ballon d'Or for keepers.",
      "scene": {
        "type": "text",
        "heading": "RULE 1",
        "body": "Must have won the Yashin Trophy at least once."
      }
    },
    {
      "text": "Raya has three Golden Gloves in a row, but no Yashin. He's out, with Oblak, Maignan, García and Kobel.",
      "scene": {
        "type": "stamp",
        "text": "NO YASHIN",
        "person": "raya",
        "color": "yellow"
      }
    },
    {
      "text": "Five left. Alisson, Donnarumma, Courtois, Martínez and Simón.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "2019",
            "label": "Alisson"
          },
          {
            "year": "2021",
            "label": "Donnarumma"
          },
          {
            "year": "2022",
            "label": "Courtois"
          },
          {
            "year": "23-24",
            "label": "Martínez"
          },
          {
            "year": "2025",
            "label": "Donnarumma"
          },
          {
            "year": "2026",
            "label": "Simón"
          }
        ]
      }
    },
    {
      "text": "Rule two. You must have won a World Cup.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "Must have won the World Cup."
      }
    },
    {
      "text": "Only two have. Martínez in twenty twenty-two, and Simón this summer.",
      "scene": {
        "type": "versus",
        "title": "World Cup winners",
        "left": {
          "person": "martinez",
          "label": "Martínez",
          "value": "2022"
        },
        "right": {
          "person": "simon",
          "label": "Simón",
          "value": "2026"
        }
      }
    },
    {
      "text": "Rule three. Head to head. Who won the last World Cup final?",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "Winner of the last World Cup final between them goes through."
      }
    },
    {
      "text": "July, New Jersey. Spain one, Argentina nil, after extra time. Ferran Torres in the hundred and sixth minute.",
      "scene": {
        "type": "score",
        "home": "esp",
        "away": "arg",
        "hs": 1,
        "as": 0,
        "date": "19 July 2026",
        "comp": "World Cup final",
        "note": "After extra time. Torres 106'."
      }
    },
    {
      "text": "So Martínez goes, and Unai Simón is the last man standing.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "martinez",
        "color": "red"
      }
    },
    {
      "text": "Seven World Cup clean sheets, the Golden Glove, and last month, the Yashin Trophy.",
      "scene": {
        "type": "stats",
        "title": "Unai Simón, 2026",
        "items": [
          {
            "n": "7",
            "l": "WC clean sheets"
          },
          {
            "n": "1",
            "l": "goal conceded"
          },
          {
            "n": "1",
            "l": "Yashin Trophy"
          }
        ],
        "person": "simon"
      }
    },
    {
      "text": "Agree? Or is Raya robbed again?",
      "scene": {
        "type": "person",
        "person": "simon",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
      "text": "Follow for more.",
