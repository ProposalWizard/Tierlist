          },
          {
            "n": "0",
            "l": "Yashin Trophies"
          }
        ],
        "person": "raya"
      }
    },
    {
      "text": "He's out. So are Oblak, Maignan, García and Kobel. Five gone.",
      "say": "He's out. So are Obblak, Menyon, Garseeah and Kohbel. Five gone.",
      "scene": {
        "type": "stamp",
        "text": "NO YASHIN",
        "sub": "Raya, Oblak, Maignan, García, Kobel",
        "person": "raya",
        "color": "red"
      }
    },
    {
      "text": "Rule two. You must be a world champion.",
      "scene": {
        "type": "trophies",
