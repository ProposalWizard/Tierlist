            "value": "7",
            "club": "mun"
          }
        ]
      }
    },
    {
      "text": "So Isak, Tavernier and Mbeumo are out, even with six, five and four goals.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "isak",
        "color": "red"
      }
    },
    {
      "text": "Rule two. You must have won a Player of the Month award this season.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "Must have won a Premier League Player of the Month award in 2026-27."
      }
    },
    {
      "text": "August went to João Pedro. September went to Brighton's Pascal Groß, at thirty-five, for the first time ever.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "AUG",
            "label": "João Pedro"
          },
          {
            "year": "SEP",
            "label": "Pascal Groß"
          },
          {
            "year": "OCT",
            "label": "Not out yet"
          }
        ]
      }
    },
    {
      "text": "Haaland, Saka, Rogers, Cherki and Palmer have not won one yet. Gone.",
      "scene": {
        "type": "stamp",
        "text": "NO AWARD",
        "person": "haaland",
        "color": "yellow"
      }
    },
    {
      "text": "Rule three. Most league goals wins.",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "The one with more Premier League goals goes through."
      }
    },
    {
      "text": "Groß has three. João Pedro has five.",
      "scene": {
        "type": "versus",
        "title": "League goals",
        "left": {
          "person": "joaopedro",
          "label": "João Pedro",
          "value": "5"
        },
        "right": {
          "person": "gross",
          "label": "Groß",
          "value": "3"
        }
      }
    },
    {
      "text": "So the rules pick João Pedro. Chelsea's number nine, fourth in the table, and still climbing.",
      "scene": {
        "type": "person",
        "person": "joaopedro",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
      "text": "Do you agree? Or is Haaland the real answer?",
      "scene": {
        "type": "person",
        "person": "haaland",
        "label": "TOP SCORER, NO AWARD YET",
        "mood": "worried"
      }
    },
    {
