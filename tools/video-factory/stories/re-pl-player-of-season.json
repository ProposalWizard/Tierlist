  "lines": [
    {
      "text": "Who is the Premier League's player of the season so far? Ten names, three rules, one left.",
      "scene": {
        "type": "title",
        "heading": "PLAYER OF THE SEASON",
        "sub": "Premier League · after nine games",
        "pill": "THREE RULES",
        "person": "joaopedro"
      }
    },
    {
      "text": "Our ten: Haaland, Isak, João Pedro, Groß, Rogers, Tavernier, Saka and Cherki. Plus Mbeumo and Palmer.",
      "scene": {
        "type": "list",
        "title": "Our ten",
        "rows": [
          {
