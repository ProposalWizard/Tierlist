            "name": "Eberechi Eze",
            "value": "LW"
          }
        ]
      }
    },
    {
      "text": "Gyökeres takes a seat. In comes Henry, the two thousand and four version.",
      "scene": {
        "type": "person",
        "person": "henry",
        "label": "PRIME HENRY · 2003/04",
        "mood": "happy",
        "stamp": "SUBBED IN"
      }
    },
    {
      "text": "That season he scored thirty league goals, thirty-nine in all, and Arsenal never lost a league game.",
      "scene": {
        "type": "stats",
        "title": "HENRY 2003/04",
        "items": [
          {
            "n": "30",
            "l": "league goals"
          },
          {
            "n": "39",
            "l": "all competitions"
          },
          {
            "n": "0",
            "l": "league defeats"
          }
        ],
        "person": "henry"
      }
    },
    {
      "text": "PSG bring Safonov, Hakimi, Marquinhos, Vitinha, and Dembélé up front.",
      "scene": {
        "type": "list",
        "title": "PSG XI",
        "rows": [
          {
            "name": "Matvey Safonov",
            "value": "GK"
          },
          {
            "name": "Hakimi · Marquinhos · Pacho · Mendes",
            "value": "DEF"
          },
          {
            "name": "Neves · Vitinha · Ruiz",
            "value": "MID"
          },
          {
            "name": "Désiré Doué",
            "value": "RW"
          },
          {
            "name": "Ousmane Dembélé",
            "value": "ST",
            "hl": true
          },
          {
            "name": "Khvicha Kvaratskhelia",
            "value": "LW"
          }
        ]
      }
    },
    {
      "text": "Twelve minutes. Henry drifts left, cuts in, and side-foots it into the far corner. One-nil.",
      "scene": {
        "type": "score",
        "home": "ars",
        "away": "psg",
        "hs": 1,
        "as": 0,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Henry 12'"
      }
    },
    {
      "text": "PSG hit back. Dembélé from the spot, just like in Budapest. One-all.",
      "scene": {
        "type": "score",
        "home": "ars",
        "away": "psg",
        "hs": 1,
        "as": 1,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Henry 12' · Dembélé 34' pen"
      }
    },
    {
      "text": "Second half. Saka slides it in, Henry flicks it round Marquinhos. Two-one.",
      "scene": {
        "type": "versus",
        "title": "THE DUEL",
        "left": {
          "person": "henry",
          "label": "Henry",
          "value": "2 goals"
        },
        "right": {
          "person": "dembele",
          "label": "Dembélé",
          "value": "1 goal"
        }
      }
    },
    {
      "text": "Kvaratskhelia levels it again. Then Rice whips in a corner, and Gabriel heads the winner.",
      "scene": {
        "type": "score",
        "home": "ars",
        "away": "psg",
        "hs": 3,
        "as": 2,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Kvaratskhelia 71' · Gabriel 84'",
        "stamp": "REVENGE"
      }
    },
    {
      "text": "Full time in our prediction: Arsenal three, PSG two. Budapest, avenged.",
      "scene": {
        "type": "score",
        "home": "ars",
        "away": "psg",
        "hs": 3,
        "as": 2,
        "date": "Full time · prediction",
        "comp": "Imagined match",
        "note": "Henry 2, Gabriel · Dembélé pen, Kvaratskhelia"
