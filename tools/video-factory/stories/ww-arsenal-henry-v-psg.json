        "type": "score",
        "home": "psg",
        "away": "ars",
        "hs": 1,
        "as": 1,
        "date": "30 May 2026",
        "comp": "Champions League final",
        "note": "PSG won 4-3 on penalties"
      }
    },
    {
      "text": "Here's Arsenal, top of the league with twenty-four points from nine games. One change up front.",
      "scene": {
        "type": "list",
        "title": "ARSENAL XI",
        "rows": [
          {
            "name": "David Raya",
            "value": "GK"
