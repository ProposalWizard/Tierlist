  "lines": [
    { "text": "Twenty-three men have lifted the World Cup as captain. One was twenty-five. One was forty.", "scene": { "type": "title", "heading": "WORLD CUP CAPTAINS", "sub": "Every winning captain · 1930 to 2026", "pill": "BY AGE", "person": "zoff" } },
    { "text": "The youngest? Daniel Passarella, Argentina, nineteen seventy-eight. Twenty-five years and thirty-one days.", "scene": { "type": "person", "person": "passarella", "label": "25 · 1978", "mood": "happy", "stamp": "YOUNGEST" } },
    { "text": "Three more did it at twenty-five. Bobby Moore, Carlos Alberto, and Diego Maradona.", "scene": { "type": "list", "title": "AGED 25", "rows": [ { "name": "Daniel Passarella (1978)", "value": "25", "club": "arg", "hl": true }, { "name": "Bobby Moore (1966)", "value": "25", "club": "eng" }, { "name": "Carlos Alberto (1970)", "value": "25", "club": "bra" }, { "name": "Diego Maradona (1986)", "value": "25", "club": "arg" } ] } },
    { "text": "Then twenty-seven to twenty-nine: Meazza, Beckenbauer, Matthaus, Deschamps and Iker Casillas.", "scene": { "type": "list", "title": "AGED 27 TO 29", "rows": [ { "name": "Giuseppe Meazza (1938)", "value": "27", "club": "ita" }, { "name": "Bellini (1958)", "value": "28", "club": "bra" }, { "name": "Franz Beckenbauer (1974)", "value": "28", "club": "ger" }, { "name": "Jose Nasazzi (1930)", "value": "29", "club": "uru" }, { "name": "Lothar Matthaus (1990)", "value": "29", "club": "ger" }, { "name": "Didier Deschamps (1998)", "value": "29", "club": "fra" }, { "name": "Iker Casillas (2010)", "value": "29", "club": "esp" } ] } },
    { "text": "Thirty and thirty-one: Dunga, Philipp Lahm, Hugo Lloris, and this summer's captain, Rodri.", "scene": { "type": "list", "title": "AGED 30 TO 31", "rows": [ { "name": "Dunga (1994)", "value": "30", "club": "bra" }, { "name": "Philipp Lahm (2014)", "value": "30", "club": "ger" }, { "name": "Rodri (2026)", "value": "30", "club": "esp", "hl": true }, { "name": "Gianpiero Combi (1934)", "value": "31", "club": "ita" }, { "name": "Mauro Ramos (1962)", "value": "31", "club": "bra" }, { "name": "Hugo Lloris (2018)", "value": "31", "club": "fra" } ] } },
    { "text": "Rodri lifted it in New Jersey, after Spain beat Argentina one-nil in extra time.", "scene": { "type": "score", "home": "esp", "away": "arg", "hs": 1, "as": 0, "date": "19 July 2026", "comp": "World Cup final", "note": "after extra time" } },
    { "text": "Thirty-two is the hard-man age. Obdulio Varela, Cafu, Fabio Cannavaro.", "scene": { "type": "list", "title": "AGED 32 TO 33", "rows": [ { "name": "Obdulio Varela (1950)", "value": "32", "club": "uru" }, { "name": "Cafu (2002)", "value": "32", "club": "bra" }, { "name": "Fabio Cannavaro (2006)", "value": "32", "club": "ita" }, { "name": "Fritz Walter (1954)", "value": "33", "club": "ger" } ] } },
    { "text": "Cannavaro lifted it in Berlin and won the Ballon d'Or that same year.", "scene": { "type": "trophies", "person": "cannavaro", "items": [ { "kind": "worldcup", "label": "World Cup 2006" }, { "kind": "ballon", "label": "Ballon d'Or 2006" } ] } },
    { "text": "Then a big jump. Lionel Messi, finally, at thirty-five.", "scene": { "type": "person", "person": "messi", "label": "35 · 2022", "mood": "happy" } },
    { "text": "And still not the oldest. That's Dino Zoff. Italy's goalkeeper, nineteen eighty-two, forty years old.", "scene": { "type": "person", "person": "zoff", "label": "40 · 1982", "mood": "happy", "stamp": "OLDEST" } },
    { "text": "Fifteen years separate the youngest from the oldest.", "scene": { "type": "versus", "title": "THE GAP", "left": { "person": "passarella", "label": "Passarella 1978", "value": "25" }, "right": { "person": "zoff", "label": "Zoff 1982", "value": "40" } } },
    { "text": "And Zoff did it just four years after Passarella.", "scene": { "type": "timeline", "items": [ { "year": "1978", "label": "Passarella, 25" }, { "year": "1982", "label": "Zoff, 40" }, { "year": "2022", "label": "Messi, 35" }, { "year": "2026", "label": "Rodri, 30" } ] } },
    { "text": "So which one is the greatest captain? Tell me in the comments.", "scene": { "type": "stats", "title": "WINNING CAPTAINS", "items": [ { "n": "23", "l": "captains" }, { "n": "25", "l": "youngest" }, { "n": "40", "l": "oldest" } ] } },
    { "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.", "scene": { "type": "cta" } }
  ]
}
