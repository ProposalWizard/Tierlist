  "lines": [
    {
      "text": "Who would win: Barcelona twenty oh-nine, or Barcelona twenty fifteen?",
      "scene": {
        "type": "title",
        "heading": "BARÇA 2009 v BARÇA 2015",
        "sub": "An imagined match · a prediction",
        "pill": "WHO WOULD WIN?",
        "person": "messi09"
      }
    },
    {
      "text": "Both teams won the Champions League final. Rome, two-nil against United. Berlin, three-one against Juventus.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "2009",
            "label": "Rome: 2-0 v Man United"
          },
          {
            "year": "2015",
            "label": "Berlin: 3-1 v Juventus"
          },
          {
            "year": "Now",
            "label": "Who would win?"
          }
        ]
      }
    },
    {
      "text": "Twenty oh-nine: Puyol, Xavi, Iniesta, and a front three of Messi, Eto'o and Henry.",
      "scene": {
        "type": "list",
        "title": "BARÇA 2009 · ROME XI",
        "rows": [
          {
            "name": "Víctor Valdés",
            "value": "GK"
          },
          {
            "name": "Puyol · Touré · Piqué · Sylvinho",
            "value": "DEF"
          },
          {
            "name": "Busquets · Xavi · Iniesta",
            "value": "MID"
          },
          {
            "name": "Messi · Eto'o · Henry",
            "value": "ATT",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "Twenty fifteen: Alves, Rakitić, and the famous M S N.",
      "scene": {
        "type": "list",
        "title": "BARÇA 2015 · BERLIN XI",
        "rows": [
          {
            "name": "Marc-André ter Stegen",
            "value": "GK"
          },
          {
            "name": "Alves · Piqué · Mascherano · Alba",
            "value": "DEF"
          },
          {
            "name": "Rakitić · Busquets · Iniesta",
            "value": "MID"
          },
          {
            "name": "Messi · Suárez · Neymar",
            "value": "ATT",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "The twist: Messi, Iniesta, Busquets and Piqué started both finals. So here, they play against themselves.",
      "scene": {
        "type": "whatif",
        "title": "WHO PLAYS WHO",
        "real": {
          "label": "2009",
          "value": "Messi, aged 21"
        },
        "alt": {
          "label": "2015",
          "value": "Messi, aged 27"
        }
      }
    },
    {
      "text": "Young Messi against older Messi. Twenty-one against twenty-seven.",
      "scene": {
        "type": "versus",
        "title": "MESSI v MESSI",
        "left": {
          "person": "messi09",
          "label": "Messi 2009",
          "value": "21"
        },
        "right": {
          "person": "messi15",
          "label": "Messi 2015",
          "value": "27"
        }
      }
    },
    {
      "text": "Ten minutes, just like Rome. Eto'o, near post. One-nil twenty oh-nine.",
      "scene": {
        "type": "score",
        "home": "b09",
        "away": "b15",
        "hs": 1,
        "as": 0,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Eto'o 10'"
      }
    },
    {
      "text": "M S N wake up. Neymar to Suárez. One-all. Then young Messi skips past old Messi. Two-one.",
      "scene": {
        "type": "score",
        "home": "b09",
        "away": "b15",
        "hs": 2,
        "as": 1,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Suárez 31' · Messi (2009) 44'"
      }
    },
    {
      "text": "Rakitić from the edge, like Berlin. Two-all.",
      "scene": {
        "type": "score",
        "home": "b09",
        "away": "b15",
        "hs": 2,
        "as": 2,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Rakitić 63'"
      }
    },
    {
      "text": "Deep in stoppage time, Neymar again, just like Berlin. Twenty fifteen win it, three-two.",
      "scene": {
        "type": "score",
        "home": "b09",
        "away": "b15",
        "hs": 2,
        "as": 3,
        "date": "Full time · prediction",
        "comp": "Imagined match",
        "note": "Neymar 90+7'",
        "stamp": "LIKE BERLIN"
      }
    },
    {
      "text": "Man of the match: Neymar. Then young Messi, then Xavi, who ran the whole thing.",
      "scene": {
        "type": "podium",
        "year": "Imagined",
