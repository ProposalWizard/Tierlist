      "l": "in pounds"
     }
    ],
    "person": "haaland"
   }
  },
  {
   "text": "Real Madrid wanted him too. But they were chasing Kylian Mbappé first.",
   "scene": {
    "type": "versus",
    "title": "MADRID'S SUMMER",
    "left": {
     "person": "haalandbvb",
     "label": "Haaland",
     "value": "Plan B"
