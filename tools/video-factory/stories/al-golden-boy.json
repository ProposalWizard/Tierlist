  "lines": [
    { "text": "The Golden Boy is the best footballer in Europe under twenty-one. Here's every winner, from youngest to oldest.", "scene": { "type": "title", "heading": "GOLDEN BOY, BY AGE", "sub": "Every winner · 2003 to 2025", "pill": "YOUNGEST TO OLDEST", "person": "yamal" } },
    { "text": "The youngest ever? Lamine Yamal, twenty twenty-four. Seventeen years and a hundred and thirty-seven days.", "scene": { "type": "person", "person": "yamal", "label": "17 · 2024", "mood": "happy", "stamp": "YOUNGEST" } },
    { "text": "Then three eighteen-year-olds. Gavi, Messi, and Kylian Mbappe.", "scene": { "type": "list", "title": "AGED 17 AND 18", "rows": [ { "name": "Lamine Yamal (2024)", "value": "17y 137d", "club": "barca", "hl": true }, { "name": "Gavi (2022)", "value": "18y 77d", "club": "barca" }, { "name": "Lionel Messi (2005)", "value": "18y 173d", "club": "barca" }, { "name": "Kylian Mbappe (2017)", "value": "18y 307d", "club": "monaco" }, { "name": "Pedri (2021)", "value": "18y 362d", "club": "barca" } ] } },
    { "text": "Pedri missed being nineteen by three days. That's four Barcelona players in the top five.", "scene": { "type": "stats", "title": "BARCELONA ACADEMY", "items": [ { "n": "4", "l": "of the 5 youngest" }, { "n": "3", "l": "days short of 19: Pedri" } ] } },
    { "text": "Nineteen: Wayne Rooney, Cesc Fabregas, Sergio Aguero, Mario Gotze, Renato Sanches and Matthijs de Ligt.", "scene": { "type": "list", "title": "AGED 19", "rows": [ { "name": "Wayne Rooney (2004)", "value": "19y 50d", "club": "manutd" }, { "name": "Renato Sanches (2016)", "value": "19y 67d", "club": "benfica" }, { "name": "Matthijs de Ligt (2018)", "value": "19y 127d", "club": "ajax" }, { "name": "Sergio Aguero (2007)", "value": "19y 188d", "club": "atleti" }, { "name": "Mario Gotze (2011)", "value": "19y 189d", "club": "dortmund" }, { "name": "Cesc Fabregas (2006)", "value": "19y 212d", "club": "arsenal" } ] } },
    { "text": "Twenty is where most of them land. Sterling, Martial, Joao Felix, Balotelli, all just past their birthday.", "scene": { "type": "list", "title": "AGED 20, PART ONE", "rows": [ { "name": "Raheem Sterling (2014)", "value": "20y 12d", "club": "liverpool" }, { "name": "Mario Balotelli (2010)", "value": "20y 13d", "club": "inter" }, { "name": "Anthony Martial (2015)", "value": "20y 14d", "club": "monaco" }, { "name": "Joao Felix (2019)", "value": "20y 17d", "club": "benfica" }, { "name": "Alexandre Pato (2009)", "value": "20y 102d", "club": "milan" }, { "name": "Erling Haaland (2020)", "value": "20y 123d", "club": "dortmund" } ] } },
    { "text": "Then Desire Doue, Jude Bellingham, Anderson, Isco and Paul Pogba.", "scene": { "type": "list", "title": "AGED 20, PART TWO", "rows": [ { "name": "Desire Doue (2025)", "value": "20y 154d", "club": "psg" }, { "name": "Jude Bellingham (2023)", "value": "20y 159d", "club": "realmadrid" }, { "name": "Anderson (2008)", "value": "20y 237d", "club": "manutd" }, { "name": "Isco (2012)", "value": "20y 245d", "club": "malaga" }, { "name": "Paul Pogba (2013)", "value": "20y 264d", "club": "juve" } ] } },
    { "text": "And the oldest ever is the very first winner. Rafael van der Vaart, twenty oh three. Twenty years, three hundred and four days.", "scene": { "type": "person", "person": "vdv", "label": "20 · 2003", "mood": "happy", "stamp": "OLDEST" } },
    { "text": "Nobody older has won it in the twenty-two editions since.", "scene": { "type": "versus", "title": "THE RANGE", "left": { "person": "yamal", "label": "Yamal 2024", "value": "17y 137d" }, "right": { "person": "vdv", "label": "Van der Vaart 2003", "value": "20y 304d" } } },
    { "text": "Last year's winner, Desire Doue, won it at twenty, after a season at PSG.", "scene": { "type": "person", "person": "doue", "label": "20 · 2025", "mood": "happy" } },
    { "text": "And from this list? Messi, Mbappe, Haaland, Bellingham, Yamal. The Golden Boy is a pretty good crystal ball.", "scene": { "type": "timeline", "items": [ { "year": "2005", "label": "Messi" }, { "year": "2017", "label": "Mbappe" }, { "year": "2020", "label": "Haaland" }, { "year": "2023", "label": "Bellingham" }, { "year": "2024", "label": "Yamal" } ] } },
    { "text": "Who wins it next? Tell me in the comments.", "scene": { "type": "stamp", "text": "WHO'S NEXT?", "color": "yellow" } },
    { "text": "Follow for more.", "scene": { "type": "cta" } }
  ]
}
