        "type": "versus",
        "title": "BEST LEAGUE SEASON",
        "left": {
          "person": "ronaldo",
          "label": "Ronaldo 07/08",
          "value": "31"
        },
        "right": {
          "person": "haaland",
          "label": "Haaland 22/23",
          "value": "36"
        }
      }
    },
    {
      "text": "Fifteen minutes. Haaland, of course. He already has nine league goals this season. Nil-one.",
      "scene": {
        "type": "score",
        "home": "rma",
        "away": "mci",
        "hs": 0,
        "as": 1,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Haaland 15'"
      }
    },
    {
      "text": "Thirty yards out, Ronaldo plants the feet. Knuckleball. Donnarumma doesn't move. One-all.",
