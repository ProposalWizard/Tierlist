        "type": "score",
        "home": "rma",
        "away": "mci",
        "hs": 1,
        "as": 1,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Ronaldo 33' (free kick)"
      }
    },
    {
      "text": "Mbappé squares it, Ronaldo taps in. Then Haaland heads one back. Two-all.",
      "scene": {
        "type": "score",
        "home": "rma",
        "away": "mci",
        "hs": 2,
        "as": 2,
        "date": "Prediction",
        "comp": "Imagined match",
        "note": "Ronaldo 61' · Haaland 79'"
      }
    },
    {
      "text": "Ninety minutes. Cross from the right. Ronaldo hangs in the air forever. Three-two.",
