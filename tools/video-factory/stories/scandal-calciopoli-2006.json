  "lines": [
    {
      "text": "In twenty oh six, Juventus went from champions of Italy to Serie B. And that same summer, Italy won the World Cup.",
      "scene": {
        "type": "title",
        "heading": "CALCIOPOLI",
        "sub": "Italy · 2006",
        "pill": "FOOTBALL'S BIGGEST SCANDALS",
        "person": "moggi"
      }
    },
    {
      "text": "Calciopoli: an investigation into club bosses and their links to the people who picked referees.",
      "scene": {
        "type": "text",
        "heading": "Calciopoli",
        "body": "Italy's 2006 scandal: clubs were found to have tried to influence referee appointments. Several Serie A clubs were punished."
      }
    },
    {
      "text": "At the centre was Juventus general manager Luciano Moggi.",
      "scene": {
        "type": "person",
        "person": "moggi",
        "label": "LUCIANO MOGGI · JUVENTUS",
        "mood": "worried"
      }
    },
    {
      "text": "The punishment was brutal. Juve lost their twenty oh five and twenty oh six titles.",
      "scene": {
        "type": "trophies",
        "title": "Titles taken",
        "items": [
          {
            "kind": "league",
            "label": "2004-05"
          },
          {
            "kind": "league",
            "label": "2005-06"
          }
        ],
        "stamp": "STRIPPED"
      }
    },
    {
      "text": "The twenty oh five title was never given to anyone. Inter were handed twenty oh six.",
      "scene": {
        "type": "list",
        "title": "Serie A titles",
        "rows": [
          {
            "name": "2004-05",
            "value": "NOT AWARDED"
          },
          {
            "name": "2005-06",
            "value": "INTER",
            "club": "inter",
            "hl": true
          },
          {
            "name": "Juventus",
            "value": "LAST",
            "club": "juv"
          }
        ]
      }
    },
    {
      "text": "And Juventus were sent down to Serie B.",
      "scene": {
        "type": "stamp",
        "text": "RELEGATED",
        "color": "red"
      }
    },
    {
      "text": "Their points penalty started at thirty, was cut to seventeen, and finally to nine.",
      "scene": {
        "type": "timeline",
        "title": "Juve's points penalty",
        "items": [
          {
            "year": "-30",
            "label": "July 2006"
          },
          {
            "year": "-17",
            "label": "Appeal, July"
          },
          {
            "year": "-9",
            "label": "October 2006"
          }
        ]
      }
    },
    {
      "text": "Milan, Fiorentina and Lazio were docked points too, but stayed in Serie A.",
      "scene": {
        "type": "list",
        "title": "Also punished",
        "rows": [
          {
            "name": "Juventus",
            "value": "Serie B",
            "club": "juv",
            "hl": true
          },
          {
            "name": "Milan",
            "value": "-8 pts",
            "club": "mil"
          },
          {
            "name": "Fiorentina",
            "value": "pts off",
            "club": "fio"
          },
          {
            "name": "Lazio",
            "value": "pts off",
            "club": "laz"
          }
        ]
      }
    },
    {
      "text": "Moggi was later banned from football for life.",
      "scene": {
        "type": "person",
        "person": "moggi",
        "label": "BANNED FOR LIFE",
        "mood": "flat",
        "stamp": "BANNED"
      }
    },
    {
      "text": "Here's the twist. While all this blew up, Italy were at the World Cup in Germany.",
      "scene": {
        "type": "person",
        "person": "cannavaro",
        "label": "ITALY CAPTAIN",
        "mood": "happy"
      }
    },
    {
      "text": "Five Juventus players were in that squad.",
      "scene": {
        "type": "list",
        "title": "Juve's World Cup five",
        "rows": [
          {
            "name": "Gianluigi Buffon",
            "value": "GK",
            "club": "juv"
          },
          {
            "name": "Fabio Cannavaro",
            "value": "DF",
            "club": "juv"
          },
          {
            "name": "Gianluca Zambrotta",
            "value": "DF",
            "club": "juv"
          },
          {
            "name": "Mauro Camoranesi",
            "value": "MF",
            "club": "juv"
          },
          {
            "name": "Alessandro Del Piero",
            "value": "FW",
            "club": "juv"
          }
        ]
      }
    },
    {
      "text": "Ninth of July, Berlin. One-one with France, then five-three on penalties. Italy are world champions.",
      "scene": {
        "type": "score",
        "home": "ita",
        "away": "fra",
        "hs": 1,
        "as": 1,
        "date": "9 July 2006",
        "comp": "World Cup final",
        "note": "Italy win 5-3 on penalties"
      }
    },
    {
      "text": "Juventus went down, then came straight back up, winning Serie B at the first attempt.",
      "scene": {
        "type": "trophies",
        "title": "Straight back",
        "items": [
          {
            "kind": "league",
            "label": "Serie B 2006-07"
          },
          {
            "kind": "worldcup",
            "label": "World Cup 2006"
          }
        ],
        "person": "buffon"
      }
    },
    {
      "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.",
      "scene": {
