  "lines": [
    {
      "text": "Seven points. That's how close a defender came to the Ballon d'Or in twenty nineteen.",
      "scene": {
        "type": "title",
        "heading": "VIRGIL VAN DIJK",
        "sub": "Liverpool · 2018/19",
        "pill": "SEVEN POINTS",
        "person": "vvd"
      }
    },
    {
      "text": "In the whole Premier League season, not one player dribbled past him. Not one.",
      "scene": {
        "type": "stats",
        "title": "Premier League 2018/19",
        "items": [
          {
            "n": "0",
            "l": "times dribbled past"
          }
        ],
        "person": "vvd"
      }
    },
    {
      "text": "Liverpool got ninety-seven points, and still lost the league by one.",
      "scene": {
        "type": "list",
        "title": "Premier League 2018/19",
        "rows": [
          {
            "name": "Man City",
            "value": "98",
            "club": "mci"
          },
          {
            "name": "Liverpool",
            "value": "97",
            "club": "liv",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "But in the Champions League semi, they put four past Messi's Barcelona at Anfield.",
      "scene": {
        "type": "person",
        "person": "vvd",
        "label": "Liverpool 4-0 Barcelona, semi-final",
        "mood": "happy",
        "stamp": "4-0"
      }
    },
    {
      "text": "Then Madrid. Two-nil against Spurs. Champions of Europe.",
      "scene": {
        "type": "score",
        "home": "tot",
        "away": "liv",
        "hs": 0,
        "as": 2,
        "date": "1 June 2019",
        "comp": "Champions League final"
      }
    },
    {
      "text": "PFA Player of the Year. And the first defender ever to win UEFA's Men's Player of the Year.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "bigears",
            "label": "Champions League"
          },
          {
            "kind": "cup",
            "label": "PFA Player of the Year"
          },
          {
            "kind": "euro",
            "label": "UEFA Men's Player of the Year"
          }
        ],
        "person": "vvd"
      }
    },
    {
      "text": "Messi had thirty-six league goals, a sixth Golden Shoe and the Spanish title.",
      "scene": {
        "type": "stats",
        "title": "Messi 2018/19",
        "items": [
          {
            "n": "36",
            "l": "La Liga goals"
          },
          {
            "n": "6",
            "l": "Golden Shoes"
          }
        ],
        "person": "messi"
      }
    },
    {
      "text": "The vote? Messi first. Van Dijk second. Ronaldo miles back.",
      "scene": {
        "type": "podium",
        "year": "2019",
        "title": "Ballon d'Or",
        "places": [
          {
            "person": "messi",
            "club": "bar"
          },
          {
            "person": "vvd",
            "club": "liv"
          },
          {
            "person": "ronaldo",
            "club": "juv"
          }
        ]
      }
    },
    {
      "text": "Six hundred and eighty-six against six hundred and seventy-nine. The tightest of Messi's six wins.",
      "scene": {
        "type": "versus",
        "title": "2019 Ballon d'Or",
        "left": {
          "person": "messi",
          "label": "Messi",
          "value": "686"
        },
        "right": {
          "person": "vvd",
          "label": "Van Dijk",
          "value": "679"
        }
      }
    },
    {
      "text": "Reports said African voters ranked his own teammate Sadio Mané second, behind Messi.",
      "scene": {
        "type": "text",
        "heading": "WHERE THE POINTS WENT",
        "body": "Reports after the vote said many African ballots put Liverpool's Sadio Mané second behind Messi, ahead of Van Dijk."
      }
    },
    {
      "text": "No defender has won it since Cannavaro in twenty-oh-six.",
      "scene": {
        "type": "person",
        "person": "vvd",
        "mood": "flat",
        "label": "Last defender winner: 2006"
      }
    },
    {
      "text": "Unbeatable for a whole season, and beaten by seven points.",
      "scene": {
        "type": "stamp",
        "text": "ROBBED",
        "person": "vvd",
        "color": "red"
      }
