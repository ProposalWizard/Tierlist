  "lines": [
    {
      "text": "Treble winner. World Cup finalist. Joint top scorer. And he finished fourth.",
      "scene": {
        "type": "title",
        "heading": "WESLEY SNEIJDER",
        "sub": "Inter & Netherlands · 2010",
        "pill": "ROBBED?",
        "person": "sneijder"
      }
    },
    {
      "text": "Twenty ten. Wesley Sneijder is the brain of José Mourinho's Inter.",
      "scene": {
        "type": "person",
        "person": "sneijder",
        "label": "Inter's number ten",
        "mood": "happy"
      }
    },
    {
      "text": "Champions League final against Bayern. His pass sets up Milito for the first goal. Two-nil.",
      "scene": {
        "type": "score",
        "home": "int",
        "away": "bay",
        "hs": 2,
        "as": 0,
        "date": "22 May 2010",
        "comp": "Champions League final",
        "note": "Sneijder assist"
      }
    },
    {
      "text": "Serie A, Coppa Italia, Champions League. The treble.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "league",
            "label": "Serie A"
          },
          {
            "kind": "cup",
            "label": "Coppa Italia"
          },
          {
            "kind": "bigears",
            "label": "Champions League"
          }
        ],
        "person": "sneijder"
      }
    },
    {
      "text": "Then the World Cup in South Africa. Quarter-final against Brazil. One-nil down.",
      "scene": {
        "type": "text",
        "heading": "WORLD CUP QUARTER-FINAL",
        "body": "Netherlands v Brazil, Port Elizabeth. Brazil lead one-nil at half-time."
      }
    },
    {
      "text": "Sneijder scores twice. Holland win two-one.",
      "scene": {
        "type": "score",
        "home": "ned",
        "away": "bra",
        "hs": 2,
        "as": 1,
        "date": "2 July 2010",
        "comp": "World Cup quarter-final",
        "note": "Sneijder x2"
      }
    },
    {
      "text": "Semi-final against Uruguay, he scores again. Five goals at the tournament.",
      "scene": {
        "type": "stats",
        "title": "Sneijder, World Cup 2010",
        "items": [
          {
            "n": "5",
            "l": "goals"
          },
          {
            "n": "2",
            "l": "v Brazil"
          },
          {
            "n": "1",
            "l": "v Uruguay"
          }
        ],
        "person": "sneijder"
      }
    },
    {
      "text": "Joint top scorer with Müller, Villa and Forlán. Second in the vote for best player.",
      "scene": {
        "type": "list",
        "title": "World Cup 2010 top scorers",
        "rows": [
          {
            "name": "Thomas Müller",
            "value": "5"
          },
          {
            "name": "David Villa",
            "value": "5"
          },
          {
            "name": "Wesley Sneijder",
            "value": "5",
            "club": "ned",
            "hl": true
          },
          {
            "name": "Diego Forlán",
            "value": "5"
          }
        ]
      }
    },
    {
      "text": "The final. Spain. Extra time. Iniesta scores. One-nil. So close to everything.",
      "scene": {
        "type": "score",
        "home": "ned",
        "away": "esp",
        "hs": 0,
        "as": 1,
        "date": "11 July 2010",
        "comp": "World Cup final",
        "note": "Iniesta, extra time"
      }
    },
    {
      "text": "The Ballon d'Or podium? Messi, Iniesta, Xavi.",
      "scene": {
        "type": "podium",
        "year": "2010",
        "title": "FIFA Ballon d'Or",
        "places": [
          {
            "person": "messi",
            "club": "bar"
          },
          {
            "person": "iniesta",
            "club": "esp"
          },
          {
            "person": "xavi",
            "club": "esp"
          }
        ]
      }
    },
    {
      "text": "Sneijder fourth, with fourteen point five percent. Messi won it with twenty-two point six five.",
      "scene": {
        "type": "versus",
        "title": "2010 vote share",
        "left": {
          "person": "messi",
          "label": "Messi, 1st",
          "value": "22.65%"
        },
        "right": {
          "person": "sneijder",
          "label": "Sneijder, 4th",
          "value": "14.48%"
        }
      }
    },
    {
      "text": "Not even on the podium.",
      "scene": {
        "type": "stamp",
        "text": "FOURTH",
        "person": "sneijder",
        "color": "red"
      }
    },
    {
      "text": "A treble, a World Cup final, five goals. Robbery? Drop it in the comments.",
