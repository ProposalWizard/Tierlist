    },
    {
      "text": "Drogba never won it. And Cantona? The award didn't even exist until 1995. Sorry, Eric.",
      "say": "Drogbah never won it. And Kantohna? The award didn't even exist until nineteen ninety-five. Sorry, Eric.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "sub": "Cantona and Drogba: no Player of the Season",
        "person": "cantona",
        "color": "red"
