  "lines": [
    {
      "text": "The best Premier League signing of all time. Ten legends. Three rules. One name.",
      "scene": {
        "type": "title",
        "heading": "BEST SIGNING EVER",
        "sub": "Premier League · 1992 to now",
        "pill": "THREE RULES",
        "person": "kante"
      }
    },
    {
      "text": "Cantona, Henry, Ronaldo, Drogba, Kanté, De Bruyne, Salah, Van Dijk, Rodri and Haaland.",
      "scene": {
        "type": "list",
        "title": "Our ten",
        "rows": [
          {
            "name": "Eric Cantona",
            "value": "1992",
            "club": "mun"
          },
          {
            "name": "Thierry Henry",
            "value": "1999",
            "club": "ars"
          },
          {
            "name": "Didier Drogba",
            "value": "2004",
            "club": "che"
          },
          {
            "name": "N'Golo Kanté",
            "value": "2015",
            "club": "lei"
          },
          {
            "name": "De Bruyne · Rodri",
            "value": "MCI"
          },
          {
            "name": "Salah · Van Dijk",
            "value": "LIV"
          },
          {
            "name": "Cristiano Ronaldo",
            "value": "2003",
            "club": "mun"
          },
          {
            "name": "Erling Haaland",
            "value": "2022",
            "club": "mci"
          }
        ]
      }
    },
    {
      "text": "Rule one. You must win the league in your very first season.",
      "scene": {
        "type": "text",
        "heading": "RULE 1",
        "body": "Must win the Premier League in his first season at the club."
      }
    },
    {
      "text": "Henry, Ronaldo, De Bruyne, Salah, Van Dijk and Rodri all had to wait. Six gone.",
      "scene": {
        "type": "stamp",
        "text": "HAD TO WAIT",
        "person": "henry",
        "color": "yellow"
      }
    },
    {
      "text": "Four left. Cantona, Drogba, Kanté and Haaland. Instant champions.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "1993",
            "label": "Cantona"
          },
          {
            "year": "2005",
            "label": "Drogba"
          },
          {
            "year": "2016",
            "label": "Kanté"
          },
          {
            "year": "2023",
            "label": "Haaland"
          }
        ]
      }
    },
    {
      "text": "Rule two. You must have won the Premier League Player of the Season award.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "Must have won the official Premier League Player of the Season award."
      }
    },
    {
      "text": "Kanté won it in twenty seventeen. Haaland in twenty twenty-three. Cantona and Drogba never did.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "drogba",
        "color": "red"
      }
    },
    {
      "text": "Rule three. Cheapest wins. You must have cost under ten million pounds.",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "Must have cost his club less than ten million pounds."
      }
    },
    {
      "text": "Haaland cost City around fifty-one million. Kanté cost Leicester about five point six.",
      "scene": {
        "type": "versus",
        "title": "The fee",
        "left": {
          "person": "kante",
          "label": "Kanté",
          "value": "£5.6m"
        },
        "right": {
          "person": "haaland",
          "label": "Haaland",
          "value": "£51m"
        }
      }
    },
    {
      "text": "So it's N'Golo Kanté. Signed from Caen, and champion in his first year.",
      "scene": {
        "type": "person",
        "person": "kante",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
      "text": "Then he moved to Chelsea and won the league again, straight away.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "league",
            "label": "2016 Leicester"
          },
          {
            "kind": "league",
            "label": "2017 Chelsea"
          }
        ],
        "person": "kante"
      }
    },
    {
      "text": "Best signing ever, or does Cantona have a case?",
      "scene": {
        "type": "person",
        "person": "cantona",
        "label": "THE KING OF 1993",
        "mood": "flat"
      }
    },
    {
      "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.",
      "scene": {
        "type": "cta"
      }
    }
  ]
