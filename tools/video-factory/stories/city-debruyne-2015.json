 "lines": [
  {
   "text": "Chelsea let him go. Bayern nearly had him. City paid a club record to get him.",
   "scene": {
    "type": "title",
    "heading": "KEVIN DE BRUYNE",
    "sub": "WOLFSBURG · 2015",
    "pill": "WHAT IF?",
    "person": "kdbwob"
   }
  },
  {
   "text": "January twenty fourteen. Chelsea sell Kevin De Bruyne to Wolfsburg for twenty-five million euros.",
   "scene": {
    "type": "stats",
    "title": "JANUARY 2014",
    "items": [
     {
      "n": "€25m",
      "l": "Chelsea to Wolfsburg"
     }
    ],
    "person": "kdbwob"
   }
  },
  {
   "text": "In Germany, he turns into one of the best creators in Europe.",
   "scene": {
    "type": "person",
    "person": "kdbwob",
    "label": "WOLFSBURG",
    "mood": "happy"
   }
  },
  {
   "text": "Summer twenty fifteen. He said he could go to Bayern, go to PSG, or stay at Wolfsburg.",
   "scene": {
    "type": "list",
    "title": "KDB'S OPTIONS, 2015",
    "rows": [
     {
      "name": "Bayern Munich",
      "value": "personal terms",
