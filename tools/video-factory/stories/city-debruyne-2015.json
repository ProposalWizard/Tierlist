      "l": "assists"
     },
     {
      "n": "422",
      "l": "games"
     }
    ],
    "person": "kdb"
   }
  },
  {
   "text": "Now the alternate world. Bayern pay up in twenty fifteen.",
   "scene": {
    "type": "whatif",
    "title": "SUMMER 2015",
    "real": {
     "label": "Real world",
     "value": "Man City"
    },
    "alt": {
