  "lines": [
    {
      "text": "Marseille became the first French club to win the Champions League. Six days earlier, their bosses had bribed opponents.",
      "scene": {
        "type": "title",
        "heading": "VA-OM",
        "sub": "Marseille · May 1993",
        "pill": "FOOTBALL'S BIGGEST SCANDALS",
        "person": "tapie"
      }
    },
    {
      "text": "Twentieth of May, nineteen ninety-three. Valenciennes against Marseille. A win seals the French title.",
      "scene": {
        "type": "score",
        "home": "va",
        "away": "om",
        "hs": 0,
        "as": 1,
        "date": "20 May 1993",
        "comp": "French Division 1",
        "note": "Boksic scores. Title sealed."
      }
    },
    {
      "text": "The plan: get Valenciennes players to ease off, so Marseille stay fresh for the final against Milan.",
      "scene": {
        "type": "text",
        "heading": "The plan",
        "body": "President Bernard Tapie and general manager Jean-Pierre Bernès wanted Valenciennes players to hold back before the European Cup final."
      }
    },
    {
      "text": "Marseille midfielder Jean-Jacques Eydelie was the go-between.",
      "scene": {
        "type": "person",
        "person": "eydelie",
        "label": "THE GO-BETWEEN",
        "mood": "worried"
      }
    },
    {
      "text": "Two Valenciennes players took the deal. Jacques Glassmann said no, and told his coach at half-time.",
      "scene": {
        "type": "person",
        "person": "glassmann",
        "label": "HE SAID NO",
        "mood": "shocked"
      }
    },
    {
      "text": "Police later found two hundred and fifty thousand francs buried in a garden linked to Valenciennes player Christophe Robert's family.",
      "scene": {
        "type": "stats",
        "title": "The evidence",
        "items": [
          {
            "n": "250,000",
            "l": "francs in a garden"
          }
        ]
      }
    },
    {
      "text": "Six days after Valenciennes, Basile Boli heads the winner in Munich. Marseille beat Milan one-nil.",
      "scene": {
        "type": "score",
        "home": "om",
        "away": "mil",
        "hs": 1,
        "as": 0,
        "date": "26 May 1993",
        "comp": "Champions League final",
        "note": "Boli header, first half"
      }
    },
    {
      "text": "Then it all fell apart. In September, the French federation stripped Marseille of the league title.",
      "scene": {
        "type": "stamp",
        "text": "STRIPPED",
        "color": "red"
      }
    },
    {
      "text": "Second-placed PSG refused to take it. So for that season, France has no champion.",
      "scene": {
        "type": "list",
        "title": "French champions 1992-93",
        "rows": [
          {
            "name": "Marseille",
            "value": "STRIPPED",
            "club": "om"
          },
          {
            "name": "PSG",
            "value": "REFUSED",
            "club": "psg"
          },
          {
            "name": "Champion",
            "value": "NONE",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "UEFA banned them from defending their crown, and in nineteen ninety-four they were relegated.",
      "scene": {
        "type": "timeline",
        "title": "The fall",
        "items": [
          {
            "year": "May 93",
            "label": "Kings of Europe"
          },
          {
            "year": "Sep 93",
            "label": "Title stripped"
          },
          {
            "year": "93-94",
            "label": "UEFA ban"
          },
          {
            "year": "1994",
            "label": "Relegated"
          },
          {
            "year": "1995",
            "label": "Tapie convicted"
          }
        ]
      }
    },
    {
      "text": "Tapie was convicted of corruption and went to prison.",
      "scene": {
        "type": "person",
        "person": "tapie",
        "label": "BERNARD TAPIE",
        "mood": "worried",
        "stamp": "GUILTY"
      }
    },
    {
      "text": "But they kept the Champions League. The fixed game wasn't a European match.",
      "scene": {
        "type": "trophies",
        "title": "What they kept",
        "items": [
          {
            "kind": "bigears",
            "label": "Kept"
          },
          {
            "kind": "league",
            "label": "Stripped"
          }
        ],
        "person": "boli"
      }
    },
    {
      "text": "Follow for more.",
      "scene": {
        "type": "cta"
      }
    }
  ]
