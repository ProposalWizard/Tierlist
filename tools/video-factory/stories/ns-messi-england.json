  "lines": [
    { "text": "What if Lionel Messi had been born in England? Would he be a world champion?", "scene": { "type": "title", "heading": "LIONEL MESSI", "sub": "Argentina · since 2005", "pill": "WHAT IF HE WAS ENGLISH?", "person": "messi" } },
    { "text": "Real world first. Messi's Argentina debut in twenty oh-five lasted about a minute. Straight red.", "scene": { "type": "person", "person": "messiyoung", "label": "Debut v Hungary, 2005", "mood": "shocked", "stamp": "RED CARD" } },
    { "text": "Then came the trophies: two Copa Américas, a Finalissima and the World Cup.", "scene": { "type": "trophies", "items": [ { "kind": "cup", "label": "Copa América 2021" }, { "kind": "cup", "label": "Finalissima 2022" }, { "kind": "worldcup", "label": "World Cup 2022" }, { "kind": "cup", "label": "Copa América 2024" } ], "person": "messi" } },
    { "text": "And this summer he set up both goals as Argentina knocked England out of the World Cup.", "scene": { "type": "score", "home": "eng", "away": "arg", "hs": 1, "as": 2, "date": "15 July 2026", "comp": "World Cup semi-final" } },
    { "text": "Now look at England in exactly the same years.", "scene": { "type": "timeline", "items": [ { "year": "2008", "label": "Didn't qualify for the Euros" }, { "year": "2018", "label": "World Cup semi-final" }, { "year": "2021", "label": "Euro 2020 final: lost" }, { "year": "2024", "label": "Euro 2024 final: lost" }, { "year": "2026", "label": "World Cup semi-final" } ] } },
    { "text": "Two Euro finals. Two defeats. Not one trophy since nineteen sixty-six.", "scene": { "type": "stamp", "text": "ZERO", "color": "red" } },
    { "text": "So in this alternate world, Messi wears the Three Lions.", "scene": { "type": "person", "person": "messieng", "label": "ALTERNATE WORLD", "mood": "worried" } },
    { "text": "On paper, he swaps four trophies for none.", "scene": { "type": "whatif", "title": "Messi's senior international trophies", "real": { "label": "Argentina (real)", "value": "4" }, "alt": { "label": "England (on paper)", "value": "0" } } },
    { "text": "But England lost those two finals by the smallest margins. A penalty shootout, then one late goal.", "scene": { "type": "list", "title": "England's two finals", "rows": [ { "name": "Euro 2020 v Italy", "value": "Lost on pens", "club": "eng", "hl": true }, { "name": "Euro 2024 v Spain", "value": "Lost 2-1", "club": "eng", "hl": true } ] } },
    { "text": "Give that team Messi, and in this imagined world England might finally have their second star.", "scene": { "type": "quote", "person": "messieng", "text": "It's coming home. I'll bring it." } },
    { "text": "So is Messi great because of Argentina, or Argentina great because of Messi?", "scene": { "type": "versus", "title": "Same genius, different shirt", "left": { "person": "messi", "label": "Argentina", "value": "4" }, "right": { "person": "messieng", "label": "England", "value": "?" } } },
    { "text": "Tell me in the comments.", "scene": { "type": "text", "heading": "YOUR CALL", "body": "Messi in an England shirt from 2005 to 2026: how many trophies?" } },
    { "text": "Follow for more.", "scene": { "type": "cta" } }
  ]
}
