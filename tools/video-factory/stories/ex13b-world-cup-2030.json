  "sources": [
    "https://olympics.com/en/news/2030-fifa-world-cup-bid-spain-portugal-morocco-uruguay-argentina-paraguay-football",
    "https://www.nbcsports.com/soccer/news/2030-world-cup-to-be-hosted-by-spain-portugal-morocco-three-south-american-countries",
    "https://en.wikipedia.org/wiki/1930_FIFA_World_Cup",
