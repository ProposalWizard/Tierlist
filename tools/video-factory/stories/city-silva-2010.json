 "lines": [
  {
   "text": "The man who built Manchester City's golden era almost played for someone else.",
   "scene": {
    "type": "title",
    "heading": "DAVID SILVA",
    "sub": "VALENCIA · 2010",
    "pill": "WHAT IF?",
    "person": "silvaval"
   }
  },
  {
   "text": "Summer twenty ten. David Silva has just become a world champion with Spain.",
   "scene": {
    "type": "trophies",
    "items": [
     {
      "kind": "worldcup",
      "label": "Spain · 2010"
     }
    ],
    "person": "silvaval"
   }
  },
  {
   "text": "But Valencia are drowning in debt. David Villa goes to Barcelona for forty million euros, and Silva has to go too.",
   "scene": {
    "type": "text",
    "heading": "VALENCIA, 2010",
    "body": "Big debts. David Villa sold to Barcelona for €40m. David Silva next. Both later said the club needed the money."
   }
  },
  {
   "text": "Silva says Barcelona and Real Madrid were both interested. City's own history says Chelsea courted him too.",
   "scene": {
    "type": "list",
    "title": "WHO WANTED SILVA",
    "rows": [
     {
      "name": "Real Madrid",
      "value": "interested",
      "club": "rma",
