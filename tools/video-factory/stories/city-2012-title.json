 "lines": [
  {
   "text": "Ninety-three minutes and twenty seconds. Change one kick, and Manchester United win the twenty twelve title.",
   "scene": {
    "type": "title",
    "heading": "93:20",
    "sub": "MAN CITY v QPR · 13 MAY 2012",
    "pill": "WHAT IF?",
    "person": "aguero"
   }
  },
  {
   "text": "Rewind to April. City lose one-nil at Arsenal, and United go eight points clear with six games left.",
   "scene": {
    "type": "score",
    "home": "ars",
    "away": "mci",
    "hs": 1,
    "as": 0,
    "date": "8 April 2012",
    "comp": "Premier League",
    "note": "United 8 points clear"
   }
  },
  {
   "text": "Was the title race over? Roberto Mancini said, not mathematically.",
   "scene": {
    "type": "quote",
    "person": "mancini",
    "text": "Not mathematically."
   }
  },
  {
   "text": "Then United slipped up three games in a row, and City won all three.",
   "scene": {
    "type": "stats",
    "title": "THE COLLAPSE",
    "items": [
     {
      "n": "8",
      "l": "points gap"
     },
     {
      "n": "3",
      "l": "points gap, 3 games later"
     }
    ]
   }
  },
  {
   "text": "Thirtieth of April, the derby. Kompany heads City top on goal difference.",
   "scene": {
    "type": "score",
    "home": "mci",
    "away": "mun",
    "hs": 1,
    "as": 0,
    "date": "30 April 2012",
    "comp": "Premier League",
    "note": "Kompany header"
   }
  },
  {
   "text": "Final day. Both teams on eighty-six points. United win at Sunderland. City trail ten-man QPR two-one.",
   "scene": {
    "type": "score",
    "home": "mci",
    "away": "qpr",
    "hs": 1,
    "as": 2,
    "date": "13 May 2012",
    "comp": "Premier League",
    "note": "90 minutes gone"
   }
  },
  {
   "text": "Džeko heads in at ninety-two. Then Agüero, ninety-three twenty. Champions.",
   "scene": {
    "type": "score",
    "home": "mci",
    "away": "qpr",
    "hs": 3,
    "as": 2,
    "date": "13 May 2012",
    "comp": "Premier League",
    "note": "Džeko 90+2, Agüero 93:20",
    "stamp": "AGÜEROOO"
   }
  },
  {
   "text": "Both teams on eighty-nine points. City win it on goal difference, plus sixty-four against plus fifty-six.",
   "scene": {
    "type": "versus",
    "title": "FINAL TABLE",
    "left": {
     "person": "mancini",
     "label": "Man City GD",
     "value": "+64"
    },
    "right": {
     "person": "ferguson",
     "label": "Man United GD",
     "value": "+56"
    }
   }
  },
  {
   "text": "The first Premier League title ever decided on goal difference.",
   "scene": {
    "type": "text",
    "heading": "A FIRST",
    "body": "2011-12: City and United both finish on 89 points. City win on goal difference, the first time a Premier League title is settled that way."
   }
  },
  {
   "text": "Now the alternate world. The shot is saved. Two-two.",
   "scene": {
    "type": "whatif",
    "title": "93:20",
    "real": {
