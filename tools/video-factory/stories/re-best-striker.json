  "lines": [
    {
      "text": "Who is the best striker in the world right now? Ten nines. Three rules. One left.",
      "scene": {
        "type": "title",
        "heading": "BEST STRIKER",
        "sub": "Right now · November 2026",
        "pill": "THREE RULES",
        "person": "haaland"
      }
    },
    {
      "text": "Haaland, Kane, Mbappé, Isak, Guirassy, Lautaro, Gyökeres, Osimhen, Lewandowski and João Pedro.",
      "scene": {
        "type": "list",
        "title": "Our ten nines",
        "rows": [
          {
            "name": "Erling Haaland",
