    },
    {
      "text": "Rule one. Four or more Champions League goals this season.",
      "scene": {
        "type": "text",
        "heading": "RULE 1",
        "body": "Four or more Champions League goals after three matchdays."
      }
    },
    {
      "text": "Mbappé has three. Lautaro, the man who knocked England out of the World Cup, isn't on the list either.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "lautaro",
        "color": "red"
      }
    },
    {
      "text": "Three survive. Kane, Haaland and Dortmund's Serhou Guirassy, four goals each.",
      "scene": {
        "type": "list",
        "title": "UCL goals",
        "rows": [
          {
            "name": "Harry Kane",
            "value": "4",
            "club": "bay",
            "hl": true
          },
          {
            "name": "Erling Haaland",
            "value": "4",
            "club": "mci",
            "hl": true
          },
          {
            "name": "Serhou Guirassy",
            "value": "4",
            "club": "bvb",
            "hl": true
          },
          {
            "name": "Kylian Mbappé",
            "value": "3",
            "club": "rma"
          }
        ]
      }
    },
    {
      "text": "Rule two. You must have won Europe's Golden Shoe at least once.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "Must have won the European Golden Shoe."
      }
    },
    {
      "text": "Haaland won it in twenty twenty-three. Kane the year after. Guirassy never has.",
      "scene": {
        "type": "stamp",
        "text": "NO GOLDEN SHOE",
        "person": "guirassy",
        "color": "yellow"
      }
    },
    {
      "text": "Rule three. Our channel, our rules. You have to be leading the Premier League scoring chart.",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "Must be top of the Premier League scoring chart right now."
      }
    },
    {
      "text": "Kane scores his goals in Germany. Haaland is top in England, ahead of Isak on six.",
      "scene": {
        "type": "versus",
        "title": "Top of the PL chart",
        "left": {
          "person": "haaland",
          "label": "Haaland",
          "value": "TOP"
        },
        "right": {
          "person": "kane",
          "label": "Kane",
          "value": "Bundesliga"
        }
      }
    },
    {
      "text": "The rules pick Erling Haaland. Four Champions League goals in just two games, too.",
      "scene": {
        "type": "person",
        "person": "haaland",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
      "text": "Kane fans, we hear you. Who is your number nine?",
      "scene": {
        "type": "stamp",
