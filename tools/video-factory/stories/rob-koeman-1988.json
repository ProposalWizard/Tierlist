  "lines": [
    {
      "text": "A centre-back scored twenty-one league goals, won the treble AND the Euros. He finished fifth.",
      "scene": {
        "type": "title",
        "heading": "RONALD KOEMAN",
        "sub": "PSV · 1987/88",
        "pill": "BALLON D'OR ROBBERY?",
        "person": "koeman"
      }
    },
    {
      "text": "Nineteen eighty-seven, eighty-eight. Ronald Koeman plays at the back for PSV.",
      "scene": {
        "type": "person",
        "person": "koeman",
        "label": "Centre-back",
        "mood": "happy"
      }
    },
    {
      "text": "Free kicks, penalties, long-range shots. Twenty-one goals in the Dutch league alone.",
      "scene": {
        "type": "stats",
        "title": "Koeman, Eredivisie 1987/88",
        "items": [
          {
            "n": "21",
            "l": "league goals"
          },
          {
            "n": "3",
            "l": "trophies"
          }
        ],
        "person": "koeman"
      }
    },
    {
      "text": "PSV win the league, the Dutch Cup, and the European Cup. The treble.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "league",
            "label": "Eredivisie"
          },
          {
            "kind": "cup",
            "label": "KNVB Cup"
          },
          {
            "kind": "bigears",
            "label": "European Cup"
          }
        ],
        "person": "koeman"
      }
    },
    {
      "text": "The final in Stuttgart against Benfica. Nil-nil after extra time. A clean sheet.",
      "scene": {
        "type": "score",
        "home": "psv",
        "away": "ben",
        "hs": 0,
        "as": 0,
        "date": "25 May 1988",
        "comp": "European Cup final",
        "note": "after extra time"
      }
    },
    {
      "text": "Penalties. Who steps up first for PSV? Koeman. Scores. PSV win it six-five.",
      "scene": {
        "type": "stamp",
        "text": "SCORED",
        "person": "koeman",
        "color": "white"
      }
    },
    {
      "text": "Weeks later, Euro eighty-eight. Semi-final, Hamburg, against the hosts West Germany.",
      "scene": {
        "type": "score",
        "home": "frg",
        "away": "ned",
        "hs": 1,
        "as": 2,
        "date": "21 June 1988",
        "comp": "Euro 88 semi-final",
        "note": "Koeman pen 74'"
      }
    },
    {
      "text": "One-nil down. Koeman equalises from the spot. Van Basten wins it late.",
      "scene": {
        "type": "person",
        "person": "koeman",
        "label": "The equaliser",
        "mood": "happy"
      }
    },
    {
      "text": "Holland beat the Soviet Union two-nil in the final. Koeman makes the team of the tournament.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "euro",
            "label": "Euro 88"
          }
        ],
        "person": "koeman"
      }
    },
    {
      "text": "So, the Ballon d'Or. Van Basten, Gullit, Rijkaard. All three from Milan.",
      "scene": {
        "type": "podium",
        "year": "1988",
        "title": "Ballon d'Or",
        "places": [
          {
            "person": "vanbasten",
            "club": "mil"
          },
          {
            "person": "gullit",
            "club": "mil"
          },
          {
            "person": "rijkaard",
            "club": "mil"
          }
        ]
      }
    },
    {
      "text": "Koeman? Fifth. Thirty-nine points to Van Basten's one hundred and twenty-nine.",
      "scene": {
        "type": "versus",
        "title": "1988 Ballon d'Or points",
        "left": {
          "person": "vanbasten",
          "label": "Van Basten, 1st",
          "value": "129"
        },
        "right": {
          "person": "koeman",
          "label": "Koeman, 5th",
          "value": "39"
        }
      }
    },
    {
      "text": "Even behind Dynamo Kyiv's Oleksiy Mykhaylychenko.",
      "scene": {
        "type": "list",
        "title": "1988 Ballon d'Or",
        "rows": [
          {
            "name": "Van Basten",
            "value": "129",
            "club": "mil"
          },
          {
            "name": "Gullit",
            "value": "88",
            "club": "mil"
          },
          {
            "name": "Rijkaard",
            "value": "45",
            "club": "mil"
          },
          {
            "name": "Mykhaylychenko",
            "value": "41"
          },
          {
            "name": "Koeman",
            "value": "39",
            "club": "psv",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "A treble and the Euros, from centre-back. Robbed? Tell me in the comments.",
      "scene": {
        "type": "stamp",
        "text": "ROBBED?",
        "person": "koeman",
        "color": "red"
      }
    },
    {
      "text": "Follow for more.",
      "scene": {
        "type": "cta"
      }
    }
  ]
