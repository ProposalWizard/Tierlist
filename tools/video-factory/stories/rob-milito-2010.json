  "lines": [
    {
      "text": "He scored in three finals in seventeen days and won the treble. The Ballon d'Or didn't even list him.",
      "scene": {
        "type": "title",
        "heading": "DIEGO MILITO",
        "sub": "Inter · 2009/10",
        "pill": "THE BIGGEST SNUB?",
        "person": "milito"
      }
    },
    {
      "text": "Diego Milito, Inter's striker under José Mourinho. Thirty goals that season, twenty-two in Serie A.",
      "scene": {
        "type": "stats",
        "title": "Milito 2009/10",
        "items": [
          {
            "n": "30",
            "l": "goals, all comps"
          },
          {
            "n": "22",
            "l": "Serie A"
          }
        ],
        "person": "milito"
      }
    },
    {
      "text": "Final number one. The Coppa Italia against Roma. One goal in the whole game. His.",
      "scene": {
        "type": "score",
        "home": "int",
        "away": "rom",
        "hs": 1,
        "as": 0,
        "date": "5 May 2010",
        "comp": "Coppa Italia final",
        "note": "Milito"
      }
    },
    {
      "text": "Final number two. Last day of Serie A, away at Siena. The title on the line.",
      "scene": {
        "type": "text",
        "heading": "SERIE A, FINAL DAY",
        "body": "A win at Siena makes Inter champions. It is goalless at half-time."
      }
    },
    {
      "text": "Second half. Milito scores. One-nil. Inter are champions of Italy.",
      "scene": {
        "type": "score",
        "home": "sie",
        "away": "int",
        "hs": 0,
        "as": 1,
        "date": "May 2010",
        "comp": "Serie A",
        "note": "Milito"
      }
    },
    {
      "text": "Final number three. Madrid. The Champions League final against Bayern.",
      "scene": {
        "type": "person",
        "person": "milito",
        "label": "Santiago Bernabéu",
        "mood": "flat"
      }
    },
    {
      "text": "First half, Milito. Second half, Milito again. Two-nil. Inter's first European Cup in forty-five years.",
      "scene": {
        "type": "score",
        "home": "int",
        "away": "bay",
        "hs": 2,
        "as": 0,
        "date": "22 May 2010",
        "comp": "Champions League final",
        "note": "Milito 35', 70'"
      }
    },
    {
      "text": "League, cup, Champions League. The treble. Italy's first ever.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "league",
            "label": "Serie A"
          },
          {
            "kind": "cup",
            "label": "Coppa Italia"
          },
          {
            "kind": "bigears",
            "label": "Champions League"
          }
        ],
        "person": "milito"
      }
    },
    {
      "text": "October. FIFA names twenty-three players for the Ballon d'Or. Four from Inter.",
      "scene": {
        "type": "list",
        "title": "Inter on the 2010 list",
        "rows": [
          {
            "name": "Wesley Sneijder",
            "value": "4th",
            "club": "int"
          },
          {
            "name": "Samuel Eto'o",
            "value": "12th",
            "club": "int"
          },
          {
            "name": "Maicon",
            "value": "17th",
            "club": "int"
          },
          {
            "name": "Júlio César",
            "value": "19th",
            "club": "int"
          },
          {
            "name": "Diego Milito",
            "value": "not listed",
            "club": "int",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "Diego Milito? Not one of the twenty-three.",
      "scene": {
        "type": "stamp",
        "text": "NOT NOMINATED",
        "person": "milito",
        "color": "red"
      }
    },
    {
      "text": "Inter's president Massimo Moratti said he was stunned.",
      "scene": {
        "type": "person",
        "person": "milito",
        "label": "Moratti: stunned",
        "mood": "shocked"
      }
    },
    {
      "text": "The podium in January? Messi, Iniesta, Xavi. All Barcelona.",
      "scene": {
        "type": "podium",
        "year": "2010",
        "title": "FIFA Ballon d'Or",
        "places": [
          {
            "person": "messi",
            "club": "bar"
          },
          {
            "person": "iniesta",
            "club": "bar"
          },
          {
            "person": "xavi",
            "club": "bar"
          }
        ]
      }
    },
    {
      "text": "Three finals, four goals, three trophies. Not even a nomination. Robbery? Comments.",
      "scene": {
        "type": "stamp",
        "text": "ROBBED",
        "person": "milito",
        "color": "red"
      }
    },
    {
      "text": "Follow for more.",
      "scene": {
        "type": "cta"
      }
    }
  ]
