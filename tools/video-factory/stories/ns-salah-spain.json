  "lines": [
    {
      "text": "What if Mo Salah had been born in Spain instead of Egypt?",
      "scene": {
        "type": "title",
        "heading": "MOHAMED SALAH",
        "sub": "Egypt · since 2011",
        "pill": "WHAT IF HE WAS SPANISH?",
        "person": "salah"
      }
    },
    {
      "text": "Real world first. Salah made his Egypt debut in twenty eleven.",
      "scene": {
        "type": "person",
        "person": "salah",
        "label": "Egypt debut: 2011",
        "mood": "happy"
      }
    },
    {
      "text": "He has reached two Africa Cup of Nations finals, and lost both.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "2017",
            "label": "AFCON final: lost to Cameroon"
          },
          {
            "year": "2022",
            "label": "AFCON final: lost to Senegal on pens"
          }
        ]
      }
    },
    {
      "text": "Cameroon won the first with a late goal. Senegal won the second on penalties.",
      "scene": {
        "type": "stamp",
        "text": "RUNNER-UP AGAIN",
        "person": "salah",
        "color": "red"
      }
    },
    {
      "text": "This summer Egypt led Argentina two-nil in the World Cup, then lost three-two.",
      "scene": {
        "type": "score",
        "home": "arg",
        "away": "egy",
        "hs": 3,
        "as": 2,
        "date": "7 July 2026",
        "comp": "World Cup last sixteen",
        "note": "Egypt led 2-0"
      }
    },
    {
      "text": "Now look at Spain in exactly the same years.",
      "scene": {
        "type": "person",
        "person": "salahesp",
        "label": "ALTERNATE WORLD",
        "mood": "happy"
      }
    },
    {
      "text": "Euro twenty twelve, with a four-nil final against Italy.",
      "scene": {
        "type": "score",
        "home": "esp",
        "away": "ita",
        "hs": 4,
        "as": 0,
        "date": "1 July 2012",
        "comp": "Euro 2012 final"
      }
    },
    {
      "text": "The Nations League in twenty twenty-three. Euro twenty twenty-four. And this summer, the World Cup.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "euro",
            "label": "Euro 2012"
          },
          {
            "kind": "cup",
            "label": "Nations League 2023"
          },
          {
            "kind": "euro",
            "label": "Euro 2024"
          },
          {
            "kind": "worldcup",
            "label": "World Cup 2026"
          }
        ]
      }
    },
    {
      "text": "That's four major trophies while Salah has been playing.",
      "scene": {
        "type": "stats",
        "title": "Spain since Salah's debut",
        "items": [
          {
            "n": "4",
            "l": "major trophies"
          },
          {
            "n": "1",
            "l": "World Cup"
          }
        ]
      }
    },
    {
      "text": "So in this alternate world, Salah is Spain's right winger.",
      "scene": {
        "type": "whatif",
        "title": "Salah's international trophies",
        "real": {
          "label": "Egypt (real)",
          "value": "0"
        },
        "alt": {
          "label": "Spain (imagined)",
          "value": "4"
        }
      }
    },
    {
      "text": "Four trophies instead of none. And a World Cup winner's medal.",
      "scene": {
        "type": "quote",
        "person": "salahesp",
        "text": "So this is what it feels like."
      }
    },
    {
      "text": "Egypt's king, or Spain's world champion? Which would you pick? Comment below.",
