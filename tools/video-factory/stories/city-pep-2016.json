 "lines": [
  {
   "text": "Pep Guardiola could have been Manchester United's manager. Think about that.",
   "scene": {
    "type": "title",
    "heading": "PEP GUARDIOLA",
    "sub": "MAN CITY · 2016 TO 2026",
    "pill": "WHAT IF?",
    "person": "pep"
   }
  },
  {
   "text": "Twenty twelve. Pep leaves Barcelona and takes a year off in New York.",
   "scene": {
    "type": "person",
    "person": "pep",
    "label": "NEW YORK, 2012",
    "mood": "flat"
   }
  },
  {
   "text": "Sir Alex Ferguson takes him out to dinner there. Fergie wanted Pep as his successor.",
   "scene": {
    "type": "versus",
    "title": "NEW YORK DINNER",
    "left": {
     "person": "ferguson",
     "label": "Ferguson",
     "value": "Retiring soon"
    },
    "right": {
     "person": "pep",
     "label": "Guardiola",
     "value": "On a break"
    }
   }
  },
  {
   "text": "Pep later joked he couldn't fully understand Fergie's Scottish accent.",
   "scene": {
    "type": "text",
    "heading": "LOST IN TRANSLATION",
    "body": "Guardiola later said he may have missed the United job partly because he couldn't fully follow Ferguson's accent."
   }
  },
  {
   "text": "United went for David Moyes. Chelsea's Roman Abramovich tried for Pep again and again. City had been talking to him since twenty twelve.",
   "scene": {
    "type": "list",
    "title": "WHO WANTED PEP",
    "rows": [
     {
      "name": "Man United",
      "value": "Ferguson's pick",
      "club": "mun"
     },
     {
      "name": "Chelsea",
      "value": "chased him for years",
      "club": "che"
     },
     {
      "name": "Bayern",
      "value": "got him in 2013",
      "club": "bay"
     },
     {
      "name": "Man City",
      "value": "got him in 2016",
      "club": "mci",
      "hl": true
     }
    ]
   }
  },
  {
   "text": "He went to Bayern Munich, and in February twenty sixteen, City announced him.",
   "scene": {
    "type": "timeline",
    "items": [
     {
      "year": "2012",
      "label": "Leaves Barcelona"
     },
     {
      "year": "2013",
