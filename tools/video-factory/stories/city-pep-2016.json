     },
     {
      "year": "2016",
      "label": "Man City"
     },
     {
      "year": "2026",
      "label": "Leaves City"
     }
    ]
   }
  },
  {
   "text": "Ten seasons. Six Premier League titles. Twenty trophies, including the treble in twenty twenty-three.",
   "scene": {
    "type": "stats",
    "title": "PEP AT CITY",
    "items": [
     {
      "n": "10",
      "l": "seasons"
     },
     {
      "n": "6",
      "l": "Premier League titles"
     },
     {
      "n": "20",
      "l": "trophies"
     }
    ],
    "person": "pep"
   }
  },
  {
   "text": "Now the alternate world. In twenty sixteen, United take Fergie's advice and hire Pep, not José Mourinho.",
   "scene": {
    "type": "whatif",
    "title": "SUMMER 2016",
    "real": {
     "label": "Real world",
     "value": "Pep to City"
    },
    "alt": {
     "label": "Alternate world",
     "value": "Pep to United"
    }
   }
  },
  {
   "text": "No hundred-point season at City. No treble in sky blue.",
   "scene": {
    "type": "stamp",
    "text": "CANCELLED",
    "color": "red",
    "person": "pep"
   }
  },
  {
   "text": "Those six titles? In the real world, the runners-up were United, Liverpool and Arsenal.",
   "scene": {
    "type": "list",
    "title": "PEP'S TITLES · RUNNER-UP",
    "rows": [
     {
