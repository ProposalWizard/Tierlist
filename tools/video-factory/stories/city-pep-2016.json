   }
  },
  {
   "text": "Liverpool lost the twenty nineteen title with ninety-seven points. Twenty twenty-two with ninety-two. Both by a single point.",
   "scene": {
    "type": "versus",
    "title": "BY ONE POINT",
    "left": {
     "person": "pep",
     "label": "City 2019",
     "value": "98"
