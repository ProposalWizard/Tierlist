  "lines": [
    {
      "text": "Who is the best player never to win the Ballon d'Or? Ten legends. Three rules. One name.",
      "scene": {
        "type": "title",
        "heading": "NEVER WON IT",
        "sub": "The best without a Ballon d'Or",
        "pill": "THREE RULES",
        "person": "iniesta"
      }
    },
    {
      "text": "Henry, Iniesta, Xavi, Maldini, Buffon, Neuer, Lewandowski, De Bruyne, Salah and Haaland.",
      "scene": {
        "type": "list",
        "title": "Our ten",
        "rows": [
          {
            "name": "Thierry Henry",
            "value": "FRA",
            "club": "fra"
          },
          {
            "name": "Andrés Iniesta",
            "value": "ESP",
            "club": "esp"
          },
          {
            "name": "Xavi",
            "value": "ESP",
            "club": "esp"
          },
          {
            "name": "Paolo Maldini",
            "value": "ITA",
            "club": "ita"
          },
          {
            "name": "Gianluigi Buffon",
            "value": "ITA",
            "club": "ita"
          },
          {
            "name": "Manuel Neuer",
            "value": "GER",
            "club": "ger"
          },
          {
            "name": "Lewandowski · De Bruyne",
            "value": "+2"
          },
          {
            "name": "Salah · Haaland",
            "value": "+2"
          }
        ]
      }
    },
    {
      "text": "Rule one. You must have won a World Cup.",
      "scene": {
        "type": "text",
        "heading": "RULE 1",
        "body": "Must have won the World Cup."
      }
    },
    {
      "text": "Maldini, Lewandowski, De Bruyne, Salah and Haaland never have. Five gone.",
      "scene": {
        "type": "stamp",
        "text": "NO WORLD CUP",
        "person": "haaland",
        "color": "yellow"
      }
    },
    {
      "text": "Henry, Buffon, Xavi, Iniesta and Neuer. All world champions.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "1998",
            "label": "Henry"
          },
          {
            "year": "2006",
            "label": "Buffon"
          },
          {
            "year": "2010",
            "label": "Xavi + Iniesta"
          },
          {
            "year": "2014",
            "label": "Neuer"
          }
        ]
      }
    },
    {
      "text": "Rule two. You must have finished second in the Ballon d'Or. So close it hurts.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "Must have finished second in a Ballon d'Or vote."
      }
    },
    {
      "text": "Xavi came third three times. Neuer came third once. Never second. Both out.",
      "scene": {
        "type": "stamp",
        "text": "ONLY THIRD",
        "person": "xavi",
        "color": "red"
      }
    },
    {
      "text": "Henry was second in two thousand three. Buffon in two thousand six. Iniesta in twenty ten.",
      "scene": {
        "type": "list",
        "title": "Runners-up",
        "rows": [
          {
            "name": "Thierry Henry",
            "value": "2003",
            "club": "ars",
            "hl": true
          },
          {
            "name": "Gianluigi Buffon",
            "value": "2006",
            "club": "juv",
            "hl": true
          },
          {
            "name": "Andrés Iniesta",
            "value": "2010",
            "club": "bar",
            "hl": true
          }
        ]
      }
    },
    {
      "text": "Rule three. You must have scored in a World Cup final.",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "Must have scored in a World Cup final."
      }
    },
    {
      "text": "Buffon is a keeper. Henry didn't score in the nineteen ninety-eight final.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "henry",
        "color": "red"
      }
    },
    {
      "text": "Iniesta did. Hundred and sixteenth minute, Johannesburg, the goal that won Spain the World Cup.",
      "scene": {
        "type": "score",
        "home": "ned",
        "away": "esp",
        "hs": 0,
        "as": 1,
        "date": "11 July 2010",
        "comp": "World Cup final",
        "note": "After extra time. Iniesta 116'."
      }
    },
    {
      "text": "Andrés Iniesta. The best player never to win the Ballon d'Or. Agree?",
      "scene": {
        "type": "person",
        "person": "iniesta",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
      "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.",
      "scene": {
        "type": "cta"
      }
    }
  ]
