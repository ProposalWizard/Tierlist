  "lines": [
    {
      "text": "Ten legends. Zero Ballon d'Ors. Three rules, and only one name survives.",
      "scene": {
        "type": "title",
        "heading": "NEVER WON IT",
        "sub": "The best player without a Ballon d'Or",
        "pill": "THREE RULES",
        "person": "iniestab"
      }
    },
    {
      "text": "Henry, Maldini, Buffon, Xavi and Iniesta.",
      "say": "Onree, Maldeenee, Booffon, Shahvee, and Inyestah.",
      "scene": {
        "type": "list",
        "kicker": "The ten · part one",
        "title": "Never won the Ballon d'Or",
        "rows": [
          {
