        ]
      }
    },
    {
      "text": "Neuer, Lewandowski, De Bruyne, Salah and Haaland.",
      "say": "Noyer, Lehvandoffskee, Debroynuh, Sahlah, and Hohland.",
      "scene": {
        "type": "list",
