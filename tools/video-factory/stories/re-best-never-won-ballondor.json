            "value": "Poland",
            "club": "pol"
          },
          {
            "name": "De Bruyne",
            "value": "Belgium",
            "club": "bel"
          },
          {
            "name": "Mo Salah",
            "value": "Egypt",
            "club": "egy"
          },
          {
            "name": "Haaland",
            "value": "Norway",
            "club": "nor"
          }
        ]
      }
    },
    {
      "text": "Rule one. You must be a world champion.",
      "scene": {
        "type": "trophies",
        "kicker": "Rule 1",
        "title": "World Cup winners only",
        "items": [
          {
            "kind": "worldcup",
            "label": "1998 · Henry"
          },
          {
            "kind": "worldcup",
            "label": "2006 · Buffon"
          },
          {
            "kind": "worldcup",
            "label": "2010 · Xavi, Iniesta"
          },
          {
            "kind": "worldcup",
            "label": "2014 · Neuer"
          }
        ]
      }
    },
    {
      "text": "Maldini lost the 1994 final on penalties. Baggio blazed the last one over the bar.",
      "say": "Maldeenee lost the nineteen ninety-four final on penalties. Bajjo blazed the last one over the bar.",
      "scene": {
        "type": "score",
        "home": "bra",
        "away": "ita",
        "hs": 0,
        "as": 0,
        "date": "17 July 1994 · Pasadena",
        "comp": "World Cup final",
        "ft": "AFTER EXTRA TIME",
        "note": "Brazil win 3-2 on penalties"
      }
    },
    {
      "text": "Lewandowski, De Bruyne, Salah and Haaland never even got there. Five gone.",
      "say": "Lehvandoffskee, Debroynuh, Sahlah, and Hohland never even got there. Five gone.",
      "scene": {
        "type": "stamp",
        "text": "NO WORLD CUP",
        "sub": "Maldini, Lewandowski, De Bruyne, Salah, Haaland",
        "person": "maldini",
        "color": "red"
      }
    },
    {
      "text": "Rule two. You must have finished second. So close it hurts.",
      "scene": {
        "type": "list",
        "kicker": "Rule 2",
        "title": "Best Ballon d'Or finish",
        "rows": [
          {
            "name": "Henry",
            "value": "2nd '03",
            "club": "ars",
            "hl": true
          },
          {
            "name": "Buffon",
            "value": "2nd '06",
            "club": "juv",
            "hl": true
          },
          {
            "name": "Iniesta",
            "value": "2nd '10",
            "club": "bar",
            "hl": true
          },
          {
            "name": "Xavi",
            "value": "3rd x3",
            "club": "bar"
          },
          {
            "name": "Neuer",
            "value": "3rd '14",
            "club": "bay"
          }
        ]
      }
    },
    {
      "text": "Xavi came third three years in a row. Neuer, third in 2014. Both out.",
      "say": "Shahvee came third three years in a row. Noyer, third in twenty fourteen. Both out.",
      "scene": {
        "type": "stamp",
        "text": "ONLY THIRD",
        "sub": "Xavi 2009, 2010, 2011 · Neuer 2014",
        "person": "xavi",
        "color": "yellow"
      }
    },
    {
      "text": "And in 2010, Iniesta lost it to his own team-mate. Messi got 22 percent of the vote. Iniesta 17.",
      "say": "And in twenty ten, Inyestah lost it to his own team-mate. Messee got twenty-two percent of the vote. Inyestah, seventeen.",
      "scene": {
        "type": "bars",
        "kicker": "FIFA Ballon d'Or 2010",
        "title": "Three Barcelona players on the podium",
        "unit": "%",
        "max": 25,
        "items": [
          {
            "label": "Lionel Messi",
            "value": 22.65,
            "person": "messi"
          },
          {
            "label": "Andrés Iniesta",
            "value": 17.36,
            "person": "iniestab",
            "hl": true
          },
          {
            "label": "Xavi",
            "value": 16.48,
            "person": "xavi"
          }
        ],
        "note": "Share of the vote"
      }
    },
    {
      "text": "Rule three. You must have scored in a World Cup final.",
      "scene": {
        "type": "compare",
        "title": "Rule 3: score in the final",
        "left": {
          "person": "henry",
          "name": "Henry",
          "sub": "France"
        },
        "right": {
          "person": "iniesta",
          "name": "Iniesta",
          "sub": "Spain"
        },
        "rows": [
          {
            "label": "World Cup finals played",
            "l": 1,
            "r": 1
          },
          {
            "label": "World Cups won",
            "l": 1,
            "r": 1
          },
          {
            "label": "Goals in finals",
            "l": 0,
            "r": 1,
            "better": "r"
          }
        ]
      }
    },
    {
      "text": "Buffon is a keeper. Henry never got on the pitch in 1998, and didn't score in 2006.",
      "say": "Booffon is a keeper. Onree never got on the pitch in ninety-eight, and didn't score in two thousand six.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "sub": "No goal in a World Cup final",
        "person": "henry",
        "color": "red"
      }
    },
    {
      "text": "Iniesta did. Johannesburg, 2010. The hundred and sixteenth minute.",
      "say": "Inyestah did. Johannesburg, twenty ten. The hundred and sixteenth minute.",
      "scene": {
        "type": "score",
        "home": "ned",
        "away": "esn",
        "hs": 0,
        "as": 1,
        "date": "11 July 2010 · Johannesburg",
        "comp": "World Cup final",
        "ft": "AFTER EXTRA TIME",
        "note": "Iniesta 116'"
      }
    },
    {
      "text": "Fàbregas finds him on the right. One touch. Half-volley. World champions.",
      "say": "Fabbregass finds him on the right. One touch. Half volley. World champions.",
      "scene": {
        "type": "gameclip",
        "parts": [
          [
            "work/footage/iniesta-2010/iniesta-winner/tv",
            30,
            92
          ],
          [
            "work/footage/iniesta-2010/iniesta-winner/high",
            92,
            200
          ]
        ],
        "goalAt": 2.47,
        "popup": {
          "home": "ned",
          "away": "esn",
          "homeName": "Netherlands",
          "awayName": "Spain",
          "hs0": 0,
          "as0": 0,
          "hs": 0,
          "as": 1,
          "scorer": "Iniesta",
          "assist": "Fàbregas"
        },
        "caption": "INIESTA 116'"
      }
    },
    {
      "text": "Then he pulled off his shirt. Underneath, a message for his friend Dani Jarque, who died the summer before.",
      "say": "Then he pulled off his shirt. Underneath, a message for his friend Dahnee Harkay, who died the summer before.",
      "scene": {
        "type": "news",
        "section": "World Cup final",
        "headline": "\"Dani Jarque, siempre con nosotros\"",
        "standfirst": "Iniesta dedicates the goal that wins Spain the World Cup to the Espanyol captain who died in August 2009. He is booked for the celebration.",
        "date": "11 July 2010",
        "byline": "Knowitball recap",
        "person": "iniesta",
        "club": "esp",
