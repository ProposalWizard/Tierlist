  "lines": [
    {
      "text": "What if Harry Kane had been born in France instead of England?",
      "scene": {
        "type": "title",
        "heading": "HARRY KANE",
        "sub": "England · since 2015",
        "pill": "WHAT IF HE WAS FRENCH?",
        "person": "kane"
      }
    },
    {
      "text": "Real world first. Kane is England's record scorer, with ninety-one goals.",
      "scene": {
        "type": "stats",
        "title": "Kane for England (6 Oct 2026)",
        "items": [
          {
            "n": "91",
            "l": "goals"
          },
          {
            "n": "125",
            "l": "caps, level with Shilton"
          }
        ],
        "person": "kane"
      }
    },
    {
      "text": "But the trophies? Two Euro finals, two defeats.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "2018",
            "label": "World Cup semi-final"
          },
          {
            "year": "2021",
            "label": "Euro 2020 final: lost"
          },
          {
            "year": "2024",
            "label": "Euro 2024 final: lost"
          },
          {
            "year": "2026",
            "label": "World Cup semi-final"
          }
        ]
      }
    },
    {
      "text": "Eleven years for England, and still no trophy.",
      "scene": {
        "type": "stamp",
        "text": "NO TROPHY YET",
        "person": "kane",
        "color": "red"
      }
    },
    {
      "text": "Now look at France in exactly the same years.",
      "scene": {
        "type": "person",
        "person": "kanefra",
        "label": "Same years, other side of the Channel",
        "mood": "flat"
      }
    },
    {
      "text": "They won the World Cup in twenty eighteen, beating Croatia four-two in Moscow.",
      "scene": {
        "type": "score",
        "home": "fra",
        "away": "cro",
        "hs": 4,
        "as": 2,
        "date": "15 July 2018",
        "comp": "World Cup final"
      }
    },
    {
      "text": "Then the Nations League in twenty twenty-one.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "worldcup",
            "label": "World Cup 2018"
          },
          {
            "kind": "cup",
            "label": "Nations League 2021"
          }
        ]
      }
    },
    {
      "text": "Plus two more finals: Euro twenty sixteen and the World Cup in Qatar.",
      "scene": {
        "type": "list",
        "title": "France since Kane's debut",
        "rows": [
          {
            "name": "World Cup 2018",
            "value": "WON",
            "club": "fra",
            "hl": true
          },
          {
            "name": "Nations League 2021",
            "value": "WON",
            "club": "fra",
            "hl": true
          },
          {
            "name": "Euro 2016",
            "value": "Final",
            "club": "fra"
          },
          {
            "name": "World Cup 2022",
            "value": "Final",
            "club": "fra"
          }
        ]
      }
    },
    {
      "text": "And in Qatar it was France who knocked England out, in the quarter-finals.",
      "scene": {
        "type": "text",
        "heading": "QATAR 2022",
        "body": "Quarter-final: England 1, France 2. France go on to the final."
      }
    },
    {
      "text": "So in this alternate world, Kane is France's number nine.",
      "scene": {
        "type": "whatif",
        "title": "Kane's international trophies",
        "real": {
          "label": "England (real)",
          "value": "0"
        },
        "alt": {
          "label": "France (imagined)",
          "value": "2"
        }
      }
    },
    {
      "text": "A World Cup winner's medal, a Nations League, and maybe Qatar ends differently too.",
      "scene": {
        "type": "quote",
        "person": "kanefra",
        "text": "Finally. A trophy."
      }
    },
    {
      "text": "Would Kane swap his England goals for a World Cup? Tell me in the comments.",
      "scene": {
        "type": "versus",
        "title": "Same striker, different passport",
        "left": {
          "person": "kane",
          "label": "England",
          "value": "0"
        },
        "right": {
          "person": "kanefra",
          "label": "France",
          "value": "2"
        }
      }
    },
    {
      "text": "Follow for more.",
      "scene": {
        "type": "cta"
      }
    }
  ]
