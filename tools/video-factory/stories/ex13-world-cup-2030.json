  "lines": [
    {
      "text": "The 2030 World Cup will be played on three continents.",
      "scene": {
        "type": "statement",
        "hook": true,
        "bg": "teal",
        "text": "WORLD CUP 2030|3 CONTINENTS",
        "hi": 1
      }
    },
    {
      "text": "The main hosts are Spain, Portugal and Morocco.",
      "scene": {
        "type": "statement",
        "bg": "red",
        "text": "SPAIN|PORTUGAL|MOROCCO",
        "size": 130
      }
    },
    {
      "text": "But the first three games will be in South America. Uruguay, Argentina and Paraguay.",
      "scene": {
        "type": "statement",
        "bg": "blue",
        "text": "URUGUAY|ARGENTINA|PARAGUAY",
        "size": 130
      }
    },
    {
      "text": "Why? Because the very first World Cup was in Uruguay, in 1930.",
      "scene": {
        "type": "years",
        "bg": "yellow",
        "items": [
          {
            "year": "1930",
            "top": "URUGUAY",
            "label": "The first World Cup",
            "tick": true
          },
          {
            "year": "2030",
            "top": "100 YEARS",
            "label": "Back where it began",
            "tick": true
          }
        ]
      }
    },
    {
      "text": "A hundred years later, it goes back to where it started.",
      "scene": {
        "type": "picture",
        "image": "centenario",
        "bg": "blue",
        "label": "MONTEVIDEO · 1930"
      }
    },
    {
      "text": "Six countries. Three continents. One tournament.",
      "scene": {
        "type": "statement",
        "bg": "purple",
        "text": "6 COUNTRIES|3 CONTINENTS|1 TROPHY",
        "hi": 2,
        "size": 120
      }
    }
  ],
