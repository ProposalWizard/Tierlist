  "lines": [
    {
      "text": "Italy have missed three World Cups in a row. What if Robert Lewandowski had been Italian?",
      "scene": {
        "type": "title",
        "heading": "ROBERT LEWANDOWSKI",
        "sub": "Poland · since 2008",
