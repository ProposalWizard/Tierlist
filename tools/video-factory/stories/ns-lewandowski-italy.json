  "lines": [
    { "text": "What if Robert Lewandowski had been born in Italy instead of Poland?", "scene": { "type": "title", "heading": "ROBERT LEWANDOWSKI", "sub": "Poland · since 2008", "pill": "WHAT IF HE WAS ITALIAN?", "person": "lewy" } },
    { "text": "Real world first. Lewandowski has played for Poland since twenty oh-eight, and he's their record scorer.", "scene": { "type": "person", "person": "lewy", "label": "Poland's record scorer", "mood": "happy" } },
    { "text": "Four Euros, two World Cups. Trophies? None.", "scene": { "type": "stamp", "text": "NO TROPHIES", "person": "lewy", "color": "red" } },
    { "text": "And this March, Poland lost their World Cup play-off final to Sweden, three-two.", "scene": { "type": "text", "heading": "MARCH 2026", "body": "Play-off final: Sweden 3, Poland 2. Poland miss the World Cup in North America." } },
    { "text": "Now look at Italy in exactly the same years.", "scene": { "type": "timeline", "items": [ { "year": "2012", "label": "Euro final: lost" }, { "year": "2018", "label": "No World Cup" }, { "year": "2021", "label": "Euro 2020: WON" }, { "year": "2022", "label": "No World Cup" }, { "year": "2026", "label": "No World Cup" } ] } },
    { "text": "They won Euro twenty twenty, beating England on penalties at Wembley.", "scene": { "type": "score", "home": "ita", "away": "eng", "hs": 1, "as": 1, "date": "11 July 2021", "comp": "Euro 2020 final", "note": "Italy win on penalties" } },
    { "text": "But then they missed three World Cups in a row.", "scene": { "type": "list", "title": "Italy at the World Cup", "rows": [ { "name": "2018 Russia", "value": "Didn't qualify", "club": "ita", "hl": true }, { "name": "2022 Qatar", "value": "Didn't qualify", "club": "ita", "hl": true }, { "name": "2026 North America", "value": "Didn't qualify", "club": "ita", "hl": true } ] } },
    { "text": "The latest? A play-off final this March, lost to Bosnia on penalties.", "scene": { "type": "stats", "title": "Italy since Lewy's debut", "items": [ { "n": "1", "l": "trophy" }, { "n": "3", "l": "World Cups missed" } ] } },
    { "text": "So in this alternate world, Lewandowski is Italy's number nine.", "scene": { "type": "person", "person": "lewyita", "label": "ALTERNATE WORLD", "mood": "happy" } },
    { "text": "He picks up a Euro winner's medal, one more than he has now.", "scene": { "type": "whatif", "title": "Lewandowski's senior trophies", "real": { "label": "Poland (real)", "value": "0" }, "alt": { "label": "Italy (imagined)", "value": "1" } } },
    { "text": "And with the striker Italy were missing, maybe those World Cup misses never happen.", "scene": { "type": "quote", "person": "lewyita", "text": "Three World Cups missed? Not with me up front." } },
    { "text": "Would Italian Lewandowski be a world champion? Tell me in the comments.", "scene": { "type": "versus", "title": "Same striker, different passport", "left": { "person": "lewy", "label": "Poland", "value": "0" }, "right": { "person": "lewyita", "label": "Italy", "value": "1+" } } },
    { "text": "Follow for more.", "scene": { "type": "cta" } }
  ]
