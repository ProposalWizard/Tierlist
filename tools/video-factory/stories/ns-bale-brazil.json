  "lines": [
    {
      "text": "What if Gareth Bale had been born in Brazil instead of Wales?",
      "scene": {
        "type": "title",
        "heading": "GARETH BALE",
        "sub": "Wales · 2006 to 2022",
        "pill": "WHAT IF HE WAS BRAZILIAN?",
        "person": "bale"
      }
    },
    {
      "text": "Real world first. Bale made his Wales debut in May two thousand six, aged just sixteen.",
      "scene": {
        "type": "person",
        "person": "baleyoung",
        "label": "Debut aged 16",
        "mood": "happy"
      }
    },
    {
      "text": "He played until the World Cup in Qatar: one hundred and eleven caps, forty-one goals. Both Wales records.",
      "scene": {
        "type": "stats",
        "title": "Bale for Wales",
        "items": [
          {
            "n": "111",
            "l": "caps"
          },
          {
            "n": "41",
            "l": "goals"
          }
        ],
        "person": "bale"
      }
    },
    {
      "text": "His best tournament? Euro twenty sixteen, all the way to the semi-finals.",
      "scene": {
        "type": "text",
        "heading": "EURO 2016",
        "body": "Wales reach their first major semi-final. Bale scores in all three group games."
      }
    },
    {
      "text": "But in sixteen years, Wales won nothing.",
      "scene": {
        "type": "stamp",
        "text": "NO TROPHIES",
        "person": "bale",
        "color": "red"
      }
    },
    {
      "text": "Now look at Brazil in exactly the same years.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "2007",
            "label": "Copa América"
          },
          {
            "year": "2009",
            "label": "Confederations Cup"
          },
          {
            "year": "2013",
            "label": "Confederations Cup"
          },
          {
            "year": "2019",
            "label": "Copa América"
          }
        ]
      }
    },
    {
      "text": "Two Copa Américas and two Confederations Cups.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "cup",
            "label": "Copa América 2007"
          },
          {
            "kind": "cup",
            "label": "Confed Cup 2009"
          },
          {
            "kind": "cup",
            "label": "Confed Cup 2013"
          },
          {
            "kind": "cup",
            "label": "Copa América 2019"
          }
        ]
      }
    },
    {
      "text": "The twenty thirteen one? Brazil beat world champions Spain three-nil in the final at the Maracanã.",
      "scene": {
        "type": "score",
        "home": "bra",
        "away": "esp",
        "hs": 3,
        "as": 0,
        "date": "30 June 2013",
        "comp": "Confederations Cup final"
      }
    },
    {
      "text": "So in this alternate world, Bale wears the yellow shirt.",
      "scene": {
        "type": "person",
        "person": "balebra",
        "label": "ALTERNATE WORLD",
        "mood": "happy"
      }
    },
    {
      "text": "That's four senior trophies instead of zero, just by changing the passport.",
      "scene": {
        "type": "whatif",
        "title": "Bale's international trophies",
        "real": {
          "label": "Wales (real)",
          "value": "0"
        },
        "alt": {
          "label": "Brazil (imagined)",
          "value": "4"
        }
      }
    },
    {
      "text": "And maybe a Bale-shaped answer to Germany at the twenty fourteen World Cup.",
      "scene": {
        "type": "quote",
        "person": "balebra",
        "text": "Seven-one? Not on my watch."
      }
    },
    {
      "text": "Wales hero, or Brazil legend? Which version wins more? Tell me in the comments.",
      "scene": {
        "type": "versus",
        "title": "Same player, different passport",
        "left": {
          "person": "bale",
          "label": "Wales",
          "value": "0"
        },
        "right": {
          "person": "balebra",
          "label": "Brazil",
          "value": "4"
        }
      }
    },
    {
      "text": "Follow for more, and play Road to Ballon d'Or at knowitball dot co dot uk.",
      "scene": {
        "type": "cta"
      }
    }
  ]
