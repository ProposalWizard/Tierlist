 "lines": [
  {
   "text": "Twenty twenty-four. Two Premier League clubs lost points, not on the pitch, but in their accounts.",
   "scene": {
    "type": "title",
    "heading": "EVERTON & FOREST",
    "sub": "2023/24",
    "pill": "12 POINTS DOCKED",
    "club": "eve"
   }
  },
  {
   "text": "The rule: lose more than a hundred and five million pounds over three years, and you're punished.",
