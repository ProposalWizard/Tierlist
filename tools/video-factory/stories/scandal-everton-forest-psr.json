    ],
    "note": "£19.5m over"
   }
  },
  {
   "text": "Seventeenth of November, twenty twenty-three. Ten points, gone. The biggest deduction in Premier League history.",
   "scene": {
    "type": "news",
    "section": "Premier League",
    "headline": "Everton docked 10 points",
    "standfirst": "The biggest sporting sanction in Premier League history, for breaking the league's profit and sustainability rules.",
    "date": "17 November 2023",
    "byline": "Knowitball recap",
    "club": "eve",
    "nav": [
     "Football",
     "Premier League",
     "Everton",
     "Finance"
    ]
   }
  },
  {
   "text": "In February, an appeal cut it to six.",
   "scene": {
    "type": "stamp",
    "text": "-10 → -6",
    "sub": "26 February 2024 · cut on appeal",
    "color": "yellow"
   }
  },
  {
   "text": "Then Forest. Thirty-four and a half million over their limit. Four points.",
   "scene": {
    "type": "news",
    "section": "Premier League",
    "headline": "Nottingham Forest docked four points",
    "standfirst": "The club breached its £61m limit by £34.5m. An early plea and cooperation cut the penalty from six points to four.",
    "date": "18 March 2024",
    "byline": "Knowitball recap",
    "club": "nfo",
    "nav": [
     "Football",
     "Premier League",
     "Forest",
     "Finance"
    ]
   }
  },
  {
   "text": "Their defence: they held on to Brennan Johnson until deadline day, then sold him to Spurs for forty-seven and a half million. The panel said no.",
   "scene": {
    "type": "person",
    "person": "johnson",
    "label": "SOLD ON DEADLINE DAY · £47.5M",
    "mood": "flat"
   }
  },
  {
   "text": "April: a second Everton breach. Two more points.",
   "scene": {
    "type": "stamp",
    "text": "-2",
    "sub": "8 April 2024 · a second breach",
    "color": "red"
   }
  },
  {
   "text": "Forest's appeal failed. The bill: Everton eight points, Forest four.",
