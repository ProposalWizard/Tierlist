  "lines": [
    {
      "text": "Twenty-five kids are up for the Golden Boy. We picked ten and let three rules choose.",
      "scene": {
        "type": "title",
        "heading": "GOLDEN BOY 2026",
        "sub": "25 finalists · named 5 October",
        "pill": "THREE RULES",
        "person": "kostoulas"
      }
    },
    {
      "text": "Cubarsí, Zaïre-Emery, and eight who play in England.",
      "scene": {
        "type": "list",
        "title": "Our ten finalists",
        "rows": [
          {
            "name": "Pau Cubarsí",
            "value": "Barcelona",
            "club": "bar"
          },
          {
            "name": "Warren Zaïre-Emery",
            "value": "PSG",
            "club": "psg"
          },
          {
            "name": "Estêvão · Jorrel Hato",
            "value": "Chelsea",
            "club": "che"
          },
          {
            "name": "Ayyoub Bouaddi",
            "value": "Man City",
            "club": "mci"
          },
          {
            "name": "Myles Lewis-Skelly",
            "value": "Arsenal",
            "club": "ars"
          },
          {
            "name": "Vušković · Kostoulas",
            "value": "Brighton",
            "club": "bha"
          },
          {
            "name": "Rayan · Junior Kroupi",
            "value": "Bournemouth",
            "club": "bou"
          }
        ]
      }
    },
    {
      "text": "Rule one. You have to play in the Premier League.",
      "scene": {
        "type": "text",
        "heading": "RULE 1",
        "body": "Must play in the Premier League this season."
      }
    },
    {
      "text": "Cubarsí in Barcelona and Zaïre-Emery in Paris. Both gone.",
      "scene": {
        "type": "stamp",
        "text": "OUT",
        "person": "cubarsi",
        "color": "red"
      }
    },
    {
      "text": "Rule two. Your club must be in the top four right now.",
      "scene": {
        "type": "text",
        "heading": "RULE 2",
        "body": "His club must be in the top four after nine games."
      }
    },
    {
      "text": "Bournemouth are eighth. So Rayan and Junior Kroupi drop out.",
      "scene": {
        "type": "list",
        "title": "Table after 9 games",
        "rows": [
          {
            "name": "1. Arsenal",
            "value": "24",
            "club": "ars",
            "hl": true
          },
          {
            "name": "2. Man City",
            "value": "21",
            "club": "mci",
            "hl": true
          },
          {
            "name": "3. Brighton",
            "value": "19",
            "club": "bha",
            "hl": true
          },
          {
            "name": "4. Chelsea",
            "value": "16",
            "club": "che",
            "hl": true
          },
          {
            "name": "8. Bournemouth",
            "value": "12",
            "club": "bou"
          }
        ]
      }
    },
    {
      "text": "Six left. Estêvão, Hato, Bouaddi, Lewis-Skelly, Vušković and Kostoulas.",
      "scene": {
        "type": "versus",
        "title": "Still in",
        "left": {
          "person": "estevao",
          "label": "Estêvão",
          "value": "Chelsea"
        },
        "right": {
          "person": "bouaddi",
          "label": "Bouaddi",
          "value": "Man City"
        }
      }
    },
    {
      "text": "Rule three. The most Premier League goals this season wins.",
      "scene": {
        "type": "text",
        "heading": "RULE 3",
        "body": "Most Premier League goals in 2026-27 goes through."
      }
    },
    {
      "text": "Vušković has one. And Brighton's Greek striker, Charalampos Kostoulas, has three.",
      "scene": {
        "type": "list",
        "title": "PL goals so far",
        "rows": [
          {
            "name": "Charalampos Kostoulas",
            "value": "3",
            "club": "bha",
            "hl": true
          },
          {
            "name": "Luka Vušković",
            "value": "1",
            "club": "bha"
          },
          {
            "name": "The other four",
            "value": "0"
          }
        ]
      }
    },
    {
      "text": "So the rules crown Kostoulas. Three league goals for the team in third.",
      "scene": {
        "type": "person",
        "person": "kostoulas",
        "label": "THE LAST NAME LEFT",
        "mood": "happy",
        "stamp": "WINNER"
      }
    },
    {
