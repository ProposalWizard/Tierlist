  "lines": [
    {
      "text": "Franck Ribéry won the treble. Then FIFA moved the deadline.",
      "scene": {
        "type": "title",
        "heading": "FRANCK RIBÉRY",
        "sub": "Bayern Munich · 2013",
        "pill": "ROBBED BY A DEADLINE?",
        "person": "ribery"
      }
    },
    {
      "text": "Twenty thirteen. Bayern win the Bundesliga, the German Cup and the Champions League.",
      "scene": {
        "type": "trophies",
        "items": [
          {
            "kind": "league",
            "label": "Bundesliga"
          },
          {
            "kind": "cup",
            "label": "DFB-Pokal"
          },
          {
            "kind": "bigears",
            "label": "Champions League"
          }
        ],
        "person": "ribery"
      }
    },
    {
      "text": "Wembley, the final against Dortmund. Eighty-ninth minute. Ribéry's flick sets up Robben. Two-one.",
      "scene": {
        "type": "score",
        "home": "bay",
        "away": "bvb",
        "hs": 2,
        "as": 1,
        "date": "25 May 2013",
        "comp": "Champions League final",
        "note": "Robben 89', Ribéry assist"
      }
    },
    {
      "text": "UEFA names him the best player in Europe. He's the favourite.",
      "scene": {
        "type": "person",
        "person": "ribery",
        "label": "UEFA Best Player in Europe",
        "mood": "happy"
      }
    },
    {
      "text": "Voting is meant to close on the fifteenth of November.",
      "scene": {
        "type": "text",
        "heading": "BALLON D'OR 2013",
        "body": "Votes from national team coaches, captains and journalists are due by 15 November."
      }
    },
    {
      "text": "Then FIFA extends it two weeks, to the twenty-ninth. The first time ever. Their reason? Not enough votes in.",
      "scene": {
        "type": "timeline",
        "items": [
          {
            "year": "15 Nov",
            "label": "Original deadline"
          },
          {
            "year": "19 Nov",
            "label": "Sweden v Portugal"
          },
          {
            "year": "29 Nov",
            "label": "New deadline"
          }
        ]
      }
    },
    {
      "text": "Voters could even change their picks.",
      "scene": {
        "type": "stamp",
        "text": "EXTENDED",
        "person": "ribery",
        "color": "yellow"
      }
    },
    {
      "text": "In between, a World Cup play-off in Stockholm. Cristiano Ronaldo scores a hat-trick. Portugal win three-two.",
      "scene": {
        "type": "score",
        "home": "swe",
        "away": "por",
        "hs": 2,
        "as": 3,
        "date": "19 November 2013",
        "comp": "World Cup play-off",
        "note": "Ronaldo hat-trick"
      }
    },
    {
      "text": "January. Ronaldo wins with twenty-eight percent. Messi second. Ribéry third.",
      "scene": {
        "type": "podium",
        "year": "2013",
        "title": "FIFA Ballon d'Or",
        "places": [
          {
            "person": "ronaldo",
            "club": "rma"
          },
          {
            "person": "messi",
            "club": "bar"
          },
          {
            "person": "ribery",
            "club": "bay"
          }
        ]
      }
    },
    {
      "text": "The points? Ronaldo thirteen sixty-five. Ribéry eleven twenty-seven.",
      "scene": {
        "type": "versus",
        "title": "2013 Ballon d'Or points",
        "left": {
          "person": "ronaldo",
          "label": "Ronaldo, 1st",
          "value": "1365"
        },
        "right": {
          "person": "ribery",
          "label": "Ribéry, 3rd",
          "value": "1127"
        }
      }
    },
    {
      "text": "FIFA said Ronaldo's win owed nothing to the extension. Ribéry called it an injustice.",
      "scene": {
        "type": "person",
        "person": "ribery",
        "label": "Ribéry: 'an injustice'",
        "mood": "flat"
      }
    },
    {
      "text": "Would the old deadline have changed it? Nobody can know.",
      "scene": {
        "type": "whatif",
        "title": "The deadline",
        "real": {
          "label": "Extended to 29 Nov",
          "value": "Ronaldo wins"
        },
        "alt": {
          "label": "Closed on 15 Nov",
          "value": "Nobody knows"
        }
      }
    },
    {
      "text": "A treble winner, third. Robbed? Tell me in the comments.",
      "scene": {
        "type": "stamp",
        "text": "ROBBED?",
        "person": "ribery",
        "color": "red"
      }
    },
    {
      "text": "Follow for more.",
      "scene": {
        "type": "cta"
      }
    }
  ]
