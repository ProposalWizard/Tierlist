                "top": "CRUYFF",
                "tick": true,
                "head": "#f5913a"
              }
            ],
            "w": 16
          }
        ]
      }
    },
    {
      "text": "Michel Platini, a midfielder who was Serie A's top scorer three years running, and scored nine goals at Euro 84.",
