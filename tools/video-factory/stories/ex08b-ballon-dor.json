            "w": 9
          }
        ]
      }
    },
    {
      "text": "Lionel Messi won four in a row, from 2009 to 2012. That last one, after ninety-one goals in a year.",
      "scene": {
        "bg": "blue",
        "type": "picture",
        "steps": [
          {
            "type": "picture",
