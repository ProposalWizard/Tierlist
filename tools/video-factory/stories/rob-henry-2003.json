  "lines": [
    { "text": "Twenty-four goals. Twenty assists. And Thierry Henry still didn't win the Ballon d'Or.",
      "scene": { "type": "title", "heading": "THIERRY HENRY", "sub": "Arsenal · 2002/03", "pill": "ROBBED IN 2003?", "person": "henry" } },
    { "text": "In 2002-03, Henry was scoring them and making them.", "say": "In twenty-oh-two, oh-three, on-REE was scoring them, and making them.",
      "scene": { "type": "stats", "kicker": "Premier League 2002/03", "title": "Scoring them and making them", "items": [ { "n": "24", "l": "league goals" }, { "n": "20", "l": "league assists" } ], "person": "henry" } },
    { "text": "Twenty assists was a Premier League record. He swept the PFA and Football Writers' awards.",
      "scene": { "type": "trophies", "kicker": "Thierry Henry · 2002/03", "title": "20 assists: a Premier League record", "items": [ { "kind": "award", "label": "PFA Players' Player of the Year" }, { "kind": "award", "label": "FWA Footballer of the Year" } ] } },
    { "text": "On the second of March, Arsenal were eight points clear at the top.",
      "scene": { "type": "news", "section": "Premier League", "headline": "Arsenal eight points clear at the top", "standfirst": "The champions lead Manchester United with ten games to go. Henry is the league's best player.", "date": "2 March 2003", "byline": "Knowitball recap", "club": "ars", "person": "henry", "nav": ["Football", "Premier League", "Arsenal", "Man United"] } },
    { "text": "Then it fell apart. Leeds won three-two at Highbury, and United were champions.",
      "scene": { "type": "score", "home": "ars", "away": "lee", "hs": 2, "as": 3, "date": "4 May 2003 · Highbury", "comp": "Premier League", "note": "Viduka's late winner hands Manchester United the title" } },
    { "text": "Five points. The best season of his life, and no league title.",
      "scene": { "type": "table", "season": "Final table 2002/03", "title": "Premier League", "rows": [
        { "pos": 1, "club": "mun", "p": 38, "w": 25, "d": 8, "l": 5, "gd": 40, "pts": 83 },
        { "pos": 2, "club": "ars", "p": 38, "w": 23, "d": 9, "l": 6, "gd": 43, "pts": 78, "hl": true },
        { "pos": 3, "club": "new", "p": 38, "w": 21, "d": 6, "l": 11, "gd": 15, "pts": 69 },
        { "pos": 4, "club": "che", "p": 38, "w": 19, "d": 10, "l": 9, "gd": 30, "pts": 67 },
        { "pos": 5, "club": "liv", "p": 38, "w": 18, "d": 10, "l": 10, "gd": 20, "pts": 64 },
        { "pos": 6, "club": "blb", "p": 38, "w": 16, "d": 12, "l": 10, "gd": 9, "pts": 60 } ],
        "zones": [ { "kind": "champ", "rows": [1, 1] }, { "kind": "ucl", "rows": [2, 4] }, { "kind": "uel", "rows": [5, 6], "label": "UEFA Cup" } ],
        "gap": { "from": 1, "to": 2, "label": "5 pts", "at": 0.45 } } },
    { "text": "Meanwhile in Turin, Pavel Nedvěd drove Juventus to the title and the Champions League final.",
      "scene": { "type": "badge", "club": "juv", "kicker": "Meanwhile in Turin", "title": "Juventus", "sub": "Serie A champions · Champions League finalists" } },
    { "text": "Then a yellow card in the semi against Real Madrid. Suspended. He missed the final.",
      "scene": { "type": "stamp", "text": "SUSPENDED", "sub": "Booked in the semi-final · out of the final", "person": "nedved", "color": "yellow" } },
    { "text": "Without him, Juve drew nil-nil with Milan, and lost on penalties.",
      "scene": { "type": "score", "home": "juv", "away": "mil", "hs": 0, "as": 0, "date": "28 May 2003 · Old Trafford", "comp": "Champions League final", "ft": "AFTER EXTRA TIME", "note": "Milan win 3-2 on penalties" } },
    { "text": "December. Nedvěd won it, with a hundred and ninety points. Henry got a hundred and twenty-eight.",
      "scene": { "type": "podium", "year": "2003", "title": "The vote", "places": [ { "person": "nedved", "club": "juv", "points": 190 }, { "person": "henry", "club": "ars", "points": 128 }, { "person": "maldini", "club": "mil", "points": 123 } ] } },
    { "text": "Twenty-seven voters put Nedvěd first. Henry got eight. Not even close.",
      "scene": { "type": "compare", "title": "The 2003 vote", "left": { "person": "nedved", "name": "Nedvěd", "sub": "Juventus" }, "right": { "person": "henry", "name": "Henry", "sub": "Arsenal" }, "rows": [ { "label": "Points", "l": 190, "r": 128 }, { "label": "First-place votes", "l": 27, "r": 8 }, { "label": "League titles 2002/03", "l": 1, "r": 0 } ] } },
    { "text": "Some writers call the robbery a myth. Nedvěd was brilliant too.",
      "scene": { "type": "news", "section": "Ballon d'Or", "headline": "Was Henry really robbed?", "standfirst": "Nedvěd won Serie A and carried Juventus to a European final. Some writers say the Henry robbery is a myth.", "date": "The other side", "byline": "Knowitball recap", "person": "nedved", "club": "juv", "mastColor": "#1b1f2b", "nav": ["Football", "Ballon d'Or", "Serie A", "Analysis"] } },
    { "text": "Next season, Arsenal went the whole league unbeaten. Henry scored thirty.",
      "scene": { "type": "line", "kicker": "Thierry Henry", "title": "Premier League goals by season", "y": { "min": 0, "max": 35, "label": "goals" }, "x": ["99/00", "00/01", "01/02", "02/03", "03/04", "04/05"], "series": [ { "name": "Henry", "club": "ars", "values": [17, 17, 24, 24, 30, 25] } ], "notes": [ { "i": 4, "text": "Invincibles: 38 unbeaten" } ] } },
    { "text": "And he finished fourth. Shevchenko won it.",
      "scene": { "type": "list", "kicker": "One year later", "title": "Ballon d'Or 2004", "rows": [ { "name": "Andriy Shevchenko", "value": "175", "club": "mil" }, { "name": "Deco", "value": "139", "club": "por" }, { "name": "Ronaldinho", "value": "133", "club": "bar" }, { "name": "Thierry Henry", "value": "80", "club": "ars", "hl": true } ] } },
    { "text": "Second, in the best season of his life, while the winner missed the final. That's the robbery.",
      "scene": { "type": "stamp", "text": "ROBBED", "sub": "Henry · Ballon d'Or 2003", "person": "henry", "color": "red" } },
    { "text": "Follow for more, and play Road to Ballon d'Or.", "scene": { "type": "cta" } }
  ]
}
