 "lines": [
  {
   "text": "What if the most famous goal in Premier League history was never scored, because the man who scored it never came?",
   "scene": {
    "type": "title",
    "heading": "SERGIO AGÜERO",
    "sub": "ATLÉTICO MADRID · 2011",
    "pill": "WHAT IF?",
    "person": "aguero"
   }
  },
  {
   "text": "Summer twenty eleven. Kun Agüero is twenty-three, and half of Europe wants him.",
   "scene": {
    "type": "person",
    "person": "aguero",
    "label": "AGE 23",
    "mood": "happy"
   }
  },
  {
   "text": "Real Madrid were interested. Chelsea were interested. But Juventus got closest.",
   "scene": {
    "type": "list",
    "title": "WHO WANTED KUN",
    "rows": [
     {
      "name": "Juventus",
      "value": "closest",
      "club": "juv",
      "hl": true
     },
     {
      "name": "Real Madrid",
      "value": "interested",
      "club": "rma"
     },
     {
      "name": "Chelsea",
      "value": "interested",
      "club": "che"
     },
     {
      "name": "Man City",
      "value": "signed him",
      "club": "mci"
     }
    ]
   }
  },
  {
   "text": "Years later he said it himself: before City, he had everything in place with Juventus.",
   "scene": {
    "type": "quote",
    "person": "aguero",
    "text": "Before Manchester City, I had everything in place with Juventus."
   }
  },
  {
   "text": "Then City came in, for a fee of around thirty-five million pounds.",
   "scene": {
    "type": "stats",
    "title": "JULY 2011",
    "items": [
     {
      "n": "£35m",
      "l": "reported fee"
     },
     {
      "n": "23",
      "l": "years old"
     }
    ],
    "person": "aguerocity"
   }
  },
  {
   "text": "So in this alternate world, Kun signs for Juventus instead.",
   "scene": {
    "type": "whatif",
    "title": "SUMMER 2011",
    "real": {
     "label": "Real world",
     "value": "Man City"
    },
    "alt": {
     "label": "Alternate world",
     "value": "Juventus"
    }
   }
  },
  {
   "text": "Now jump to the last day of the season. City are two-one down to ten-man QPR in stoppage time.",
   "scene": {
    "type": "score",
    "home": "mci",
    "away": "qpr",
    "hs": 1,
    "as": 2,
    "date": "13 May 2012",
    "comp": "Premier League",
    "note": "90 mins played"
   }
  },
  {
   "text": "Džeko heads the equaliser. Then, at ninety-three minutes twenty, Agüero wins the league.",
   "scene": {
    "type": "score",
    "home": "mci",
    "away": "qpr",
    "hs": 3,
    "as": 2,
    "date": "13 May 2012",
    "comp": "Premier League",
    "note": "Agüero 93:20",
    "stamp": "93:20"
   }
  },
  {
   "text": "But Kun is in Turin. In our alternate world, the game finishes two-two.",
   "scene": {
    "type": "whatif",
    "title": "FINAL DAY",
    "real": {
     "label": "Real world",
     "value": "City 3-2 QPR"
    },
    "alt": {
     "label": "Alternate world",
     "value": "City 2-2 QPR"
    }
   }
  },
  {
   "text": "United won at Sunderland, so they finish on eighty-nine points. City finish on eighty-seven.",
   "scene": {
    "type": "versus",
    "title": "ALTERNATE TABLE",
    "left": {
     "person": "ferguson",
     "label": "Man United",
     "value": "89"
    },
    "right": {
     "person": "mancini",
     "label": "Man City",
     "value": "87"
    }
   }
  },
  {
   "text": "Sir Alex Ferguson lifts title number twenty, one year earlier than he really did.",
   "scene": {
    "type": "trophies",
    "items": [
     {
      "kind": "league",
      "label": "United's 20th (imagined)"
     }
    ],
    "person": "ferguson"
   }
  },
  {
   "text": "And City's first league title since nineteen sixty-eight? Still waiting.",
   "scene": {
    "type": "stamp",
    "text": "STILL WAITING",
    "color": "red"
   }
  },
  {
   "text": "In the real world, Agüero left City in twenty twenty-one with two hundred and sixty goals, the club record.",
   "scene": {
    "type": "stats",
    "title": "THE REAL KUN",
    "items": [
     {
      "n": "260",
      "l": "City goals"
     },
     {
      "n": "390",
      "l": "games"
     }
    ],
    "person": "aguerocity"
   }
  },
  {
   "text": "One transfer. One goal. A whole decade could look different.",
   "scene": {
    "type": "person",
    "person": "aguerojuv",
    "label": "KUN AT JUVENTUS?",
    "mood": "flat"
   }
  },
