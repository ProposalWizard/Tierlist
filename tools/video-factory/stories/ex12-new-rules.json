    {
      "text": "Football's rules changed this season. Here's what you might have missed.",
      "scene": {
        "type": "statement",
        "hook": true,
        "text": "NEW RULES|2026/27",
        "hi": 1
      }
    },
    {
      "text": "One. VAR can now overturn a corner that should never have been given.",
      "scene": {
        "type": "statement",
        "text": "VAR|CAN CHECK|CORNERS",
        "hi": 2
      }
    },
    {
      "text": "Two. Referees now count down restarts, to stop time-wasting.",
      "scene": {
        "type": "stopwatch",
        "to": 5,
        "word": "COUNTDOWNS ON RESTARTS"
      }
    },
    {
      "text": "Three. Telling your teammates to walk off in protest can now be a red card, where competitions choose.",
