  "lines": [
    { "text": "One Golden Boot winner was still a teenager. Another was thirty-three. Here's every Premier League top scorer, by age.", "scene": { "type": "title", "heading": "THE GOLDEN BOOT, BY AGE", "sub": "Premier League · 1993 to 2026", "pill": "YOUNGEST TO OLDEST", "person": "owen" } },
    { "text": "Michael Owen. Eighteen years old, joint top scorer in nineteen ninety-eight. Then he did it again at nineteen.", "scene": { "type": "person", "person": "owen", "label": "18 · 1997-98", "mood": "happy", "stamp": "YOUNGEST" } },
    { "text": "Twenty-two and twenty-three: Andy Cole, Harry Kane, Cristiano Ronaldo, and Haaland's thirty-six goal debut.", "scene": { "type": "list", "title": "AGED 22 TO 23", "rows": [ { "name": "Andy Cole (1993-94)", "value": "22", "club": "newcastle" }, { "name": "Harry Kane (2015-16)", "value": "22", "club": "spurs" }, { "name": "Erling Haaland (2022-23)", "value": "22", "club": "mancity", "hl": true }, { "name": "Cristiano Ronaldo (2007-08)", "value": "23", "club": "manutd" }, { "name": "Harry Kane (2016-17)", "value": "23", "club": "spurs" }, { "name": "Erling Haaland (2023-24)", "value": "23", "club": "mancity" } ] } },
    { "text": "Twenty-four to twenty-six is Shearer's three in a row, a young Henry, and Salah's thirty-two goal season.", "scene": { "type": "list", "title": "AGED 24 TO 26", "rows": [ { "name": "Alan Shearer (1994-95)", "value": "24", "club": "blackburn" }, { "name": "Thierry Henry (2001-02)", "value": "24", "club": "arsenal" }, { "name": "Mohamed Salah (2017-18)", "value": "25", "club": "liverpool", "hl": true }, { "name": "Erling Haaland (2025-26)", "value": "25", "club": "mancity" }, { "name": "Kevin Phillips (1999-00)", "value": "26", "club": "sunderland" }, { "name": "Ruud van Nistelrooy (2002-03)", "value": "26", "club": "manutd" }, { "name": "Sergio Aguero (2014-15)", "value": "26", "club": "mancity" } ] } },
    { "text": "Twenty-seven and twenty-eight: Sheringham, Suarez, Tevez, Henry's last two, and Robin van Persie.", "scene": { "type": "list", "title": "AGED 27 TO 28", "rows": [ { "name": "Teddy Sheringham (1992-93)", "value": "27", "club": "spurs" }, { "name": "Dwight Yorke (1998-99)", "value": "27", "club": "manutd" }, { "name": "Luis Suarez (2013-14)", "value": "27", "club": "liverpool", "hl": true }, { "name": "Carlos Tevez (2010-11)", "value": "27", "club": "mancity" }, { "name": "Harry Kane (2020-21)", "value": "27", "club": "spurs" }, { "name": "Thierry Henry (2005-06)", "value": "28", "club": "arsenal" }, { "name": "Robin van Persie (2011-12)", "value": "28", "club": "arsenal" } ] } },
    { "text": "Twenty-nine and thirty: Dion Dublin, Hasselbaink, Son, and Anelka and Berbatov past thirty.", "scene": { "type": "list", "title": "AGED 29 TO 30", "rows": [ { "name": "Dion Dublin (1997-98)", "value": "29", "club": "coventry" }, { "name": "Jimmy Floyd Hasselbaink (2000-01)", "value": "29", "club": "chelsea" }, { "name": "Robin van Persie (2012-13)", "value": "29", "club": "manutd" }, { "name": "Salah and Son (2021-22)", "value": "29", "club": "liverpool" }, { "name": "Nicolas Anelka (2008-09)", "value": "30", "club": "chelsea" }, { "name": "Dimitar Berbatov (2010-11)", "value": "30", "club": "manutd" } ] } },
    { "text": "Then the veterans. Didier Drogba, twenty-nine goals, at thirty-two.", "scene": { "type": "person", "person": "drogba", "label": "32 · 2009-10", "mood": "happy" } },
    { "text": "But here's the twist. Salah's fourth Golden Boot came at thirty-two too, and he was nearly a year older than Drogba.", "scene": { "type": "versus", "title": "THE OLD BOYS", "left": { "person": "drogba", "label": "Drogba 2010", "value": "32y 1m" }, "right": { "person": "salah", "label": "Salah 2025", "value": "32y 11m" } } },
    { "text": "That fourth boot equalled Thierry Henry's record.", "scene": { "type": "stats", "title": "MOST GOLDEN BOOTS", "items": [ { "n": "4", "l": "Thierry Henry" }, { "n": "4", "l": "Mohamed Salah" }, { "n": "3", "l": "Shearer, Kane, Haaland" } ] } },
    { "text": "And the oldest of all? Jamie Vardy. Twenty-three goals in twenty twenty, at thirty-three.", "scene": { "type": "person", "person": "vardy", "label": "33 · 2019-20", "mood": "happy", "stamp": "OLDEST" } },
    { "text": "Eight years after his non-league days, he outscored the whole Premier League.", "scene": { "type": "timeline", "items": [ { "year": "2012", "label": "Joins Leicester from Fleetwood" }, { "year": "2016", "label": "Champions" }, { "year": "2020", "label": "Golden Boot at 33" } ] } },
    { "text": "Last season Haaland made it three in four years, at just twenty-five.", "scene": { "type": "person", "person": "haaland", "label": "25 · 2025-26", "mood": "happy" } },
    { "text": "So from eighteen to thirty-three, there's no wrong age to be the best finisher in England.", "scene": { "type": "timeline", "items": [ { "year": "18", "label": "Owen" }, { "year": "22", "label": "Cole, Kane, Haaland" }, { "year": "25", "label": "Salah, Haaland" }, { "year": "32", "label": "Drogba, Salah" }, { "year": "33", "label": "Vardy" } ] } },
    { "text": "Follow for more.", "scene": { "type": "cta" } }
  ]
}
