 "vo": [
  {
   "seg": "grid",
   "offset": 0.3,
   "text": "Thirty-eight games, not one defeat. Or a hundred points, the first team ever."
  },
  {
   "seg": "homeSheet",
   "offset": 0.3,
   "text": "Wenger's Invincibles: Vieira, Pires, Bergkamp and Thierry Henry.",
   "say": "Wenger's Invincibles: Veeyaira, Peerez, Burgkamp and Teeairee Onree."
  },
  {
   "seg": "awaySheet",
   "offset": 0.2,
   "text": "Pep's Centurions: De Bruyne, David Silva and Agüero.",
   "say": "Pep's Centurions: Deh Broynuh, David Silva and Ahgwairoh."
  },
  {
   "seg": "versus",
   "offset": 0.2,
   "text": "At Old Trafford in 2003, Van Nistelrooy's late penalty hit the bar. Arsenal never lost a league game all season.",
   "say": "At Old Trafford in two thousand and three, Van Nistelroy's late penalty hit the bar. Arsenal never lost a league game all season."
  },
  {
   "seg": "globe",
   "offset": 0.4,
   "text": "They even won the title at White Hart Lane. City won eighteen league games in a row, and got point one hundred in the ninety-fourth minute."
  },
  {
   "seg": "ratings",
   "offset": 0.3,
   "text": "No FIFA game covers 2004, so Arsenal's ratings are our prediction. Henry, ninety-four.",
   "say": "No FIFA game covers two thousand and four, so Arsenal's ratings are our prediction. Onree, ninety-four."
  },
  {
   "seg": "g1",
   "offset": 0.1,
   "spill": true,
   "text": "Fourteen minutes. De Bruyne, from twenty-two yards. City lead.",
   "say": "Fourteen minutes. Deh Broynuh, from twenty-two yards. City lead."
  },
  {
   "seg": "g2",
   "offset": 0.2,
   "spill": true,
   "text": "Gilberto finds Henry. Henry runs. One each.",
   "say": "Zheelbairtoh finds Onree. Onree runs. One each."
  },
  {
   "seg": "g3",
   "offset": 0.2,
   "spill": true,
   "text": "Sané tears down the left, and Agüero taps in.",
   "say": "Sahnay tears down the left, and Ahgwairoh taps in."
  },
  {
   "seg": "g4",
   "offset": 0.2,
   "spill": true,
   "text": "Then Bergkamp's pass, and Vieira is through. Two all.",
   "say": "Then Burgkamp's pass, and Veeyaira is through. Two all."
  },
  {
   "seg": "g5",
   "offset": 0.1,
   "spill": true,
   "text": "Eighty-seven minutes. Henry cuts it back, Pires sweeps it home.",
   "say": "Eighty-seven minutes. Onree cuts it back, Peerez sweeps it home."
  },
  {
   "seg": "fulltime",
   "offset": 0.5,
   "text": "Three-two at Highbury. Still invincible."
  },
  {
   "seg": "potm",
   "offset": 0.8,
   "text": "Player of the match: Thierry Henry. Invincibles or Centurions: who really wins?",
   "say": "Player of the match: Teeairee Onree. Invincibles or Centurions: who really wins?"
  },
  {
   "seg": "end",
   "offset": 0.3,
   "text": "Follow for more, and play Road to Ballon d'Or.",
   "say": "Follow for more, and play Road to Ballon Dor."
