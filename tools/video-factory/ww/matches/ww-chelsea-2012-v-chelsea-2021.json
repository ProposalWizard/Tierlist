 "vo": [
  {
   "seg": "grid",
   "offset": 0.3,
   "text": "Chelsea against Chelsea. Munich, twenty twelve, or Porto, twenty twenty-one?"
  },
  {
   "seg": "homeSheet",
   "offset": 0.2,
   "text": "In twenty twelve, Chelsea sacked Villas-Boas in March. Caretaker Di Matteo won them the Champions League.",
   "say": "In twenty twelve, Chelsea sacked Veelash Boash in March. Caretaker Dee Mattayo won them the Champions League."
  },
  {
   "seg": "awaySheet",
   "offset": 0.1,
   "text": "In twenty twenty-one, they sacked Frank Lampard in January. Tuchel won it in May.",
   "say": "In twenty twenty-one, they sacked Frank Lampard in January. Tookel won it in May."
  },
  {
   "seg": "versus",
   "offset": 0.3,
   "text": "And the twist? Lampard signed Havertz, Werner, Chilwell and Mendy. Then someone else won with them.",
   "say": "And the twist? Lampard signed Havverts, Verner, Chilwell and Mendy. Then someone else won with them."
  },
  {
   "seg": "globe",
   "offset": 0.5,
   "text": "So tonight at Stamford Bridge, Captain Lampard faces the team he built."
  },
  {
   "seg": "ratings",
   "offset": 0.3,
   "text": "FIFA twelve has Drogba at eighty-six. FIFA twenty-one has Kanté at eighty-eight. Too close to call.",
   "say": "FIFA twelve has Drogba at eighty-six. FIFA twenty-one has Kontay at eighty-eight. Too close to call."
  },
  {
   "seg": "goal1",
   "offset": 0.1,
   "spill": true,
   "text": "Twenty-three minutes. Mata's corner, Drogba at the near post. Munich all over again.",
   "say": "Twenty-three minutes. Mahta's corner, Drogba at the near post. Munich all over again."
  },
  {
   "seg": "goal2",
   "offset": 0.2,
   "spill": true,
   "text": "Then Porto. Mount slides it through, Havertz rounds Čech.",
   "say": "Then Porto. Mount slides it through, Havverts rounds Chek."
  },
  {
   "seg": "goal3",
   "offset": 0.2,
   "spill": true,
   "text": "And who else? Lampard, from the edge. Two-one."
  },
  {
   "seg": "late",
   "offset": 0.0,
   "spill": true,
   "text": "Ninety-third minute. Werner, one on one, for the draw...",
   "say": "Ninety-third minute. Verner, one on one, for the draw..."
  },
  {
   "seg": "fulltime",
   "offset": 0.6,
   "text": "Over the bar! Twenty twelve hold on, two-one."
  },
  {
