 "vo": [
  {
   "seg": "grid",
   "offset": 0.3,
   "text": "Barça against Barça. The class of oh-nine, or the class of fifteen?",
   "say": "Barsah against Barsah. The class of oh nine, or the class of fifteen?"
  },
  {
   "seg": "homeSheet",
   "offset": 0.2,
   "text": "Guardiola's first season: Messi, Eto'o and Henry scored a hundred goals, and won the treble.",
   "say": "Gwardeeohlah's first season: Messi, Ehtohoh and Onree scored a hundred goals, and won the treble."
  },
  {
   "seg": "awaySheet",
   "offset": 0.1,
   "text": "Luis Enrique's first season? M S N. A hundred and twenty-two goals.",
   "say": "Looeess Enreekay's first season? M, S, N. A hundred and twenty-two goals."
  },
  {
   "seg": "versus",
   "offset": 0.3,
   "text": "And four men started both finals: Messi, Iniesta, Busquets and Piqué.",
   "say": "And four men started both finals: Messi, Inyestah, Booskets and Peekay."
  },
  {
   "seg": "globe",
   "offset": 0.5,
   "text": "So at the Camp Nou, they play themselves. Messi at twenty-one, against Messi at twenty-seven."
  },
  {
   "seg": "ratings",
   "offset": 0.3,
   "text": "In FIFA oh-nine, Busquets was rated just sixty. By FIFA fifteen? Eighty-five.",
   "say": "In FIFA oh nine, Booskets was rated just sixty. By FIFA fifteen? Eighty-five."
  },
  {
   "seg": "goal1",
   "offset": 0.1,
   "spill": true,
   "text": "Ten minutes, just like Rome. Iniesta finds Eto'o, near post.",
   "say": "Ten minutes, just like Rome. Inyestah finds Ehtohoh, near post."
  },
  {
   "seg": "goal2",
   "offset": 0.2,
   "spill": true,
   "text": "M S N wake up. Neymar squares it, Suárez taps in.",
   "say": "M, S, N wake up. Naymar squares it, Swahrez taps in."
  },
  {
   "seg": "goal3",
   "offset": 0.1,
   "spill": true,
   "text": "Then Xavi crosses, and young Messi heads it in. Rome all over again.",
   "say": "Then Shahvee crosses, and young Messi heads it in. Rome all over again."
  },
  {
   "seg": "goal4",
   "offset": 0.2,
   "spill": true,
   "text": "But old Messi has learned a few things. Top corner. Two-all."
  },
  {
   "seg": "late",
   "offset": 0.0,
   "spill": true,
   "text": "Ninety-fourth minute. Messi slips in Neymar...",
   "say": "Ninety-fourth minute. Messi slips in Naymar..."
  },
  {
   "seg": "fulltime",
   "offset": 0.6,
   "text": "Three-two, twenty fifteen. M S N beat the hundred-goal trio.",
   "say": "Three-two, twenty fifteen. M, S, N beat the hundred-goal trio."
  },
  {
   "seg": "potm",
   "offset": 0.8,
   "text": "Player of the match? Lionel Messi. Only Messi beats Messi."
  },
  {
   "seg": "end",
   "offset": 0.3,
   "text": "Follow for more, and play Road to Ballon d'Or.",
   "say": "Follow for more, and play Road to Ballon Dor."
  }
 ]
