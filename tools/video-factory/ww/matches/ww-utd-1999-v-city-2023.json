 "vo": [
  {
   "seg": "grid",
   "offset": 0.3,
   "text": "Two trebles. One city. Only one can win."
  },
  {
   "seg": "homeSheet",
   "offset": 0.3,
   "text": "Manchester United, 1999: Beckham, Keane, Scholes and Giggs. The first English treble.",
   "say": "Manchester United, nineteen ninety-nine: Beckham, Keen, Skoles and Giggs. The first English treble."
  },
  {
   "seg": "awaySheet",
   "offset": 0.2,
   "text": "Manchester City, 2023: Haaland scored thirty-six league goals, a record.",
   "say": "Manchester City, twenty twenty-three: Hohland scored thirty-six league goals, a record."
  },
  {
   "seg": "versus",
   "offset": 0.2,
   "text": "United won the league by one point on the last day. Then Keane and Scholes were banned from the final.",
   "say": "United won the league by one point on the last day. Then Keen and Skoles were banned from the final."
  },
  {
   "seg": "globe",
   "offset": 0.4,
   "text": "Bayern led in Barcelona until stoppage time. Two Beckham corners, two goals, and the treble.",
   "say": "Byern led in Barcelona until stoppage time. Two Beckham corners, two goals, and the treble."
  },
  {
   "seg": "ratings",
   "offset": 0.3,
   "text": "No FIFA game covers 1999, so United's ratings are our prediction. City won theirs in Istanbul.",
   "say": "No FIFA game covers nineteen ninety-nine, so United's ratings are our prediction. City won theirs in Istanbul."
  },
  {
   "seg": "g1",
   "offset": 0.1,
   "spill": true,
   "text": "Kick-off. Haaland flicks it on, Gündoğan volleys. Just like the cup final.",
   "say": "Kick-off. Hohland flicks it on, Gundogan volleys. Just like the cup final."
  },
  {
   "seg": "g2",
   "offset": 0.2,
   "spill": true,
   "text": "Beckham bends a free kick over the wall. One all."
  },
  {
   "seg": "g3",
   "offset": 0.2,
   "spill": true,
   "text": "Bernardo cuts it back, and Rodri does it again.",
   "say": "Bernardoh cuts it back, and Rodree does it again."
  },
  {
   "seg": "late",
   "offset": 0.0,
   "spill": true,
   "text": "Stoppage time. Beckham's corner. Yorke heads it in."
  },
  {
   "seg": "g5",
   "offset": 0.2,
   "spill": true,
   "text": "Then Beckham again, and Andy Cole pokes it home."
  },
  {
   "seg": "fulltime",
   "offset": 0.5,
   "text": "Three-two. Late drama at Old Trafford, again."
  },
  {
   "seg": "potm",
   "offset": 0.8,
   "text": "Player of the match: David Beckham. Which treble wins it?"
