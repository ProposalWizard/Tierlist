@@ -0,0 +1,91 @@
+#!/usr/bin/env node
+/**
+ * scripts/patch-notes/media-to-r2.mjs — put a patch note's stills and clips
+ * straight into Cloudflare R2 instead of the repo (22 Oct 2026, the
+ * follow-up to the "Move media to Cloudflare" button).
+ *
+ * Needs the four R2 settings in the environment (R2_ACCOUNT_ID,
+ * R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET), the same ones Vercel
+ * has. Signs with lib/marketing/r2.ts (no new package, no second copy).
+ * Files already in R2 at the same size are skipped.
+ *
+ *   node scripts/patch-notes/media-to-r2.mjs 0.108h 0.109h   those versions' folders (patch-notes/pages/<v>/)
+ *   node scripts/patch-notes/media-to-r2.mjs --all           every media file under patch-notes/
+ *   node scripts/patch-notes/media-to-r2.mjs --dry 0.108h    list what would go, upload nothing
+ *
+ * Exit 3 = no R2 settings here (ship.mjs then says what to do).
+ */
+import fs from "node:fs";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+export const MEDIA = /\.(jpe?g|png|webp|gif|mp4)$/i;
+const TYPES = { jpg: "image/jpeg", jpeg: "image/jpeg", png: "image/png", webp: "image/webp", gif: "image/gif", mp4: "video/mp4" };
+
+async function loadR2() {
+  const ts = createRequire(path.join(ROOT, "package.json"))("typescript");
+  const src = fs.readFileSync(path.join(ROOT, "lib/marketing/r2.ts"), "utf8");
+  const js = ts.transpileModule(src, { compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2020 } }).outputText;
+  return import(`data:text/javascript;base64,${Buffer.from(js).toString("base64")}`);
+}
+
+/** Media files (paths under patch-notes/) in the given folders. */
+export function mediaUnder(root, folders) {
+  const out = [];
+  const walk = (abs, rel) => {
+    if (!fs.existsSync(abs)) return;
+    for (const e of fs.readdirSync(abs, { withFileTypes: true })) {
+      const r = `${rel}/${e.name}`;
+      if (e.isDirectory()) walk(path.join(abs, e.name), r);
+      else if (MEDIA.test(e.name)) out.push({ rel: r.replace(/^\//, ""), size: fs.statSync(path.join(abs, e.name)).size });
+    }
+  };
+  for (const f of folders) walk(path.join(root, "patch-notes", f), f);
+  return out;
+}
+
+export async function uploadMedia({ root = ROOT, folders, dry = false, log = console.log }) {
+  const r2 = await loadR2();
+  const { config, missing } = r2.r2ConfigFrom(process.env);
+  if (!config) return { ok: false, missing };
+  const files = mediaUnder(root, folders);
+  const there = new Map();
+  let token = null;
+  for (let page = 0; page < 30; page++) {
+    const query = { "list-type": "2", prefix: "patch-notes/", "max-keys": "1000" };
+    if (token) query["continuation-token"] = token;
+    const res = await fetch(r2.r2Url(config, "GET", "", new Date(), 300, { query }));
+    if (!res.ok) throw new Error(`Listing the bucket answered ${res.status}.`);
+    const got = r2.parseList(await res.text());
+    for (const o of got.objects) there.set(o.key, o.size);
+    if (!got.next) break;
+    token = got.next;
+  }
+  let sent = 0, bytes = 0;
+  for (const f of files) {
+    const key = `patch-notes/${f.rel}`;
+    if (there.get(key) === f.size) continue;
+    if (dry) { log(`  would upload ${key} (${f.size} B)`); continue; }
+    const body = fs.readFileSync(path.join(root, "patch-notes", f.rel));
+    const type = TYPES[path.extname(f.rel).slice(1).toLowerCase()];
+    const headers = { "content-length": String(body.length), "content-type": type };
+    const res = await fetch(r2.r2Url(config, "PUT", key, new Date(), 300, { headers }), { method: "PUT", body, headers });
+    if (!res.ok) throw new Error(`Uploading ${key} answered ${res.status}.`);
+    sent++; bytes += body.length;
+  }
+  log(`media-to-r2: ${files.length} media files, ${sent} uploaded (${(bytes / 1024 / 1024).toFixed(1)} MB), ${files.length - sent} already there${dry ? " (dry run)" : ""}.`);
+  return { ok: true, files, sent };
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
+  const args = process.argv.slice(2);
+  const versions = args.filter((a) => !a.startsWith("--"));
+  const folders = args.includes("--all") ? [""] : versions.map((v) => `pages/${v}`);
+  if (!folders.length) { console.error("Name the versions, or --all."); process.exit(2); }
+  try {
+    const r = await uploadMedia({ folders, dry: args.includes("--dry") });
+    if (!r.ok) { console.error(`media-to-r2: no R2 settings here (missing ${r.missing.join(", ")}).`); process.exit(3); }
+  } catch (e) { console.error(`media-to-r2: ${e.message}`); process.exit(1); }
+}
