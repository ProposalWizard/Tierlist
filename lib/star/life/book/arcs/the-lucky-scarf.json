     ]
    },
    "setup": [
     "{fan.name} has had the seat by the tunnel since before your dad was born. After the game he leans over the rail and holds out a scarf so faded you can barely see the colours."
    ],
    "talk": {
     "start": "f1",
     "nodes": {
      "f1": {
       "who": "fan",
       "say": [
        "\"I've had this since 1971. It's been lucky for every good player we've had. You're not one yet, but you might be. Take it.\""
       ],
       "replies": [
        {
         "id": "take",
         "label": "\"I can't take that.\"",
         "tone": "humble",
         "goto": "f2"
        },
        {
         "id": "yes",
         "label": "Take it. \"I'll wear it on the bus.\"",
         "tone": "kind",
         "end": "took"
        },
        {
         "id": "joke",
         "label": "\"Has it been washed since 1971?\"",
         "tone": "confident",
         "goto": "f2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "took-quiet"
        }
       ]
      },
      "f2": {
       "who": "fan",
       "say": [
        "\"Don't be soft. My wife's been trying to bin it for fifty years. Take it before she wins.\""
       ],
       "replies": [
        {
         "id": "take",
         "label": "Take it.",
         "tone": "kind",
         "end": "took"
        },
        {
         "id": "no",
         "label": "\"Keep it, honestly. It's yours.\"",
         "tone": "calm",
         "end": "refused"
        }
       ]
      }
     },
     "ends": {
      "took": [
       {
        "text": "It smells of cigarettes and pies. You score the next week and point at the seat by the tunnel. He stands up, which he doesn't do.",
        "effects": {
