      "outcomes": [
       {
        "if": "arc.told==1 || arc.told==2",
        "text": "He replies with a photo of a school hall. You keep it.",
        "npc": [
         {
          "slot": "vet",
          "bond": 8,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "vet",
          "tag": "wrote-back-after-the-fix",
          "strength": 3
         }
        ],
        "arc": {
         "end": "you-saved-him"
        }
       },
       {
