        "npc": [
         {
          "slot": "vet",
          "bond": -6,
          "respect": 4,
          "grudge": 4
         }
        ],
        "remember": [
         {
          "slot": "vet",
          "tag": "said-no-to-the-penalty",
          "strength": 3
         }
        ]
       }
      ],
      "reported": [
       {
        "text": "You sit outside {manager.short}'s office for an hour while he's in there. When he comes out the gaffer is behind him with a hand on his shoulder and a phone to his ear.",
        "effects": {
         "boss": 6
