     ]
    },
    "setup": [
     "{vet.name} asks you to sit in his car for a minute. He's thirty-three and he's been here eight years. The engine's off and he doesn't look at you."
    ],
    "talk": {
     "start": "a1",
     "nodes": {
      "a1": {
       "who": "vet",
       "say": [
        "\"I owe some people. A lot. They know you're on penalties. They want you to miss one on Saturday if we get one. Two grand for you. And they wipe mine.\""
       ],
       "replies": [
        {
         "id": "no",
         "label": "\"No. Never. Get out of it some other way.\"",
         "tone": "brave",
         "goto": "a-no"
        },
        {
         "id": "who",
         "label": "\"Who are these people?\"",
         "tone": "honest",
         "goto": "a2"
        },
        {
         "id": "gaffer",
         "label": "\"We're going to the gaffer. Now.\"",
         "tone": "brave",
         "goto": "a-gaffer"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "a2"
        }
       ]
      },
      "a2": {
       "who": "vet",
       "say": [
        "\"You don't want to know. I've got two kids. They've been outside my house, in a car.\""
       ],
       "replies": [
        {
         "id": "help",
         "label": "\"Then let me help. Not like this.\"",
         "tone": "kind",
         "goto": "a-gaffer"
        },
        {
         "id": "yes",
         "label": "\"Once. Then never again.\"",
         "tone": "reckless",
         "end": "agreed",
         "var": {
          "deal": "yes"
         }
        },
        {
         "id": "no",
         "label": "\"I can't. I'm sorry.\"",
         "tone": "honest",
         "goto": "a-no"
        }
       ]
      },
      "a-no": {
       "who": "vet",
       "say": [
        "\"I knew you'd say that.\" He grips the wheel. \"Don't tell anyone. Please. Just don't.\""
       ],
       "replies": [
        {
         "id": "quiet",
         "label": "\"I won't tell anyone.\"",
         "tone": "calm",
         "end": "refused-quiet",
         "var": {
          "deal": "no"
         }
        },
        {
         "id": "tell",
         "label": "\"I'm telling the gaffer, for your sake.\"",
         "tone": "brave",
         "goto": "a-gaffer"
        }
       ]
      },
      "a-gaffer": {
       "who": "vet",
       "say": [
        "He's crying now, properly. \"He'll sack me.\""
       ],
       "replies": [
        {
         "id": "with",
         "label": "\"I'll be in there with you.\"",
         "tone": "kind",
         "end": "reported",
         "var": {
          "deal": "reported"
         }
        },
        {
         "id": "alone",
         "label": "\"Then go on your own. I'll know if you don't.\"",
         "tone": "cold",
         "end": "refused-quiet",
         "var": {
          "deal": "no"
         }
        }
       ]
      }
     },
     "ends": {
      "agreed": [
       {
        "text": "He grips your arm. \"Thank you.\" He gives you a phone number on a piece of paper and tells you to burn it after.",
        "effects": {
         "scandal": true
        },
        "npc": [
         {
          "slot": "vet",
