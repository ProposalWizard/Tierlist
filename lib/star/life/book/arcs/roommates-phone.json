        {
         "id": "no",
         "label": "\"I can't promise that.\"",
         "tone": "honest",
         "end": "no-promise"
        },
        {
         "id": "tell",
         "label": "\"I'm telling the gaffer in the morning.\"",
         "tone": "cold",
         "end": "told"
        }
       ]
      }
     },
