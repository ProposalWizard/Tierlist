       "replies": [
        {
         "id": "help",
         "label": "\"Delete it. Now, with me here.\"",
         "tone": "brave",
         "goto": "h-rules"
        },
        {
         "id": "lend",
         "label": "\"If you're short, I can help. Just stop.\"",
         "tone": "kind",
         "goto": "h-rules"
        }
       ]
      },
      "h-rules": {
       "who": "roomie",
       "say": [
        "\"If this gets out I'm finished. You won't say anything, will you? Promise me.\""
       ],
       "replies": [
