    "setup": [
     "{capt.name} is suspended for the cup game. The gaffer calls you over at the end of training and holds out the armband. It's frayed at one end where the captain chews it."
    ],
    "talk": {
     "start": "a1",
     "nodes": {
      "a1": {
       "who": "manager",
       "say": [
        "\"One game. Don't make a speech, don't change anything, toss the coin and lead them out. Can you do that?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I can do that.\"",
         "tone": "confident",
         "goto": "a2"
        },
        {
         "id": "him",
         "label": "\"Shouldn't one of the older lads have it?\"",
         "tone": "humble",
         "goto": "a3"
        },
        {
         "id": "proud",
         "label": "\"I've wanted this since I was six.\"",
         "tone": "honest",
         "goto": "a2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "a2"
        }
       ]
      },
      "a3": {
       "who": "manager",
       "say": [
        "\"I've asked you.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Then I'll do it.\"",
         "tone": "calm",
         "goto": "a2"
        }
       ]
      },
      "a2": {
       "who": "capt",
       "say": [
        "In the car park {capt.short} stops you. \"Call tails. I always call tails. We haven't lost a cup game on tails in four years.\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"Tails. I promise.\"",
         "tone": "kind",
         "end": "promised",
         "promise": "p-the-toss"
        },
        {
         "id": "mine",
         "label": "\"I'll call what I like.\"",
         "tone": "fiery",
         "end": "mine"
        }
       ]
      }
     },
     "ends": {
      "promised": [
       {
        "text": "He taps the armband on your arm twice. \"Don't chew it. That's mine.\"",
        "npc": [
         {
          "slot": "manager",
          "respect": 4
         },
         {
          "slot": "capt",
          "respect": 2,
          "bond": 6
         }
        ],
        "arc": {
         "set": {
          "path": "promised"
         }
        }
       }
      ],
      "mine": [
       {
        "text": "\"Course you will.\" He gets in his car and slams the door harder than it needs.",
        "npc": [
         {
          "slot": "manager",
          "respect": 4
         },
         {
          "slot": "capt",
          "grudge": 6
         }
        ],
        "arc": {
