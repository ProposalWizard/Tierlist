    "talk": {
     "start": "g1",
     "nodes": {
      "g1": {
       "who": "manager",
       "say": [
        "{if arc.shirt=='you'}\"Nine's a big shirt at this club. {mate.short} scored eleven in it last season. I want to see what you do in it.\"{/if}",
        "{if arc.shirt=='him'}\"You let {mate.short} have nine. I'd like to know whether that's because you're a team player or because you didn't want it.\"{/if}",
        "{if arc.shirt=='none'}\"Neither of you is wearing nine until you can stand in a corridor without a fight. Do you understand me?\"{/if}"
       ],
       "replies": [
        {
         "id": "calm",
         "label": "\"It's a number. I'll score whatever I'm wearing.\"",
         "tone": "calm",
         "goto": "g2"
        },
        {
         "id": "confident",
         "label": "\"Give me three games and you'll see.\"",
         "tone": "confident",
         "goto": "g2",
         "mood": 1
        },
        {
         "id": "fiery",
         "label": "\"Then pick a striker and stop making us scrap for it.\"",
         "tone": "fiery",
         "end": "snapped",
         "mood": -1
        },
        {
         "id": "quiet",
         "label": "… Say nothing",
         "silent": true,
         "goto": "g2"
        }
       ]
      },
