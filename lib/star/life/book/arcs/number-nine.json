    "trigger": {
     "when": [
      "arrive:training"
     ]
    },
    "setup": [
     "{mate.name} has been out for nine weeks with his ankle. He's on pitch two with a bag of balls, on his own, in a protective boot on the bad foot.",
     "{if arc.feel=='sour'}You haven't said much to each other since the nine.{/if}",
     "{if arc.deep=='lift'}He still calls you \"nine\" when nobody's listening.{/if}",
     "{if arc.deep=='horn'}He hasn't forgotten the horn.{/if}"
    ],
    "talk": {
     "start": "a1",
     "nodes": {
      "a1": {
       "who": "mate",
       "say": [
        "\"The physio says I can shoot on Monday. Nobody else will stay out and feed me. They think I'm done.\""
       ],
       "replies": [
        {
         "id": "feed",
         "label": "\"I'll feed you. Today, if you want.\"",
         "tone": "kind",
         "goto": "a2",
         "mood": 1
        },
        {
         "id": "why",
         "label": "\"Why are you asking me?\"",
         "tone": "honest",
         "goto": "a-why"
        },
        {
         "id": "no",
         "label": "\"Ask one of the kids.\"",
         "tone": "cold",
         "end": "refused"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "a-why"
        }
       ]
      },
      "a-why": {
       "who": "mate",
       "say": [
        "\"Because you're the one who wants my place. If I'm finishing in the corners against your passes, I'm fit.\""
       ],
       "replies": [
        {
         "id": "feed",
         "label": "\"Get on the D, then.\"",
         "tone": "brave",
         "goto": "a2"
        },
        {
         "id": "no",
         "label": "\"I'm not helping you take it back.\"",
         "tone": "fiery",
         "end": "refused-hard"
        }
       ]
      },
      "a2": {
       "who": "mate",
       "say": [
        "\"Ten. Roll them through the cones onto my right foot. If it's a bad ball I'm not chasing it, I've got one ankle.\""
       ],
       "replies": [
        {
         "id": "go",
         "label": "Roll the first one.",
         "tone": "calm",
         "goto": "play"
        }
       ]
      },
      "play": {
       "activity": {
        "mode": "feed-drill",
        "name": "His comeback",
        "intro": "Ten passes through the cones. A good ball gives him a better chance.",
        "dials": {
         "balls": 10,
         "shooter": {
          "slot": "mate"
         }
        },
        "score": "his goals off your passes (0-10)",
        "canAbandon": true,
        "fallback": {
         "kind": "skill-check",
         "stat": "vision",
         "target": 55
        },
        "cost": {
         "energy": -5
        }
       },
       "result": [
        [
         "activity.abandoned",
         "f-stop"
        ],
        [
         "activity.score>=6",
         "f-good"
        ],
        [
         "",
         "f-poor"
        ]
       ]
      },
      "f-good": {
       "who": "mate",
       "say": [
        "\"{activity.score} in. Don't tell the physio I hit them that hard.\" He sits down on the bag. \"When I'm right, I'm going to ask the gaffer to play two up top. You and me. Will you back me?\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"I'll back you. Say when.\"",
         "tone": "honest",
         "end": "backing"
        },
        {
         "id": "maybe",
         "label": "\"Get fit first. Then we'll see.\"",
         "tone": "calm",
         "end": "fed-maybe"
        }
       ]
      },
      "f-poor": {
       "who": "mate",
       "say": [
        "\"{activity.score}. That's my ankle, not your passing.\" He doesn't sound sure. \"Same time next week?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Same time.\"",
         "tone": "kind",
         "end": "fed-maybe"
        },
        {
         "id": "no",
         "label": "\"I've got my own game to worry about.\"",
         "tone": "cold",
         "end": "fed-once"
        }
       ]
      },
      "f-stop": {
       "who": "mate",
       "say": [
        "\"That's it? Fine. Thanks, I suppose.\""
       ],
       "replies": [
        {
         "id": "sorry",
         "label": "\"I've got a knock. Monday, properly.\"",
         "tone": "honest",
         "end": "fed-once"
        },
        {
         "id": "go",
         "label": "Go in.",
         "tone": "cold",
         "end": "refused"
        }
       ]
      }
     },
     "ends": {
      "backing": [
       {
        "text": "\"Say when.\" He writes it on the strapping on his wrist.",
        "effects": {
         "team": 4
        },
        "npc": [
         {
          "slot": "mate",
          "bond": 12,
          "respect": 8
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "fed-him-on-his-comeback",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "fed": 1
         }
        },
        "promise": "p-back-him"
       }
      ],
      "fed-maybe": [
       {
        "text": "He limps in with the bag. He's quicker on it than he was this morning.",
        "effects": {
         "team": 2
        },
        "npc": [
         {
          "slot": "mate",
          "bond": 8,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "fed-him-on-his-comeback",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "fed": 1
         }
        }
       }
      ],
      "fed-once": [
       {
        "text": "He collects the balls himself.",
        "npc": [
         {
          "slot": "mate",
          "bond": 2
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "fed-him-once",
          "strength": 1
         }
        ],
        "arc": {
         "set": {
          "fed": 1
         }
        }
       }
      ],
      "refused": [
       {
        "text": "One of the academy lads feeds him instead. He makes a point of thanking the kid where you can hear it.",
        "effects": {
         "team": -2
        },
        "npc": [
         {
          "slot": "mate",
          "bond": -6,
          "respect": -2,
          "grudge": 6
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "wouldnt-feed-him",
          "strength": 2
         }
        ],
        "snub": "mate"
       }
      ],
      "refused-hard": [
       {
        "text": "\"Good to know where I stand.\" He tells the dressing room before you're back in it.",
        "effects": {
         "team": -4
        },
        "npc": [
         {
          "slot": "mate",
          "bond": -10,
          "grudge": 14
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "wouldnt-feed-him",
          "strength": 3
         }
        ],
        "noteSquad": "refused-to-help-the-injured-lad",
        "snub": "mate"
       }
      ]
     }
