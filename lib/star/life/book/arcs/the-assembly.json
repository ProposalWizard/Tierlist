     "nodes": {
      "a1": {
       "who": "canteen",
       "say": [
        "\"My grandson is nine. He's told his whole school he knows you, which he doesn't. Would you come to his assembly? Before half the class calls him a liar.\""
       ],
       "replies": [
        {
         "id": "yes",
