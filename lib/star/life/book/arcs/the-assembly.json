         "label": "\"Thursday after next.\"",
         "tone": "kind",
         "goto": "a2",
         "promise": "p-assembly"
        },
        {
         "id": "maybe",
         "label": "\"I'll see what training's doing.\"",
         "tone": "calm",
         "end": "maybe"
        }
       ]
      },
      "a2": {
       "who": "canteen",
       "say": [
