         "label": "Say nothing.",
         "silent": true,
         "goto": "a-what"
        }
       ]
      },
      "a-what": {
       "who": "canteen",
       "say": [
        "\"Stand at the front, say work hard and eat your vegetables. Ten minutes, Thursday after next.\""
