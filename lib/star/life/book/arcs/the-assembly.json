         "tone": "kind",
         "goto": "a2",
         "promise": "p-assembly"
        },
        {
         "id": "ask",
         "label": "\"What do they want me to do?\"",
         "tone": "honest",
         "goto": "a-what"
        },
        {
         "id": "no",
         "label": "\"I don't really do schools.\"",
         "tone": "cold",
         "end": "no"
        },
        {
