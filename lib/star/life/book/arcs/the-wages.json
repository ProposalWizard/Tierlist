    "talk": {
     "start": "c1",
     "nodes": {
      "c1": {
       "who": "capt",
       "say": [
        "\"Right. No wages, no word from upstairs. Some of the lads want to not train today. I want to hear from everyone. You first.\""
       ],
       "replies": [
        {
         "id": "train",
         "label": "\"We train. It's not the kids in the stand's fault.\"",
         "tone": "brave",
         "end": "train"
        },
        {
         "id": "no",
         "label": "\"No wages, no training. That's how they'll listen.\"",
         "tone": "fiery",
         "end": "strike"
        },
        {
         "id": "chair",
         "label": "\"Get the chairman down here to tell us himself.\"",
         "tone": "calm",
         "end": "chair"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "train"
        }
       ]
      }
     },
     "ends": {
      "train": [
       {
        "text": "You train. It's the best session of the season, for some reason. The staff watch from the canteen window.",
