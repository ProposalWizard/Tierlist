       "who": "chairman",
       "screen": "dial",
       "say": [
        "The social club, three hundred people, a man in a good suit at the back who might buy the club. {chairman.short} asks you to say a few words. He's hoping you'll say everything's fine. {reporter.name} is in the front row."
       ],
       "replies": [
        {
         "id": "humble",
         "label": "\"We just want to play. We'll keep turning up.\"",
         "tone": "humble",
         "end": "humble"
        },
        {
         "id": "calm",
         "label": "\"We're owed two months. We're still turning up. That's all I know.\"",
         "tone": "calm",
         "end": "calm"
        },
        {
         "id": "confident",
         "label": "\"Whoever buys this club gets a squad that stayed.\"",
         "tone": "confident",
         "end": "confident"
        },
        {
         "id": "fiery",
         "label": "\"We've had the excuses. Where's the money gone?\"",
         "tone": "fiery",
         "end": "fiery"
        }
       ]
      }
