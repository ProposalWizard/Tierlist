    "talk": {
     "start": "v1",
     "nodes": {
      "v1": {
       "who": "pal",
       "say": [
        "\"Garden landscaping. I've got three jobs lined up and no van. The bank said no. I need three weeks of what you earn. I'll pay it back monthly, with interest if you want.\""
       ],
       "replies": [
        {
         "id": "lend",
         "label": "\"I'll lend it. Pay me back when you can.\"",
         "tone": "kind",
         "goto": "v2",
         "cost": {
          "moneyWeeks": 2
         }
        },
        {
         "id": "plan",
         "label": "\"Show me the plan, then.\"",
         "tone": "honest",
         "goto": "v-plan"
        },
        {
         "id": "no",
         "label": "\"I don't lend money to mates. It never ends well.\"",
         "tone": "honest",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "v-plan"
        }
       ]
      },
      "v-plan": {
       "who": "pal",
       "say": [
        "He talks you through it page by page. It's better than you expected, which you don't say."
       ],
       "replies": [
        {
         "id": "lend",
         "label": "\"All right. I'm in.\"",
         "tone": "brave",
         "goto": "v2",
         "cost": {
          "moneyWeeks": 2
         }
        },
        {
         "id": "no",
         "label": "\"It's good. It's still a no.\"",
         "tone": "cold",
         "end": "no-after-plan"
        }
       ]
      },
      "v2": {
       "who": "pal",
       "say": [
        "\"First payment on the first of the month. I'll set it up tonight. You'll see.\""
       ],
       "replies": [
        {
         "id": "trust",
         "label": "\"I know.\"",
         "tone": "calm",
         "end": "lent"
        },
        {
         "id": "joke",
         "label": "\"If you don't, I'm having the van.\"",
         "tone": "confident",
         "end": "lent"
        }
       ]
      }
     },
