 "size": "small",
 "about": {
  "who": [
   "agent",
   "transfer window"
  ],
  "tone": [
   "tense",
   "funny"
  ]
 },
 "start": {
  "chance": 0.22,
  "careers": 0.2
 },
 "cast": [
  {
   "slot": "agent",
   "pick": "agent"
  },
  {
