    "talk": {
     "start": "k1",
     "nodes": {
      "k1": {
       "who": "physio",
       "say": [
        "In the treatment room {physio.name} has her hand flat on your knee. \"I'm not guessing tonight. Scan in the morning. But you need to hear me: if it's what I think, it's months.\""
       ],
       "replies": [
        {
         "id": "months",
         "label": "\"How many months?\"",
         "tone": "honest",
         "goto": "k2"
        },
        {
         "id": "him",
         "label": "\"Did he mean it?\"",
         "tone": "fiery",
         "goto": "k3"
        },
        {
         "id": "fine",
         "label": "\"It'll be fine.\"",
         "tone": "lie",
         "goto": "k2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "k2"
        }
       ]
      },
      "k3": {
       "who": "physio",
       "say": [
        "\"I don't know and I don't care. I care about your knee.\""
       ],
       "replies": [
        {
         "id": "months",
         "label": "\"How many months?\"",
         "tone": "honest",
         "goto": "k2"
        }
       ]
      },
      "k2": {
       "who": "physio",
       "say": [
        "\"Depends on the scan. Depends on you. I'll want you in the pool at six every morning and you'll hate me. No stairs. No stupid stuff. Can you do that?\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"Six every morning. I promise.\"",
         "tone": "humble",
         "end": "promised",
         "promise": "p-the-stairs"
        },
        {
         "id": "try",
         "label": "\"I'll try.\"",
         "tone": "calm",
         "end": "try"
        }
       ]
      }
     },
     "ends": {
      "promised": [
       {
        "text": "The scan says what she thought. She writes six o'clock on the whiteboard in the physio room and underlines it twice.",
        "effects": {
