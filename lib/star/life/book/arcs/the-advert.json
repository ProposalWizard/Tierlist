        "effects": {
         "fans": 1
        },
        "arc": {
         "end": "the-hands"
        }
       }
      ]
     },
     {
      "id": "sign",
      "label": "Sign their programmes and go.",
      "tone": "calm",
      "outcomes": [
       {
        "if": "arc.path=='line'",
        "text": "You sign them. One of them shouts the line as you drive off.",
        "effects": {
         "fans": 2
        },
        "npc": [
         {
          "slot": "sponsor",
          "bond": 2
         }
        ],
        "arc": {
         "end": "the-line"
        }
       },
       {
        "text": "You sign them. Nobody shouts anything.",
        "effects": {
         "fans": 1
        },
        "arc": {
         "end": "the-hands"
        }
       }
      ]
     }
    ],
    "callbacks": [],
    "cast": [
     {
