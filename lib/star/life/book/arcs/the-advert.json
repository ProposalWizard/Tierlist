     ]
    },
    "setup": [
     "A studio with a fake pitch and a fan blowing at your face. {sponsor.name} from {sponsor.outlet} has a card with your one line on it: \"Built for the ninetieth minute.\" It's take thirty-one."
    ],
    "talk": {
     "start": "a1",
     "nodes": {
      "a1": {
       "who": "sponsor",
       "say": [
        "\"Lovely. Can you say it like you mean it? Like it's the ninetieth minute. Like you're tired but not tired.\""
       ],
       "replies": [
        {
         "id": "again",
         "label": "Say it again, tired but not tired.",
         "tone": "humble",
         "end": "again"
        },
        {
         "id": "own",
         "label": "\"Can I say it my way?\"",
         "tone": "confident",
         "goto": "a2"
        },
        {
         "id": "done",
         "label": "\"I'm done. Use my feet.\"",
         "tone": "calm",
         "end": "feet"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "again"
        }
       ]
      },
      "a2": {
       "who": "sponsor",
       "say": [
        "\"Your way's fine. As long as it's the words on the card.\""
       ],
       "replies": [
        {
         "id": "again",
         "label": "Say it your way.",
         "tone": "confident",
         "end": "again"
        }
       ]
      }
     },
     "ends": {
      "again": [
       {
        "text": "Take thirty-two. The director cries a little. It's on telly by the end of the month, eleven seconds long.",
        "effects": {
         "fame": 2,
         "moneyWeeks": 1
        },
        "npc": [
         {
          "slot": "sponsor",
          "bond": 6
         }
        ],
        "remember": [
         {
          "slot": "sponsor",
          "tag": "did-the-advert-line",
          "strength": 1
         }
        ],
        "arc": {
         "set": {
          "path": "line"
         }
        }
       }
      ],
      "feet": [
       {
        "text": "They film your feet for an hour and use a voice from a man in Leeds. You're paid the same.",
        "effects": {
         "moneyWeeks": 1
        },
        "npc": [
         {
          "slot": "sponsor",
          "bond": -2
         }
        ],
        "arc": {
         "set": {
          "path": "feet"
         }
        }
       }
      ]
     }
    },
    "choices": [],
    "callbacks": [],
    "cast": [
     {
      "slot": "sponsor",
      "pick": "sponsor"
     }
