    },
    "setup": [
     "A season on. After a home game there are kids by the car park gate.",
     "{if arc.path=='line'}One of them shouts \"Built for the ninetieth minute!\" in a voice that's a lot like yours. The rest do it too.{/if}",
     "{if arc.path=='feet'}One of them asks if you're the feet off the telly.{/if}",
     "{if arc.deep=='yes'}The second advert's line is worse than the first.{/if}"
    ],
    "choices": [
     {
      "id": "do",
      "label": "Do the line for them.",
      "tone": "confident",
      "outcomes": [
       {
        "if": "arc.path=='line'",
