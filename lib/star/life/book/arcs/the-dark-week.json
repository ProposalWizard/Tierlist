          "respect": 6
         }
        ],
        "arc": {
         "set": {
          "gaffer": "told"
         }
        }
       },
       {
        "text": "\"Right.\" He goes straight to the physio's room. By the afternoon the club's welfare officer has been round to {mate.short}'s house.",
        "effects": {
         "boss": 1
        },
        "arc": {
         "set": {
          "gaffer": "told"
         }
        }
       }
      ]
     },
