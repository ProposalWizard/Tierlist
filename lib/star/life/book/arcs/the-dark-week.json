      "label": "\"He's not well, gaffer. He needs time, and people around him.\"",
      "tone": "honest",
      "outcomes": [
       {
        "if": "arc.path=='doctor' || arc.path=='listened'",
        "text": "He nods slowly. \"The doctor's told me as much as she can. Thanks for being straight.\" He rings {mate.short} himself that night, and talks about anything but football.",
        "effects": {
         "boss": 2
        },
        "npc": [
