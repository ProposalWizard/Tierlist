   "id": "his-word",
   "title": "His word",
   "text": "The gaffer gave you his word and broke it, and told the papers you weren't fit. You know what his word is worth now."
  },
  {
   "id": "you-backed-him",
   "title": "You backed him",
   "text": "The gaffer lied to you about the cup game. A season on, when the knives were out, you backed him anyway. He knows what that cost."
  },
  {
   "id": "the-truth-in-print",
   "title": "In print",
   "text": "You told the local paper what the gaffer had promised. It was the truth. He never picked you for a cup game again."
  }
