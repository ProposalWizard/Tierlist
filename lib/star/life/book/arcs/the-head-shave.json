    "talk": {
     "start": "h1",
     "nodes": {
      "h1": {
       "who": "mate",
       "say": [
        "\"It's a grand if two of us do it. I've asked six lads and they've all got photo shoots, apparently. Will you?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Go on. Do me first.\"",
         "tone": "brave",
         "goto": "h2"
        },
        {
         "id": "money",
         "label": "\"I'll give you the grand. I'm keeping my hair.\"",
         "tone": "honest",
         "end": "paid",
         "cost": {
          "moneyWeeks": 1
         }
        },
        {
         "id": "no",
         "label": "\"I can't, mate. Sorry.\"",
         "tone": "calm",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "no"
        }
       ]
      },
      "h2": {
       "who": "mate",
       "say": [
        "\"Number one or the full thing?\""
       ],
       "replies": [
        {
         "id": "full",
         "label": "\"Full thing.\"",
         "tone": "reckless",
         "end": "shaved"
        },
        {
         "id": "one",
         "label": "\"Number one. I'm not a hero.\"",
         "tone": "humble",
         "end": "shaved"
        }
       ]
      }
     },
     "ends": {
