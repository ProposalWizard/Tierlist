         "label": "\"Do your own.\"",
         "tone": "fiery",
         "end": "own"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "again"
        }
       ]
      },
      "v2": {
       "who": "vet",
       "say": [
        "He crouches and digs a matchstick of mud out of the front stud with his thumbnail. \"There. That's a slip in the box in March. That's a goal.\""
       ],
       "replies": [
        {
         "id": "again",
         "label": "\"Right. Again.\"",
         "tone": "humble",
         "end": "again"
        },
        {
         "id": "own",
         "label": "\"It's one bit of mud.\"",
         "tone": "fiery",
         "end": "own"
        }
       ]
      }
     },
     "ends": {
