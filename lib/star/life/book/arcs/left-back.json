   "event": {
    "id": "arc-oop-1b-choice",
    "title": "The choice",
    "category": "manager",
    "place": "training:corridor",
    "size": "small",
    "rarity": "follow-up",
    "template": "talk-scene",
    "screen": "dial",
    "speaker": "manager",
    "trigger": {
     "when": [
      "arrive:training"
     ]
    },
    "setup": [],
    "talk": {
     "start": {
      "if": "arc.path=='yes'",
      "then": "y1",
      "else": "n1"
     },
     "nodes": {
      "y1": {
       "who": "manager",
       "screen": "dial",
       "say": [
        "\"The left back's fit. But you kept a clean sheet, and you liked it, I could tell. I've got a choice and I'm asking you first, which I never do.\""
       ],
       "replies": [
        {
         "id": "me",
         "label": "\"Play me there. I liked it.\"",
         "tone": "confident",
         "end": "keep"
        },
        {
         "id": "him",
         "label": "\"Play him. It's his shirt.\"",
         "tone": "humble",
         "end": "back"
        },
        {
         "id": "up",
         "label": "\"Up front, gaffer. Where I belong.\"",
         "tone": "calm",
         "end": "up"
        }
       ]
      },
      "n1": {
       "who": "manager",
       "screen": "dial",
       "say": [
        "\"The kid hasn't slept since the cup game. He was nineteen and he got skinned on telly. He thinks it's his fault. It isn't.\""
       ],
       "replies": [
        {
         "id": "talk",
         "label": "\"I'll talk to him.\"",
         "tone": "humble",
         "end": "talk"
        },
        {
         "id": "cold",
         "label": "\"Not my fault either, gaffer.\"",
         "tone": "fiery",
         "end": "cold"
        }
       ]
      }
     },
     "ends": {
      "keep": [
       {
        "text": "\"Left back it is.\" You play there for a month. The real left back sulks and then gets sold.",
        "effects": {
         "boss": 2
        },
        "npc": [
         {
          "slot": "manager",
          "bond": 2,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "manager",
          "tag": "wanted-to-stay-at-left-back",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "kept-lb"
         }
        }
       }
      ],
      "back": [
       {
        "text": "\"Good lad.\" The left back hears about it, and buys you a coffee for a fortnight.",
        "effects": {
         "boss": 2,
         "team": 1
        },
        "remember": [
         {
          "slot": "manager",
          "tag": "gave-the-shirt-back",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "gave-back"
         }
        }
       }
      ],
      "up": [
       {
        "text": "\"Fine.\" You score on Saturday from where you belong, which helps.",
        "arc": {
         "set": {
          "mid": "up"
         }
        }
       }
      ],
      "talk": [
       {
        "text": "You find the kid on the bike in the gym and tell him you said no first. He looks at you for a long time. \"So it was you,\" he says, and then, \"Thanks for telling me.\"",
        "effects": {
         "boss": 2
        },
        "npc": [
         {
          "slot": "manager",
          "bond": 2,
          "respect": 4
         }
        ],
        "arc": {
         "set": {
          "mid": "talked"
         }
        }
       }
      ],
      "cold": [
       {
        "text": "\"No,\" he says. \"I didn't say it was.\" He sees the kid himself.",
        "effects": {
         "boss": -2
        },
        "arc": {
         "set": {
          "mid": "cold"
         }
        }
       }
      ]
     }
    },
