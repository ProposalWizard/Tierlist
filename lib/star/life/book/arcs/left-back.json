 "ends": [
  {
   "id": "the-utility-man",
   "title": "The man who'll play anywhere",
   "text": "You played left back when he asked, and he's never forgotten it."
  },
  {
   "id": "strikers-only",
   "title": "Strikers only",
   "text": "You wouldn't play out of position, and he stopped asking."
  },
  {
   "id": "left-back-for-life",
   "title": "Left back for life",
   "text": "You filled in at left back once and stayed there. Seasons on, nobody remembers you were a striker, apart from your mum."
  }
