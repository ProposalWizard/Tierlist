    "talk": {
     "start": "a1",
     "nodes": {
      "a1": {
       "who": "manager",
       "say": [
        "\"I need a left back. You're quick, you can tackle when you're bothered, and you're left-footed enough. Will you play there?\""
       ],
       "replies": [
        {
         "id": "humble",
         "label": "\"Wherever you need me, gaffer.\"",
         "tone": "humble",
         "end": "yes-humble"
        },
        {
         "id": "calm",
         "label": "\"If it's one game, yes.\"",
         "tone": "calm",
         "end": "yes-once"
        },
        {
         "id": "confident",
         "label": "\"I'll play there and I'll still score.\"",
         "tone": "confident",
         "end": "yes-score"
        },
        {
         "id": "fiery",
         "label": "\"I'm a striker. Get a kid up from the under-23s.\"",
         "tone": "fiery",
         "end": "no"
        }
       ]
      }
     },
     "ends": {
      "yes-humble": [
       {
        "text": "You get booked after nine minutes and you keep a clean sheet. He shakes your hand in the dressing room.",
