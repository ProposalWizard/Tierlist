         "silent": true,
         "goto": "y2"
        }
       ]
      },
      "y2": {
       "who": "kid",
       "say": [
        "\"Everyone's after your shirt. I'm just the one asking.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Seven tomorrow. Don't be late.\"",
         "tone": "kind",
         "end": "yes"
        },
        {
         "id": "no",
         "label": "\"Then earn it.\"",
         "tone": "cold",
         "end": "no"
        }
       ]
      }
     },
     "ends": {
