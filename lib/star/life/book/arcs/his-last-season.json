 "beats": [
  {
   "id": "hls-1-told",
   "title": "His last season",
   "n": 1,
   "event": {
    "id": "arc-hls-1-told",
    "title": "His last season",
    "category": "teammates",
    "place": "training:corridor",
    "size": "big",
    "rarity": "common",
    "template": "talk-scene",
    "screen": "telltale",
    "speaker": "vet",
    "trigger": {
     "when": [
      "arrive:training"
     ],
     "requires": [
      "squad.any(veteran)"
     ]
    },
    "setup": [
     "{vet.name} has played four hundred games for this club. He catches you alone in the boot room and shuts the door with his foot."
    ],
    "talk": {
     "start": "v1",
     "nodes": {
      "v1": {
       "who": "vet",
       "say": [
        "\"This is my last season. I'm telling you because somebody has to know, and you won't make a fuss. I don't want a fuss. Not till I say.\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"Nobody hears it from me.\"",
         "tone": "kind",
         "end": "promise",
         "promise": "p-his-secret"
        },
        {
         "id": "sure",
         "label": "\"Are you sure? You're still the best we've got.\"",
         "tone": "honest",
         "goto": "v2"
        },
        {
         "id": "lads",
         "label": "\"The lads should know.\"",
         "tone": "honest",
         "end": "lads"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "v2"
        }
       ]
      },
      "v2": {
       "who": "vet",
       "say": [
        "\"My knees are sure. My wife's very sure.\" He laughs. \"I want to go while people still say that. Keep it quiet for me?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Course. Till you say.\"",
         "tone": "kind",
         "end": "promise",
         "promise": "p-his-secret"
        },
        {
         "id": "lads",
         "label": "\"I'll try. You should tell them.\"",
         "tone": "honest",
         "end": "lads"
        }
       ]
      }
     },
     "ends": {
      "promise": [
       {
        "text": "He nods once and goes out to train. He's the best player on the pitch, again, and only you know why he keeps looking at the stand.",
        "npc": [
         {
          "slot": "vet",
          "bond": 6,
          "respect": 4
         }
        ],
        "arc": {
         "set": {
          "path": "promised"
         }
        }
       }
      ],
      "lads": [
       {
        "text": "\"When I'm ready.\" He goes out. He's quieter with you after that, for a bit.",
        "npc": [
         {
          "slot": "vet",
          "bond": -2,
          "respect": 2
         }
        ],
        "arc": {
         "set": {
          "path": "lads"
         }
        }
       }
      ]
     }
    },
