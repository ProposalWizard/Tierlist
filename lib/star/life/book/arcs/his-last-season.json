     "After training {vet.short} goes and stands in goal on pitch one, in his gloves from twenty years ago. \"I want to beat a young lad at penalties one last time. Ten. Go on.\""
    ],
    "talk": {
     "start": "p1",
     "nodes": {
      "p1": {
       "who": "vet",
       "say": [
        "\"I played in goal for a season when I was sixteen. Nobody remembers. I do.\""
       ],
       "replies": [
        {
         "id": "go",
         "label": "\"Ten, then.\"",
         "tone": "confident",
         "goto": "play"
        },
        {
         "id": "no",
         "label": "\"I'm not putting your knees through that.\"",
         "tone": "kind",
         "end": "knees"
        }
       ]
      },
      "play": {
       "activity": {
        "mode": "challenge",
        "name": "Ten past {vet.short}",
        "intro": "Ten penalties and a few from further out. Him in goal, in gloves from twenty years ago.",
        "dials": {
         "rounds": [
          {
           "kind": "keeper",
           "balls": 3,
           "line": "\"Penalty spot. Pick a side and mean it.\""
          },
          {
           "kind": "corners",
           "balls": 2,
           "line": "\"Corners. I'll not dive for these. My knees.\""
          },
          {
           "kind": "keeper",
           "balls": 2,
           "line": "\"Two more. I've got your number now.\""
          },
          {
           "kind": "lights-out",
           "balls": 2,
           "line": "\"Lights. Let's see you in the dark.\""
          },
          {
           "kind": "double",
           "line": "\"Last one. For four hundred games.\""
          }
         ],
         "keeperSlot": "vet",
         "lines": {
          "keeper:saved": "\"Ha! Still got it. {name} still has it.\"",
          "hit": "\"Good pen.\"",
          "streak3": "\"Don't you dare.\"",
          "double:miss": "\"There it is. One last time.\""
         }
        },
        "score": "balls that count (0-10)",
        "canAbandon": true,
        "fallback": null,
        "cost": {
         "energy": -4
        },
        "caller": {
         "slot": "vet",
         "lines": [
          "\"One.\"",
          "\"Two.\"",
          "\"Three.\"",
          "\"Four.\"",
          "\"Five.\"",
          "\"Six.\"",
          "\"Seven.\"",
          "\"Eight.\"",
          "\"Nine.\"",
          "\"Ten.\""
         ]
        }
       },
       "result": [
        [
         "activity.abandoned",
         "p-stop"
        ],
        [
