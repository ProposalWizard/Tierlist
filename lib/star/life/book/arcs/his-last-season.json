      "p-good": {
       "who": "vet",
       "say": [
        "\"{activity.score}.\" He takes the gloves off and looks at them. \"You'd have scored them against me at twenty-five as well.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"Not a chance.\"",
         "tone": "kind",
         "end": "beat"
        }
       ]
      },
      "p-poor": {
       "who": "vet",
       "say": [
        "\"{activity.score}!\" He does a lap of the six-yard box with his arms up. \"One last time. Told you.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "Clap him round.",
         "tone": "kind",
         "end": "lost"
        }
       ]
      },
      "p-stop": {
       "who": "vet",
       "say": [
        "You stop. He looks almost relieved. \"Probably for the best. My knees.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"Your knees.\"",
         "tone": "calm",
         "end": "lost"
        }
       ]
      }
     },
     "ends": {
      "beat": [
       {
        "text": "He gives you the gloves. \"Don't wear them. Just have them.\"",
        "npc": [
         {
          "slot": "vet",
          "bond": 6,
          "respect": 6
         }
        ],
        "remember": [
         {
          "slot": "vet",
