     "start": "d1",
     "nodes": {
      "d1": {
       "who": "agent",
       "say": [
        "\"Twenty weeks' wages, near enough, and they'll pay your mum for her kitchen. They want real. Rows, tears, you in the bath, whatever.\""
       ],
       "replies": [
        {
         "id": "no",
         "label": "\"No. Get them off my step.\"",
         "tone": "calm",
         "end": "no"
        },
        {
