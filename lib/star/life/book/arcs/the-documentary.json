         "label": "\"Real. Fine.\"",
         "tone": "reckless",
         "goto": "d2"
        },
        {
         "id": "limits",
         "label": "\"Not my mum's house.\"",
         "tone": "honest",
         "goto": "d2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "d2"
        }
       ]
      },
      "d2": {
       "who": "mum",
       "say": [
        "You ring your mum. \"I'm not having a camera in my kitchen. Promise me. I've not done the grouting.\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"No cameras in your kitchen. Promise.\"",
         "tone": "kind",
         "end": "yes",
         "promise": "p-mums-kitchen"
        },
        {
         "id": "money",
         "label": "\"They'll pay you, Mum.\"",
         "tone": "confident",
         "end": "yes"
        }
       ]
