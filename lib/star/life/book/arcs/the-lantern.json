    "setup": [
     "{reporter.name} from the {reporter.outlet} is waiting by your car with her notebook already open. You lost, and it wasn't close."
    ],
    "talk": {
     "start": "r1",
     "nodes": {
      "r1": {
       "who": "reporter",
       "say": [
        "\"Two minutes? We go to print at nine and I've got a hole on the back page where a happy story was going to be.\""
       ],
       "replies": [
        {
         "id": "honest",
         "label": "\"We were second to everything. That's on us.\"",
         "tone": "honest",
         "goto": "r2"
        },
        {
         "id": "off",
         "label": "\"Off the record?\"",
         "tone": "calm",
         "goto": "r-off"
        },
        {
         "id": "no",
         "label": "\"Not tonight. Ask the gaffer.\"",
         "tone": "cold",
         "end": "snub"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "r-quiet"
        }
       ]
      },
      "r2": {
       "who": "reporter",
       "say": [
        "She writes it down. \"Can I use ‘second to everything’? It's the only honest thing anyone's said to me all season.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Use it.\"",
         "tone": "brave",
         "end": "quoted"
        },
        {
         "id": "soft",
         "label": "\"Make it ‘we weren't at it’. Less of a headline.\"",
         "tone": "calm",
         "end": "quoted-soft"
        }
       ]
      },
      "r-off": {
       "who": "reporter",
       "say": [
        "\"Off the record means I can't print it. I've been doing this nineteen years and I've never once broken that.\""
       ],
       "replies": [
        {
         "id": "leak",
         "label": "\"The gaffer's lost half the dressing room.\"",
         "tone": "reckless",
         "end": "told-her",
         "var": {
          "secret": 1
         }
        },
        {
         "id": "think",
         "label": "\"Then I'll keep it to myself as well.\"",
         "tone": "calm",
         "end": "quoted-soft"
        }
       ]
      },
      "r-quiet": {
       "who": "reporter",
       "say": [
        "She waits, then closes the notebook. \"I'll put ‘declined to comment’. It reads worse than you'd think.\""
       ],
       "replies": [
        {
         "id": "fine",
         "label": "\"Put that, then.\"",
         "tone": "cold",
         "end": "snub"
        },
        {
         "id": "ok",
         "label": "\"Fine. We weren't good enough.\"",
         "tone": "honest",
         "end": "quoted-soft"
        }
