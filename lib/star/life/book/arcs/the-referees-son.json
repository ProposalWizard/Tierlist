  {
   "id": "his-sons-shirt",
   "title": "His son's shirt",
   "text": "You signed a shirt for the referee's lad. He's a referee too now, and he told you so."
  },
  {
   "id": "no-shirt",
   "title": "No shirt",
   "text": "You said no to the referee. It was the right call, and his son still doesn't know why."
  }
 ],
