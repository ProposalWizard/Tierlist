    "speaker": "referee",
    "trigger": {
     "when": [
      "walkout"
     ]
    },
    "setup": [
     "{if arc.path=='signed'}There's a boy of twelve by the tunnel in your shirt with a whistle drawn on it. His sign says \"I'M A REFEREE NOW.\"{/if}",
     "{if arc.path=='no'}There's a boy of twelve by the tunnel with a sign: \"MY DAD IS THE REFEREE. SORRY.\"{/if}"
