    "setup": [
     "{referee.name} catches you in the tunnel after the game, away from the cameras. He looks embarrassed."
    ],
    "talk": {
     "start": "r1",
     "nodes": {
      "r1": {
       "who": "referee",
       "say": [
        "\"This is a bit odd. My lad's eleven and you're his favourite player. Would you sign a shirt for him? I'm not supposed to ask.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Course. Give me his name.\"",
         "tone": "kind",
         "goto": "r2"
        },
        {
         "id": "rules",
         "label": "\"Are you allowed to ask that?\"",
         "tone": "honest",
         "goto": "r-rules"
        },
        {
         "id": "no",
         "label": "\"I don't think I should.\"",
         "tone": "calm",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "r-rules"
        }
       ]
      },
      "r-rules": {
       "who": "referee",
       "say": [
        "\"No. Probably not. Forget I asked.\""
       ],
       "replies": [
        {
         "id": "sign",
         "label": "\"Bring it next time I'm not playing.\"",
         "tone": "kind",
         "end": "later"
        },
        {
         "id": "forget",
         "label": "\"Forgotten.\"",
         "tone": "calm",
         "end": "no"
        }
       ]
      },
      "r2": {
       "who": "referee",
       "say": [
        "He hands you a shirt from his bag. It's yours, your number, bought from the club shop."
       ],
       "replies": [
        {
         "id": "sign",
         "label": "Sign it, and draw a whistle on it.",
         "tone": "kind",
         "end": "signed"
        }
       ]
      }
     },
     "ends": {
      "signed": [
       {
        "text": "He puts it in his bag fast, like it's evidence.",
        "npc": [
         {
          "slot": "referee",
          "bond": 10,
          "respect": 4
         }
        ],
        "remember": [
         {
