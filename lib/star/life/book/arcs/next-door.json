       "replies": [
        {
         "id": "two",
         "label": "\"Then come, for him. And I'll keep it down.\"",
         "tone": "kind",
         "end": "made-up",
         "promise": "p-quiet"
        },
        {
         "id": "ok",
         "label": "\"Fair enough. I'll keep it down.\"",
         "tone": "calm",
         "end": "sorted",
         "promise": "p-quiet"
        }
       ]
      },
      "d2": {
       "who": "neighbour",
       "say": [
