    "talk": {
     "start": "x1",
     "nodes": {
      "x1": {
       "who": "chairman",
       "say": [
        "\"The council want a player to switch the Christmas lights on, Thursday, seven o'clock, the market square. I've told them it's you. You don't mind.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I'll do it.\"",
         "tone": "kind",
         "goto": "x2"
        },
        {
         "id": "asked",
         "label": "\"You could have asked first.\"",
         "tone": "honest",
         "goto": "x2"
        },
        {
         "id": "no",
         "label": "\"I've got a family thing Thursday.\"",
         "tone": "lie",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "x2"
        }
       ]
      },
      "x2": {
       "who": "chairman",
       "say": [
        "\"You count down from ten and press a big plastic button. Wear a hat. Last year's lad wore a hat.\""
       ],
       "replies": [
        {
         "id": "hat",
         "label": "\"I'll wear a hat.\"",
         "tone": "calm",
         "end": "did-it"
        },
        {
         "id": "song",
         "label": "\"Do I have to sing?\"",
         "tone": "confident",
         "end": "did-it"
        }
       ]
      }
     },
     "ends": {
      "did-it": [
       {
        "text": "Three thousand people in the square. You count down from ten and press the button, and nothing happens for four seconds, and then the whole street lights up and everyone screams.",
