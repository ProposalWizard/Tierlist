         "id": "me",
         "label": "\"I got released at fifteen. Did I ever tell you?\"",
         "tone": "kind",
         "goto": "x2"
        },
        {
         "id": "ok",
         "label": "\"Do what makes you happy.\"",
         "tone": "calm",
         "end": "stop"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "stop"
        }
       ]
      },
      "x2": {
       "who": "kidfan",
       "say": [
        "\"Really?\""
       ],
       "replies": [
        {
         "id": "trial",
         "label": "\"There's an open trial at a club down the road in May. Go.\"",
         "tone": "brave",
         "end": "go"
        },
        {
         "id": "rest",
         "label": "\"Really. Have a rest, then decide.\"",
         "tone": "kind",
         "end": "go"
        }
