    "setup": [
     "{canteen.name} is wiping down the hatch. There's one bowl of apple crumble on the side with a tea towel over it."
    ],
    "talk": {
     "start": "c1",
     "nodes": {
      "c1": {
       "who": "canteen",
       "say": [
        "\"That one's not for you. It's for whoever scores on Saturday. It's been under that towel five weeks, so you lot had better get on with it.\""
       ],
       "replies": [
        {
         "id": "me",
         "label": "\"Keep it warm. It's mine.\"",
         "tone": "confident",
         "goto": "c2"
        },
        {
         "id": "custard",
         "label": "\"Does it come with custard?\"",
         "tone": "calm",
         "goto": "c-custard",
         "mood": 1
        },
        {
         "id": "diet",
         "label": "\"I'm off sugar this season.\"",
         "tone": "cold",
         "end": "no-sugar"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "nodded"
        }
       ]
      },
      "c2": {
       "who": "canteen",
       "say": [
        "\"Big talk. If you score, I'll put your name on the board above the hatch. If you don't, you're on the washing up.\""
       ],
       "replies": [
        {
         "id": "deal",
         "label": "\"Deal.\"",
         "tone": "brave",
         "end": "deal"
        },
        {
         "id": "halves",
         "label": "\"Can I have half if I set one up?\"",
         "tone": "humble",
         "end": "halves"
        }
       ]
      },
      "c-custard": {
       "who": "canteen",
       "say": [
        "\"Custard is for scorers as well. Everybody thinks they're funny.\""
       ],
       "replies": [
        {
         "id": "deal",
         "label": "\"Then I'll score.\"",
         "tone": "confident",
         "end": "deal"
        },
        {
         "id": "fair",
         "label": "\"Fair enough.\"",
         "tone": "calm",
         "end": "nodded"
        }
       ]
      }
     },
     "ends": {
      "deal": [
       {
        "text": "She writes \"{you.short}?\" on a bit of tape and sticks it to the tea towel.",
        "npc": [
         {
