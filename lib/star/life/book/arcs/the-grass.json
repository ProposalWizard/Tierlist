    "setup": [
     "{groundsman.name} is sitting in the mower shed with a flask, staring at a letter. He's done the pitch at this club for twenty-six years."
    ],
    "talk": {
     "start": "g1",
     "nodes": {
      "g1": {
       "who": "groundsman",
       "say": [
        "\"{chairman.short} wants a plastic pitch. Cheaper, he says. No groundsman needed, he says. There's a fans' forum on Thursday. If one of you lot stood up and said you wanted grass…\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I'll be there Thursday.\"",
         "tone": "brave",
         "goto": "g2",
         "promise": "p-forum"
        },
        {
         "id": "ask",
         "label": "\"Is plastic that bad?\"",
         "tone": "honest",
         "goto": "g-plastic"
        },
        {
         "id": "no",
         "label": "\"I can't go against the chairman.\"",
         "tone": "calm",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "g-plastic"
        }
       ]
      },
      "g-plastic": {
       "who": "groundsman",
       "say": [
        "\"Ask your knees in ten years. Ask the lad at the club down the road who did his cruciate on one.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Right. Thursday.\"",
         "tone": "brave",
         "goto": "g2",
         "promise": "p-forum"
        },
        {
         "id": "no",
         "label": "\"I'll think about it.\"",
         "tone": "calm",
         "end": "no"
        }
       ]
      },
      "g2": {
       "who": "groundsman",
       "say": [
        "He screws the lid back on the flask. \"You don't have to make a speech. Just say grass.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"I'll say grass.\"",
         "tone": "calm",
         "end": "will"
        }
       ]
      }
     },
     "ends": {
      "will": [
       {
        "text": "He gives you a tomato from his greenhouse behind the shed, which he does not do.",
