       "say": [
        "\"You're the one who fell over in the box last time. You going to do that again today, or are you going to stand up?\""
       ],
       "replies": [
        {
         "id": "bite",
         "label": "\"Get your hands off me when I'm in the box, and I'll stay up.\"",
         "tone": "fiery",
         "goto": "t2"
        },
        {
         "id": "laugh",
         "label": "Laugh at him.",
         "tone": "confident",
         "goto": "t-laugh"
        },
        {
         "id": "hand",
         "label": "Hold your hand out to shake.",
         "tone": "calm",
         "end": "shook"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "ignored"
        }
       ]
      },
      "t2": {
       "who": "rival",
       "say": [
        "He grins. \"See you at the first corner, then.\""
       ],
       "replies": [
        {
         "id": "see",
         "label": "\"I'll be there.\"",
         "tone": "brave",
         "end": "bit"
        },
        {
         "id": "ref",
         "label": "Look at the referee and say nothing.",
         "tone": "calm",
         "end": "bit-soft"
