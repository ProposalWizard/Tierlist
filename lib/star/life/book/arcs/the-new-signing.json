     "nodes": {
      "n1": {
       "who": "manager",
       "say": [
        "The gaffer calls you in. \"I know. I know what he's like. I need a centre half till January. I'm putting him in with you on the trip. Any trouble?\""
       ],
       "replies": [
        {
         "id": "no",
         "label": "\"No trouble. I promise.\"",
         "tone": "calm",
         "end": "promised",
         "promise": "p-no-trouble"
        },
        {
         "id": "why",
         "label": "\"Why me?\"",
         "tone": "honest",
         "goto": "n2"
        },
        {
         "id": "move",
         "label": "\"Put him with someone else.\"",
         "tone": "fiery",
         "end": "refused"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "n2"
        }
       ]
      },
      "n2": {
       "who": "manager",
       "say": [
        "\"Because if you two get on, the rest will.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"Fine. No trouble.\"",
         "tone": "calm",
         "end": "promised",
         "promise": "p-no-trouble"
        },
        {
         "id": "move",
         "label": "\"Put him with someone else.\"",
         "tone": "fiery",
         "end": "refused"
        }
       ]
