       "replies": [
        {
         "id": "fine",
         "label": "\"Fine. Your call.\"",
         "tone": "calm",
         "end": "fine"
        },
        {
         "id": "mine",
         "label": "\"I won it. It was mine.\"",
         "tone": "fiery",
         "end": "mine"
        },
        {
