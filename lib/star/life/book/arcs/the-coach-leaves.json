        {
         "id": "stay",
         "label": "\"Stay. You're the best coach here.\"",
         "tone": "honest",
         "goto": "c-stay"
        },
        {
         "id": "no",
         "label": "\"Not my business, coach.\"",
         "tone": "cold",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "c-stay"
        }
       ]
      },
      "c-stay": {
       "who": "coach",
       "say": [
        "\"I'm forty-four. If I don't go now I'll be a coach until they carry me out.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Then I'll talk to him.\"",
         "tone": "brave",
         "goto": "c2",
         "promise": "p-word"
        },
        {
         "id": "no",
         "label": "\"I'd rather you stayed. Sorry.\"",
         "tone": "honest",
         "end": "no-honest"
        }
       ]
      },
      "c2": {
       "who": "coach",
       "say": [
        "\"Don't tell him I asked you. Make it sound like your idea.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"My idea.\"",
         "tone": "calm",
         "end": "will"
        }
       ]
      }
     },
