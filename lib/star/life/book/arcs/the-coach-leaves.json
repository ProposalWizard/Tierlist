     "nodes": {
      "c1": {
       "who": "coach",
       "say": [
        "\"A club two leagues down wants me as manager. {chairman.short} won't let me out of my contract. He listens to you lot. Would you put a word in?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I'll see him this week.\"",
         "tone": "kind",
         "goto": "c2",
         "promise": "p-word"
