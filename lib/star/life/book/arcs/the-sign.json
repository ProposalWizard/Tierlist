    ],
    "talk": {
     "start": "g1",
     "nodes": {
      "g1": {
       "who": "kidfan",
       "say": [
        "{if arc.path=='gave'}\"You won't remember. You gave me this on my birthday. I play centre mid for the under-sixteens now.\"{/if}",
        "{if arc.path=='waved'}\"You waved at my sign once. I told everyone at school you'd waved at me.\"{/if}",
        "{if arc.path=='walked'}\"I had a sign once. You walked past it. I'm not being funny, I just always wanted to tell you.\"{/if}"
       ],
       "replies": [
        {
         "id": "remember",
         "label": "\"I remember. Happy birthday, a few years late.\"",
         "tone": "kind",
         "end": "end-warm"
        },
        {
         "id": "sorry",
         "label": "\"I'm sorry. Have this one.\" Hand her your shirt.",
         "tone": "honest",
         "end": "end-sorry"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "end-quiet"
        }
       ]
