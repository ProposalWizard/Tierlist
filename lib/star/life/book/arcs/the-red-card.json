    "talk": {
     "start": "t1",
     "nodes": {
      "t1": {
       "who": "manager",
       "say": [
        "\"He won't listen to me today. He might listen to you. Go and find him.\""
       ],
       "replies": [
        {
         "id": "humble",
         "label": "\"I'll try, gaffer.\"",
         "tone": "humble",
         "goto": "t2"
        },
        {
         "id": "confident",
         "label": "\"Leave him with me.\"",
         "tone": "confident",
         "goto": "t2"
        },
        {
         "id": "fiery",
         "label": "\"He cost us the game. He can sort himself out.\"",
         "tone": "fiery",
         "end": "refused"
        },
        {
         "id": "quiet",
         "label": "… Say nothing",
         "silent": true,
         "goto": "t2"
        }
       ]
      },
      "t2": {
       "who": "kid",
       "say": [
        "He's in the gym on a bike, going nowhere very fast. He takes one earphone out."
       ],
       "replies": [
        {
         "id": "story",
         "label": "\"I got sent off on my debut. Nobody remembers.\"",
         "tone": "honest",
         "end": "story"
        },
        {
         "id": "tough",
         "label": "\"It was a red. Learn from it and stop sulking.\"",
         "tone": "brave",
         "end": "tough"
        },
        {
         "id": "sit",
         "label": "Get on the bike next to him and say nothing.",
         "tone": "calm",
         "end": "sat"
        }
       ]
      }
     },
     "ends": {
      "story": [
       {
        "text": "He stops pedalling. \"Was it a bad one?\" \"Worse than yours.\" He laughs for the first time since Saturday.",
