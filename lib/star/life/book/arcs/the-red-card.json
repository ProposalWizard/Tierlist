         "label": "Ring him.",
         "tone": "kind",
         "end": "rang"
        },
        {
         "id": "club",
         "label": "\"Get the club's people on it.\"",
         "tone": "calm",
         "end": "club"
        }
       ]
      }
     },
     "ends": {
      "rang": [
       {
        "text": "You talk till one. Mostly about nothing, a film, his mum's dog. He sends you a screenshot the next day: the app, deleted. The club's safeguarding officer rings him on Monday.",
