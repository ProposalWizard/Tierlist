    "setup": [
     "{mate.name}'s partner had a baby girl at four this morning. {capt.name} is going round the dressing room with a brown envelope for a pram."
    ],
    "talk": {
     "start": "w1",
     "nodes": {
      "w1": {
       "who": "capt",
       "say": [
        "He holds the envelope open in front of you. \"Pram, car seat, the lot. Everyone's putting in what they can.\""
       ],
       "replies": [
        {
         "id": "big",
         "label": "Put in a week's wage.",
         "tone": "kind",
         "goto": "w-big",
         "cost": {
          "moneyWeeks": 1
         }
        },
        {
         "id": "normal",
         "label": "Put in what the others are putting in.",
         "tone": "calm",
         "end": "normal"
        },
        {
         "id": "card",
         "label": "\"I'll get her something myself.\"",
         "tone": "honest",
         "end": "own-gift"
        },
        {
         "id": "quiet",
         "label": "Pat your pockets. \"Haven't got cash on me.\"",
         "silent": true,
         "end": "skipped"
        }
       ]
      },
      "w-big": {
       "who": "capt",
       "say": [
        "He looks in the envelope, then at you. \"That's too much, son.\""
       ],
       "replies": [
        {
         "id": "keep",
         "label": "\"It's not. She's his first.\"",
         "tone": "kind",
         "end": "big"
        },
        {
         "id": "take",
         "label": "\"Give half back, then.\"",
         "tone": "humble",
         "end": "normal"
        }
       ]
      }
     },
     "ends": {
      "big": [
       {
        "text": "The pram they buy is better than the one the gaffer's daughter had. {mate.short} finds out who put in most within a day.",
