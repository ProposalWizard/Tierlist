     ]
    },
    "setup": [
     "Away trip. {vet.name} sits down next to you on the coach, which he never does. Three rows back, {lad.name} is on his own with his headphones in."
    ],
    "talk": {
     "start": "v1",
     "nodes": {
      "v1": {
       "who": "vet",
       "say": [
        "\"Nobody's spoken to that lad since he signed. He eats on his own. Room with him tonight, will you? I'd do it, but I snore and he's frightened of me.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Course. I'll swap with whoever.\"",
         "tone": "kind",
         "goto": "v2"
        },
        {
         "id": "why",
         "label": "\"Why's it my job?\"",
         "tone": "honest",
         "goto": "v-why"
        },
        {
         "id": "no",
         "label": "\"I like my own room.\"",
         "tone": "cold",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "v-why"
        }
       ]
      },
      "v-why": {
       "who": "vet",
       "say": [
        "\"It isn't. That's why I'm asking. When I signed here nobody spoke to me for a month, and I nearly went home.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"All right. Tonight.\"",
         "tone": "humble",
         "goto": "v2"
        },
        {
         "id": "no",
         "label": "\"Get one of the young lads to do it.\"",
         "tone": "calm",
         "end": "no"
        }
       ]
      },
      "v2": {
       "who": "vet",
       "say": [
        "\"Don't make a thing of it. Just ask him which side of the room he wants.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"Which side of the room. Got it.\"",
         "tone": "calm",
         "end": "roomed"
        }
       ]
      }
     },
     "ends": {
      "roomed": [
       {
        "text": "{lad.short} wants the side by the window. You watch a quiz show together and he gets every football question right.",
        "npc": [
         {
          "slot": "lad",
          "bond": 10,
          "respect": 4
         },
         {
          "slot": "vet",
          "bond": 4,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "roomed-with-me-when-nobody-would",
          "strength": 3
         },
         {
          "slot": "vet",
          "tag": "did-what-i-asked",
          "strength": 1
         }
        ],
        "arc": {
         "set": {
          "path": "roomed"
         }
        }
       }
      ],
      "no": [
       {
        "text": "{vet.short} rooms with him himself, and snores. {lad.short} looks wrecked at breakfast.",
        "npc": [
         {
          "slot": "vet",
          "bond": -2,
          "respect": -2
         },
         {
          "slot": "lad",
          "bond": -1
         }
        ],
        "arc": {
         "set": {
          "path": "no"
         }
        }
       }
      ]
     }
    },
