    "trigger": {
     "when": [
      "arrive:training"
     ],
     "requires": [
      "squad.any(age<=19)"
     ]
    },
    "setup": [
     "You go into the boot room for your trainers. {lad.name} is sitting on the floor under the pegs with his boots in his lap. He's been told this morning he isn't getting a contract."
    ],
    "talk": {
     "start": "b1",
     "nodes": {
      "b1": {
       "who": "lad",
       "say": [
        "He wipes his face quickly. \"Sorry. I'll go. I just didn't want to go out there yet.\""
       ],
       "replies": [
        {
         "id": "sit",
         "label": "Sit down on the floor next to him.",
         "tone": "kind",
         "goto": "b2"
        },
        {
         "id": "truth",
         "label": "\"It happens to most of us. It nearly happened to me.\"",
         "tone": "honest",
         "goto": "b2"
        },
        {
         "id": "go",
         "label": "Get your trainers and go.",
         "tone": "cold",
         "end": "walked"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "b2"
        }
       ]
      },
      "b2": {
       "who": "lad",
       "say": [
        "\"I've been here since I was nine. I don't know how to do anything else.\""
       ],
       "replies": [
        {
         "id": "number",
         "label": "\"Here's my number. Ring me when you get a trial.\"",
         "tone": "kind",
         "end": "number"
        },
        {
         "id": "other",
         "label": "\"Then learn. There's more to football than this club.\"",
         "tone": "honest",
         "end": "straight"
        },
        {
         "id": "dream",
         "label": "\"You'll be back here one day, in another shirt.\"",
         "tone": "confident",
         "end": "hope"
        }
       ]
      }
     },
     "ends": {
      "number": [
       {
        "text": "He puts your number in his phone with his hands shaking. He doesn't ring for a month, then he rings twice in one night.",
        "npc": [
         {
          "slot": "lad",
          "bond": 14,
          "respect": 6
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "gave-me-his-number-when-i-was-released",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "path": "kind"
         }
        }
       }
      ],
      "straight": [
       {
        "text": "He nods for a long time. \"Nobody's said that. They all said I'll be fine.\"",
        "npc": [
         {
          "slot": "lad",
          "bond": 8,
          "respect": 8
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "told-me-straight-when-i-was-released",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "path": "kind"
         }
        }
       }
      ],
      "hope": [
       {
        "text": "He laughs, which is something. He leaves with his boots over his shoulder.",
        "npc": [
         {
          "slot": "lad",
          "bond": 6,
          "respect": 2
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "said-id-be-back",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "hope"
         }
        }
       }
      ],
      "walked": [
       {
        "text": "When you come back past, the boot room is empty and his boots are in the bin.",
        "npc": [
         {
          "slot": "lad",
          "bond": -6
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "walked-past-me-in-the-boot-room",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "walked"
         }
        }
       }
      ]
     }
    },
    "choices": [],
