  {
   "id": "rel-2-years",
   "title": "A message",
   "after": {
    "beat": "rel-1-bootroom",
    "seasons": [
     2,
     5
    ]
   },
   "n": 2,
   "event": {
    "id": "arc-rel-2-years",
    "title": "A message",
    "category": "teammates",
    "place": "home",
    "size": "small",
    "rarity": "callback",
    "template": "text-thread",
    "screen": "card",
    "speaker": "lad",
    "trigger": {
     "when": [
      "home:evening"
     ]
    },
    "setup": [
     "A long message from a name you half remember.",
     "{if !arc.path=='walked'}\"It's me from the boot room. I'm a physio now, at a club two leagues down. I tell every lad who gets released what you told me. Thought you should know.\"{/if}",
     "{if arc.path=='walked'}\"You won't remember me. Boot room, the day I got released. I'm a coach now. I make a point of sitting down with the ones who get let go.\"{/if}",
     "{if arc.deep=='go'}The call you made for him is the first thing he says.{/if}",
     "{if arc.deep=='hard'}He brings up the day he collected his boots.{/if}"
    ],
    "choices": [
     {
      "id": "reply",
      "label": "Write back properly.",
      "tone": "kind",
      "outcomes": [
       {
        "if": "!arc.path=='walked'",
        "text": "He replies with a photo of his lads. You recognise the look on one of their faces.",
        "npc": [
         {
          "slot": "lad",
          "bond": 6,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "lad",
          "tag": "wrote-back-years-later",
          "strength": 3
         }
        ],
        "arc": {
         "end": "he-found-his-way"
        }
       },
       {
        "text": "You write back that you're sorry. He says it's fine, and tells you about his under-18s.",
        "npc": [
         {
          "slot": "lad",
          "bond": 4,
          "respect": 2
         }
        ],
        "arc": {
         "end": "one-more-kid"
        }
       }
      ]
     },
     {
      "id": "like",
      "label": "Like it and put the phone down.",
      "tone": "calm",
      "outcomes": [
       {
        "if": "!arc.path=='walked'",
        "text": "He sees it. That's enough for him, he says, a week later.",
        "npc": [
         {
          "slot": "lad",
          "bond": 2
         }
        ],
        "arc": {
         "end": "he-found-his-way"
        }
       },
       {
        "text": "A like. He doesn't write again.",
        "npc": [
         {
          "slot": "lad",
          "bond": 2
         }
        ],
        "arc": {
         "end": "one-more-kid"
        }
       }
      ]
     }
    ],
