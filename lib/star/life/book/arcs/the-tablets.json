     ]
    },
    "setup": [
     "A season on. The testers turn up at seven in the morning with their boxes. {physio.short} reads out the names. Yours is third. {mate.short}'s is fifth."
    ],
    "choices": [
     {
      "id": "go",
      "label": "Give your sample.",
      "tone": "calm",
      "outcomes": [
       {
        "if": "arc.path=='clean'",
