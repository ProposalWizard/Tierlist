          "tag": "failed-the-test",
          "strength": 3
         }
        ],
        "arc": {
         "end": "the-letter-from-testing"
        }
       }
      ]
     },
     {
      "id": "tell",
      "label": "Tell {physio.short} about the brown bottle first.",
      "tone": "honest",
      "outcomes": [
       {
        "if": "arc.path=='clean'",
