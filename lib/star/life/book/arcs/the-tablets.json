     ]
    },
    "setup": [
     "Your hamstring has been tight for a fortnight. {mate.name} closes the boot room door behind you. He's got a little brown bottle with no label in his hand."
    ],
    "talk": {
     "start": "t1",
     "nodes": {
      "t1": {
       "who": "mate",
       "say": [
        "\"For the hamstring. My cousin gets them. A week quicker, I swear. Nobody tests for them in the season.\""
       ],
       "replies": [
        {
         "id": "no",
         "label": "\"No chance.\"",
         "tone": "brave",
         "end": "no"
        },
        {
         "id": "what",
         "label": "\"What's in them?\"",
         "tone": "honest",
         "goto": "t2"
        },
        {
         "id": "physio",
         "label": "\"I'll ask {physio.short} about them.\"",
         "tone": "calm",
         "end": "physio"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "t2"
        }
       ]
      },
      "t2": {
       "who": "mate",
       "say": [
        "\"Does it matter? I've had them twice. Look at me.\" He's flexing."
       ],
       "replies": [
        {
         "id": "take",
         "label": "Take the bottle.",
         "tone": "reckless",
         "end": "took"
        },
        {
         "id": "no",
         "label": "\"I'll do it the slow way.\"",
         "tone": "brave",
         "end": "no"
        }
       ]
      }
     },
     "ends": {
      "no": [
       {
        "text": "He shrugs and puts them in his washbag. \"Your loss.\"",
        "npc": [
         {
          "slot": "mate",
          "bond": -2,
          "respect": 2
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "turned-down-the-tablets",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "clean"
         }
        }
       }
      ],
      "physio": [
       {
        "text": "\"Don't do that.\" He takes the bottle back. You don't ask her. You don't take them either.",
        "npc": [
         {
          "slot": "mate",
          "bond": -4,
          "grudge": 4
         }
        ],
        "remember": [
         {
          "slot": "mate",
          "tag": "threatened-to-tell-the-physio",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "clean"
         }
        }
       }
      ],
      "took": [
       {
        "text": "You take two that night. You're back a week early, like he said. The bottle stays in your washbag, behind the toothpaste.",
        "effects": {
         "matchFitness": 6,
         "scandal": true
        },
        "npc": [
         {
          "slot": "mate",
          "bond": 6,
          "respect": -2
         }
