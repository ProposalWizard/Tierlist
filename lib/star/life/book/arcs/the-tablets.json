     ]
    },
    "setup": [
     "The academy is doing its talk on drugs and testing for the under-18s. They want a first-team player to stand up at the front of a classroom for ten minutes. {physio.short} has put your name forward."
    ],
    "choices": [
     {
      "id": "talk",
      "label": "Do the talk.",
      "tone": "brave",
      "outcomes": [
       {
        "if": "arc.mid=='binned'",
        "text": "You tell them about a brown bottle with no label and a team-mate on crutches for twelve weeks. Thirty sixteen-year-olds go completely quiet. One stays behind to ask a question he's clearly been carrying for a while.",
        "effects": {
         "reputation": 3
        },
        "npc": [
