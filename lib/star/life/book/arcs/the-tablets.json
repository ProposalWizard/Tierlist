         "label": "\"Nothing.\"",
         "tone": "lie",
         "end": "lied"
        }
       ]
      }
     },
     "ends": {
      "binned": [
       {
        "text": "He tips the bottle into the bin in the boot room while you watch. \"Happy?\" Not really. He does it anyway.",
