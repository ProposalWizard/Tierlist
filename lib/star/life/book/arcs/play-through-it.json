    "talk": {
     "start": "p1",
     "nodes": {
      "p1": {
       "who": "physio",
       "say": [
        "\"That's tight. Not torn, but tight. I'm telling the gaffer you're a doubt for Saturday.\""
       ],
       "replies": [
        {
         "id": "ask",
         "label": "\"Don't. Sign me fit. I'll be careful.\"",
         "tone": "reckless",
         "goto": "p2"
        },
        {
         "id": "truth",
         "label": "\"It's been tight for a week, if I'm honest.\"",
         "tone": "honest",
         "goto": "p-truth"
        },
        {
         "id": "gaffer",
         "label": "\"I'll tell him myself that I'm fine.\"",
         "tone": "confident",
         "end": "over-her-head"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "p2"
        }
       ]
      },
      "p2": {
       "who": "physio",
       "say": [
        "She stops pressing. \"If I sign you and it goes, it's my name on the form. Do you understand that?\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I understand. I'll tell you the second it pulls.\"",
         "tone": "honest",
         "goto": "p3",
         "promise": "p-tell-her"
        },
        {
         "id": "leave",
         "label": "\"Forget I asked.\"",
         "tone": "calm",
         "end": "rested"
        }
       ]
      },
      "p3": {
       "who": "physio",
       "say": [
        "\"The second it pulls, you put your hand up and you come off. You don't wait for half-time.\""
       ],
       "replies": [
        {
         "id": "deal",
         "label": "\"Deal.\"",
         "tone": "calm",
         "end": "signed"
        },
        {
         "id": "joke",
         "label": "\"You'll be the first to know, after me.\"",
         "tone": "confident",
         "end": "signed"
        }
       ]
      },
      "p-truth": {
       "who": "physio",
       "say": [
        "\"A week.\" She writes it down. \"Then you're having Saturday off, and I'm going to tell him why.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"Fair enough.\"",
         "tone": "humble",
         "end": "rested"
        },
        {
