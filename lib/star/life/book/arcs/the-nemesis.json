        {
         "id": "next",
         "label": "\"Next time.\"",
         "tone": "calm",
         "end": "next"
        },
        {
         "id": "laugh",
         "label": "\"Write them down. I'll frame it.\"",
         "tone": "confident",
         "end": "laugh"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "next"
        }
       ]
      }
     },
     "ends": {
