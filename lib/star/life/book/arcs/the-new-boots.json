{
 "id": "arc-the-new-boots",
 "title": "The new boots",
 "owner": "sponsor",
 "summary": "Your boot sponsor's rep brings you this season's boots, and they give you blisters by Tuesday. Wear them, or paint your old ones to look like them. A photo after a match decides it. A season on, the contract's up.",
 "size": "medium",
