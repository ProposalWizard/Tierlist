     "nodes": {
      "a": {
       "who": "chairman",
       "say": [
        "The microphone. \"Before we unveil it...\" He looks at you. You've got about ten seconds."
       ],
       "replies": [
        {
         "id": "unveil",
         "label": "Let him pull the sheet.",
         "tone": "humble",
         "end": "unveil"
