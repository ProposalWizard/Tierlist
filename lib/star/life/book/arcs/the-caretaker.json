    "setup": [
     "The gaffer had his appendix out on Sunday night. {coach.name} is in charge for the next two games. He's wearing the gaffer's coat because he forgot his own."
    ],
    "talk": {
     "start": "t1",
     "nodes": {
      "t1": {
       "who": "coach",
       "say": [
        "\"The senior lads think I'm keeping his seat warm. I am. But I need two results. Tomorrow at the meeting, if I change the shape, will you say something? They listen to you.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I'll say something.\"",
         "tone": "brave",
         "goto": "t2",
         "promise": "p-back-the-coach"
        },
        {
         "id": "shape",
         "label": "\"What are you changing?\"",
         "tone": "honest",
         "goto": "t3"
        },
        {
         "id": "no",
         "label": "\"Keep me out of it.\"",
         "tone": "calm",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "t3"
        }
       ]
      },
      "t3": {
       "who": "coach",
       "say": [
        "\"Three at the back. The gaffer hates it. I've wanted to try it for four years.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Fine. I'll back you.\"",
         "tone": "brave",
         "goto": "t2",
         "promise": "p-back-the-coach"
        },
        {
         "id": "no",
         "label": "\"I'm not getting involved.\"",
         "tone": "calm",
         "end": "no"
        }
       ]
      },
      "t2": {
       "who": "coach",
       "say": [
        "\"Don't make a speech. Just say you're up for it.\""
       ],
       "replies": [
        {
         "id": "ok",
         "label": "\"I won't make a speech.\"",
         "tone": "calm",
         "end": "promised"
        }
       ]
      }
     },
