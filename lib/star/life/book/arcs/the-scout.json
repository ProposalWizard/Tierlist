    "setup": [
     "A season on. The man in the blue coat is at your club now, as head of recruitment. He nods at you in the corridor.",
     "{if arc.path=='simple'}He says your name before you say his.{/if}"
    ],
    "choices": [
     {
      "id": "ask",
      "label": "Ask what he wrote that night.",
      "tone": "honest",
      "outcomes": [
       {
        "if": "arc.path=='simple'",
