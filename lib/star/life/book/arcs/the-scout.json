        "npc": [
         {
          "slot": "coach",
          "bond": 4
         }
        ],
        "arc": {
         "end": "played-my-game"
        }
       },
       {
        "text": "\"Rabona. Lost it. Rabona. Lost it.\" He laughs. \"Then the goal. I nearly wrote you down.\"",
        "npc": [
         {
          "slot": "coach",
          "bond": 1
         }
        ],
        "arc": {
         "end": "showed-off"
        }
       }
      ]
     },
     {
      "id": "nod",
      "label": "Nod and keep walking.",
      "tone": "calm",
      "outcomes": [
       {
        "if": "arc.path=='simple'",
        "text": "He nods back. {coach.short} tells you later he's the reason you got the contract.",
        "npc": [
         {
          "slot": "coach",
          "bond": 4
         }
        ],
        "arc": {
         "end": "played-my-game"
        }
       },
       {
        "text": "He nods back. He's got a different notebook now.",
        "arc": {
         "end": "showed-off"
        }
       }
      ]
     }
