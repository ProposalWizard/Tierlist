    "setup": [
     "Under-18s, Wednesday night, a crowd of forty. {coach.name} leans in during the warm-up. \"Man in the blue coat, middle of the stand. He's not here for their lot.\""
    ],
    "talk": {
     "start": "s1",
     "nodes": {
      "s1": {
       "who": "coach",
       "say": [
        "\"Play your game. Pass it simple, run hard, go home. Don't do anything you wouldn't do on a Tuesday.\""
       ],
       "replies": [
        {
         "id": "simple",
         "label": "\"Simple. Got it.\"",
         "tone": "calm",
         "end": "simple"
        },
        {
         "id": "show",
         "label": "\"I'm going to show him something.\"",
         "tone": "reckless",
         "end": "show"
        },
        {
         "id": "who",
         "label": "\"Which club?\"",
         "tone": "honest",
         "goto": "s2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "simple"
        }
       ]
      },
      "s2": {
       "who": "coach",
       "say": [
        "\"Doesn't matter. Play like he's not there.\""
       ],
       "replies": [
        {
         "id": "simple",
         "label": "\"Okay.\"",
         "tone": "calm",
         "end": "simple"
        },
        {
         "id": "show",
         "label": "\"He's there, though.\"",
         "tone": "reckless",
         "end": "show"
        }
       ]
      }
     },
     "ends": {
      "simple": [
       {
        "text": "You play simple. Sixty passes, one goal from four yards. The man in the blue coat leaves at seventy minutes.",
        "npc": [
         {
          "slot": "coach",
          "respect": 6,
          "bond": 4
         }
        ],
        "remember": [
         {
          "slot": "coach",
          "tag": "played-it-simple-for-the-scout",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "simple"
         }
        }
       }
      ],
      "show": [
       {
        "text": "You try a rabona in the first minute and lose the ball. You try it again in the second half and it works, and nobody's watching because they're scoring.",
        "npc": [
         {
          "slot": "coach",
          "respect": -2
         }
        ],
        "arc": {
         "set": {
          "path": "show"
         }
        }
       }
      ]
     }
