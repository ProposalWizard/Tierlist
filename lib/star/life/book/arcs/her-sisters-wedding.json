     "nodes": {
      "p1": {
       "who": "partner",
       "say": [
        "\"My sister's set the date. It's a Saturday in March. I've already checked, and you're at home that day.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I'll be there. I'll talk to the gaffer.\"",
         "tone": "kind",
         "goto": "p2",
         "promise": "p-wedding"
        },
        {
         "id": "try",
         "label": "\"I'll try. You know what he's like.\"",
         "tone": "honest",
         "goto": "p-try"
        },
        {
         "id": "no",
         "label": "\"I can't miss a game for a wedding.\"",
         "tone": "cold",
         "end": "no"
