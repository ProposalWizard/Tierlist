      "p2": {
       "who": "partner",
       "say": [
        "\"You promise? Because she's already done the seating plan and you're on the top table.\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"I promise.\"",
         "tone": "honest",
         "end": "promised"
        }
       ]
      },
      "p-try": {
       "who": "partner",
       "say": [
        "\"Try means no. Everyone in my family knows that's what try means.\""
       ],
       "replies": [
        {
         "id": "promise",
         "label": "\"Then I'll be there.\"",
         "tone": "brave",
         "end": "promised",
         "promise": "p-wedding"
        },
        {
         "id": "evening",
         "label": "\"I'll come to the evening do, straight after the game.\"",
         "tone": "calm",
         "end": "evening"
        }
       ]
      }
     },
