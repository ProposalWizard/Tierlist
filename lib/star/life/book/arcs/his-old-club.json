    "setup": [
     "{mate.name} played six seasons for the side you play on Saturday. He's quiet while he does his boots up."
    ],
    "talk": {
     "start": "o1",
     "nodes": {
      "o1": {
       "who": "mate",
       "say": [
        "\"Do us a favour. If you score Saturday, don't go to their end. I've got mates in there. My dad's mates. It's not like that for me.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"I won't. I'll come and find you.\"",
         "tone": "kind",
         "end": "agreed"
        },
        {
         "id": "ask",
         "label": "\"Would you celebrate, if it was you?\"",
         "tone": "honest",
         "goto": "o2"
        },
        {
         "id": "no",
         "label": "\"If I score, I'm going wherever I want.\"",
         "tone": "fiery",
         "end": "refused"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "shrugged"
        }
       ]
      },
      "o2": {
       "who": "mate",
       "say": [
        "\"No. That's sort of the point. You don't do it to people who sang your name.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Fair enough. I won't.\"",
         "tone": "humble",
         "end": "agreed"
        },
        {
         "id": "no",
         "label": "\"They never sang mine.\"",
         "tone": "cold",
         "end": "refused"
        }
       ]
      }
     },
     "ends": {
      "agreed": [
       {
        "text": "He nods. You score with ten minutes left, and you jog back to the halfway line with your arm up. He's the first one to reach you.",
