 "ends": [
  {
   "id": "respect-in-the-away-end",
   "title": "Respect",
   "text": "You kept your word in front of his old fans. He bought you dinner and told the story at every club he went to."
  },
  {
   "id": "the-knee-slide",
   "title": "The knee slide",
   "text": "You went to the away end. He laughed in the end, but his old fans never did."
  },
  {
   "id": "a-share-in-it",
   "title": "A share in it",
   "text": "You bought shares in a team-mate's old club when it was going under. Your name is on the wall by their turnstiles now, between a butcher and a vicar."
  }
 ],
 "promises": {},
