   "event": {
    "id": "arc-msh-1-ask",
    "title": "Candid",
    "category": "sponsor",
    "place": "home",
    "size": "small",
    "rarity": "common",
    "template": "phone-call",
    "screen": "telltale",
    "speaker": "sponsor",
    "trigger": {
     "when": [
      "home:evening"
     ]
    },
    "setup": [
     "{sponsor.name} from {sponsor.outlet} rings with an idea. She's very excited about it."
    ],
    "talk": {
     "start": "s1",
     "nodes": {
      "s1": {
       "who": "sponsor",
       "say": [
        "\"A candid shoot at your mum's. In her kitchen. You, the new boots, a cup of tea, your mum in the background. Real. People love real.\""
       ],
       "replies": [
        {
         "id": "yes",
         "label": "\"Mum would love that.\"",
         "tone": "kind",
         "end": "yes"
        },
        {
         "id": "ask",
         "label": "\"I'll have to ask her.\"",
         "tone": "honest",
         "goto": "s2"
        },
        {
         "id": "no",
         "label": "\"Leave my mum out of it.\"",
         "tone": "cold",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "s2"
        }
       ]
      },
      "s2": {
       "who": "sponsor",
       "say": [
        "\"Ask her. Though I've already asked her. She said yes and she's bought a new kettle.\""
       ],
       "replies": [
        {
         "id": "fine",
         "label": "\"Then I suppose we're doing it.\"",
         "tone": "calm",
         "end": "yes"
        },
        {
         "id": "no",
         "label": "\"Then she can take the kettle back.\"",
         "tone": "cold",
         "end": "no"
        }
       ]
      }
     },
     "ends": {
      "yes": [
       {
        "text": "The shoot takes nine hours. Mum makes the photographer a bacon sandwich every hour, and appears in every shot.",
        "npc": [
         {
          "slot": "sponsor",
          "bond": 6,
          "respect": 2
         },
         {
          "slot": "mum",
          "bond": 8,
          "respect": 2
         }
        ],
        "remember": [
         {
          "slot": "mum",
          "tag": "let-them-shoot-in-my-kitchen",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "path": "kitchen"
         }
        }
       }
      ],
      "no": [
       {
        "text": "They shoot it in a studio with a fake kitchen. Mum takes the kettle back.",
        "npc": [
         {
          "slot": "sponsor",
          "bond": -2
         },
         {
          "slot": "mum",
          "bond": -4
         }
        ],
