 "ends": [
  {
   "id": "mums-kitchen",
   "title": "Mum's kitchen",
   "text": "You let them shoot in your mum's kitchen. She's on a billboard now, and she's never been happier."
  },
  {
   "id": "the-studio",
   "title": "The studio",
   "text": "You kept your mum out of it. The ad was in a studio, and you looked bored in it."
  },
  {
   "id": "her-own-advert",
   "title": "Her own advert",
   "text": "Your mum got an advert of her own, the washing line one. She did your renewal for you and got more than your agent ever has."
  }
