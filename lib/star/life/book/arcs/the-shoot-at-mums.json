   "event": {
    "id": "arc-msh-1b-mum",
    "title": "Mum rings",
    "category": "sponsor",
    "place": "home:sofa",
    "size": "small",
    "rarity": "follow-up",
    "template": "phone-call",
    "screen": "telltale",
    "speaker": "mum",
    "trigger": {
     "when": [
      "home:evening"
     ]
    },
    "setup": [],
    "talk": {
     "start": {
      "if": "arc.path=='kitchen'",
      "then": "k1",
      "else": "s1"
     },
     "nodes": {
      "k1": {
       "who": "mum",
       "say": [
        "\"They want me on my own now. Me and a washing line, for a kit wash advert. They'll pay me. Is that daft? Tell me if it's daft.\""
       ],
       "replies": [
        {
         "id": "go",
         "label": "\"Do it, Mum. You've earned it.\"",
         "tone": "kind",
         "end": "go"
        },
        {
         "id": "read",
         "label": "\"Send me the contract first.\"",
         "tone": "calm",
         "end": "read"
        },
        {
         "id": "no",
         "label": "\"I'd rather you didn't.\"",
         "tone": "cold",
         "end": "no"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "read"
        }
       ]
      },
      "s1": {
       "who": "mum",
       "say": [
        "\"I've seen the studio ones. That's not a kitchen. Nobody's kettle is that clean.\" A pause. \"I'm not cross. I'm asking why.\""
       ],
       "replies": [
        {
         "id": "protect",
         "label": "\"I didn't want people knowing where you live.\"",
         "tone": "honest",
         "end": "protect"
        },
        {
         "id": "job",
         "label": "\"It's my job, Mum. Not yours.\"",
         "tone": "cold",
         "end": "job"
        },
        {
         "id": "next",
         "label": "\"Next time. I promise.\"",
         "tone": "kind",
         "end": "next"
        }
       ]
      }
     },
     "ends": {
      "go": [
       {
        "text": "She does the washing line in one take and makes the director a bacon sandwich. She rings you after to say she's \"a professional now\".",
        "npc": [
         {
          "slot": "mum",
          "bond": 6,
          "respect": 2
         }
        ],
        "remember": [
         {
          "slot": "mum",
          "tag": "said-go-on-to-the-advert",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "mum-ad"
         }
        }
       }
      ],
      "read": [
       {
        "text": "You read it on the coach. It's fine. It pays her more per day than your first contract did.",
        "npc": [
         {
          "slot": "mum",
          "bond": 3,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "mum",
          "tag": "read-my-contract",
          "strength": 1
         }
        ],
        "arc": {
         "set": {
          "mid": "read"
         }
        }
       }
      ],
      "no": [
       {
        "text": "\"Right.\" She says it the way she said it when you were twelve and wanted a motorbike.",
        "npc": [
         {
          "slot": "mum",
          "bond": -4,
          "grudge": 2
         }
        ],
        "remember": [
         {
          "slot": "mum",
          "tag": "told-me-not-to-do-the-advert",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "no"
         }
        }
       }
      ],
      "protect": [
       {
        "text": "She goes quiet. \"That's a nice reason. A daft one, but a nice one.\"",
        "npc": [
         {
          "slot": "mum",
          "bond": 5,
          "respect": 2
         }
        ],
        "remember": [
         {
          "slot": "mum",
          "tag": "kept-me-out-to-protect-me",
          "strength": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "protect"
         }
        }
       }
      ],
      "job": [
       {
        "text": "\"Right you are.\" She takes the new kettle back as well.",
        "npc": [
         {
          "slot": "mum",
          "bond": -4,
          "grudge": 3
         }
        ],
        "arc": {
         "set": {
          "mid": "cold"
         }
        }
       }
      ],
      "next": [
       {
        "text": "\"I'll hold you to that.\" She will. She has a list of every next time you've ever said.",
        "npc": [
         {
          "slot": "mum",
          "bond": 2
         }
        ],
        "arc": {
         "set": {
          "mid": "next"
         }
        }
       }
      ]
     }
