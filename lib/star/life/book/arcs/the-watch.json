    "setup": [
     "{vet.name} has emptied his bag onto the bench twice. His watch is gone, the one his wife bought him when they won the league. You came in early this morning, and so did {kid.short}."
    ],
    "talk": {
     "start": "w1",
     "nodes": {
      "w1": {
       "who": "vet",
       "say": [
        "\"You were in first. Did you see anyone near my peg?\""
       ],
       "replies": [
        {
         "id": "kid",
         "label": "\"{kid.short} was in here before me.\"",
         "tone": "honest",
         "goto": "w-kid"
        },
        {
         "id": "nobody",
         "label": "\"Nobody. I was in the gym.\"",
         "tone": "lie",
         "end": "covered"
        },
        {
         "id": "check",
         "label": "\"Have you looked in your car?\"",
         "tone": "calm",
         "goto": "w2"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "w2"
        }
       ]
      },
      "w2": {
       "who": "vet",
       "say": [
        "\"I've looked in my car. I've looked in the bin. Somebody in this room has it.\" He's looking at the youngest lad."
       ],
       "replies": [
        {
         "id": "kid",
         "label": "\"He was in here before me, but that doesn't mean anything.\"",
         "tone": "honest",
         "goto": "w-kid"
        },
        {
         "id": "defend",
         "label": "\"Leave the kid alone. You don't know it was anyone.\"",
         "tone": "brave",
         "end": "defended"
        },
        {
         "id": "out",
         "label": "Get changed and stay out of it.",
         "tone": "cold",
         "end": "stayed-out"
        }
       ]
      },
      "w-kid": {
       "who": "vet",
       "say": [
        "He's across the room before you've finished. {kid.short} goes red and says he was only getting his shin pads."
       ],
       "replies": [
        {
         "id": "stop",
         "label": "\"Hang on. I said he was here. I didn't say he took it.\"",
         "tone": "brave",
         "end": "told-then-stopped"
        },
        {
         "id": "watch",
         "label": "Watch.",
         "tone": "cold",
         "end": "told"
        }
       ]
      }
     },
     "ends": {
      "covered": [
       {
        "text": "Nobody finds the watch. {vet.short} goes to the gaffer, and the gaffer says he'll have the cameras checked.",
        "npc": [
