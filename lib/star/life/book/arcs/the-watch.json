   "n": 2,
   "event": {
    "id": "arc-wat-2-confess",
    "title": "In the car park",
    "category": "teammates",
    "place": "compound:car-park",
    "size": "medium",
    "rarity": "common",
    "template": "talk-scene",
    "screen": "telltale",
    "speaker": "kid",
    "trigger": {
     "when": [
      "arrive:training",
      "after-match"
     ]
    },
    "setup": [
     "{kid.name} is waiting by your car. He's been crying, or he's been not sleeping, or both."
    ],
    "talk": {
     "start": "c1",
     "nodes": {
      "c1": {
       "who": "kid",
       "say": [
        "{if arc.said=='told'}\"You were right, it was me. I sold it. I owe a lad money from the betting app, and he said he'd come to my mum's.\"{/if}",
        "{if !arc.said=='told'}\"It was me. I sold it to a man on the market. I owe a lad money from the betting app, and he said he'd come to my mum's.\"{/if}"
       ],
       "replies": [
        {
         "id": "help",
         "label": "\"How much? We'll get it back.\"",
         "tone": "kind",
         "goto": "c2"
        },
        {
         "id": "gaffer",
         "label": "\"You're going to tell the gaffer. Now.\"",
         "tone": "brave",
         "goto": "c-gaffer"
        },
        {
         "id": "walk",
         "label": "\"That's your problem.\"",
         "tone": "cold",
         "end": "walked"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "goto": "c2"
        }
       ]
      },
      "c2": {
       "who": "kid",
       "say": [
        "\"Four hundred to get it back off the market man. The rest I'll sort. I swear I'll stop. Please don't tell {vet.short}.\""
       ],
       "replies": [
        {
         "id": "pay",
         "label": "Lend him the money and get the watch back.",
         "tone": "kind",
         "end": "paid",
         "cost": {
          "moneyWeeks": 1
         }
        },
        {
         "id": "both",
         "label": "\"I'll lend it. You put it back and delete the app in front of me.\"",
         "tone": "honest",
         "end": "paid-strict",
         "cost": {
          "moneyWeeks": 1
         }
        },
        {
         "id": "no",
         "label": "\"I'm not paying for this. Tell the gaffer.\"",
         "tone": "cold",
         "end": "gaffer"
        }
       ]
      },
      "c-gaffer": {
       "who": "kid",
       "say": [
        "\"He'll sack me. My contract's up in May.\""
       ],
       "replies": [
        {
         "id": "go",
         "label": "\"I'll come in with you.\"",
         "tone": "brave",
         "end": "gaffer-with-him"
        },
        {
         "id": "alone",
         "label": "\"Then you should've thought of that.\"",
         "tone": "cold",
         "end": "gaffer"
        }
       ]
      }
     },
     "ends": {
      "paid": [
       {
        "text": "The watch is back on {vet.short}'s peg by Friday. He thinks he dropped it in the car after all.",
        "npc": [
         {
          "slot": "kid",
          "bond": 14,
          "respect": 6
         }
        ],
        "remember": [
         {
          "slot": "kid",
          "tag": "got-him-out-of-the-watch",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "helped": 1
         }
        }
       }
      ],
      "paid-strict": [
       {
        "text": "He deletes it in front of you. His hands are shaking. The watch is back on the peg by Friday.",
        "npc": [
         {
          "slot": "kid",
          "bond": 12,
          "respect": 10
         }
        ],
        "remember": [
         {
          "slot": "kid",
          "tag": "got-him-out-of-the-watch",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "helped": 2
         }
        }
       }
      ],
      "gaffer-with-him": [
       {
        "text": "You sit outside the office for an hour. The gaffer fines him two weeks and gets the club's welfare officer in. He keeps his contract.",
        "effects": {
         "boss": 4,
         "team": 2
        },
        "npc": [
         {
          "slot": "kid",
          "bond": 10,
          "respect": 8
         },
         {
          "slot": "manager",
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "kid",
          "tag": "went-in-with-him",
          "strength": 3
         }
        ],
        "arc": {
         "set": {
          "helped": 3
         }
        }
       }
      ],
      "gaffer": [
       {
        "text": "He goes in on his own. He's not at training the next day, or the day after.",
        "effects": {
         "boss": 2,
         "team": -3
        },
        "npc": [
         {
          "slot": "kid",
