   "n": 3,
   "event": {
    "id": "arc-wat-3-truth",
    "title": "The camera in the corridor",
    "category": "teammates",
    "place": "compound:changing-room",
    "size": "medium",
    "rarity": "common",
    "template": "talk-scene",
    "screen": "telltale",
    "speaker": "vet",
    "trigger": {
     "when": [
      "arrive:training"
     ]
    },
    "setup": [
     "The club finally fixed the camera in the corridor. Somebody went back through last season's recordings for a laugh, and now {vet.name} knows exactly who was at his peg that morning."
    ],
    "talk": {
     "start": "t1",
     "nodes": {
      "t1": {
       "who": "vet",
       "say": [
        "{if arc.helped>=1}\"The kid took it, and it came back. I'm not thick. Somebody paid for that.\" He looks at you. \"Was it you?\"{/if}",
        "{if arc.helped==0}\"The kid took my watch. And I'm hearing you knew.\"{/if}"
       ],
       "replies": [
        {
         "id": "own",
         "label": "\"It was me. He was in trouble. He's out of it now.\"",
         "tone": "honest",
         "goto": "t2"
        },
        {
         "id": "lie",
         "label": "\"No idea what you're on about.\"",
         "tone": "lie",
         "end": "denied"
        },
        {
         "id": "kid",
         "label": "\"Ask him, not me.\"",
         "tone": "cold",
         "end": "passed-it-on"
        }
       ]
      },
      "t2": {
       "who": "vet",
       "say": [
        "He looks at the watch on his wrist for a long time. \"He could have asked me. I'd have lent it him.\""
       ],
       "replies": [
        {
         "id": "tell",
         "label": "\"He was eighteen and frightened. He didn't think anyone would.\"",
         "tone": "kind",
         "end": "vet-softens"
        },
        {
         "id": "drop",
         "label": "\"Then let it go.\"",
         "tone": "calm",
         "end": "vet-softens"
        }
       ]
      }
     },
     "ends": {
      "vet-softens": [
       {
        "if": "arc.helped>=1",
        "text": "{vet.short} takes the kid for a drink that Friday. Nobody else in the squad hears about it.",
        "effects": {
         "team": 5
        },
        "npc": [
         {
          "slot": "vet",
          "bond": 8,
          "respect": 8
         },
         {
          "slot": "kid",
          "bond": 6,
          "respect": 4
         }
        ],
        "remember": [
         {
          "slot": "vet",
          "tag": "covered-for-the-kid",
          "strength": 3
         }
        ],
        "arc": {
         "end": "second-chance"
        }
       },
       {
        "text": "{vet.short} nods, but the story's already round the room.",
        "effects": {
         "team": -2
        },
        "npc": [
         {
          "slot": "vet",
          "bond": 2,
          "respect": 4
         }
        ],
        "arc": {
         "end": "the-dressing-room-knows"
        }
       }
      ],
      "denied": [
       {
        "text": "He finds out the rest from the kid that afternoon. He doesn't speak to you again that season.",
        "effects": {
         "team": -4
        },
        "npc": [
         {
          "slot": "vet",
          "bond": -10,
          "respect": -8,
          "grudge": 12
         }
        ],
        "remember": [
         {
          "slot": "vet",
          "tag": "lied-to-him-about-the-watch",
          "strength": 3
         }
        ],
        "arc": {
         "end": "the-dressing-room-knows"
        }
       }
      ],
      "passed-it-on": [
       {
        "text": "He does ask him, in front of everyone. It's worse than the first time.",
        "effects": {
         "team": -5
        },
        "npc": [
         {
          "slot": "vet",
          "bond": -4,
          "respect": -4,
          "grudge": 4
         },
         {
          "slot": "kid",
          "bond": -8,
          "grudge": 8
         }
        ],
        "arc": {
