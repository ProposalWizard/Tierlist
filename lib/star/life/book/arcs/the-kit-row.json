     "start": "c1",
     "nodes": {
      "c1": {
       "who": "capt",
       "say": [
        "{capt.name} has a copy of the new shirt. Across the front: QUIDNOW. \"Payday loans. Twelve hundred per cent. The fans are going mad. Launch photo's Thursday. What are we doing?\""
       ],
       "replies": [
        {
         "id": "photo",
         "label": "\"We do the photo. It's the club's call.\"",
         "tone": "calm",
         "end": "photo"
        },
        {
         "id": "speak",
         "label": "\"I'll do it, but I'll say what I think.\"",
         "tone": "brave",
         "end": "speak"
        },
        {
         "id": "refuse",
         "label": "\"I'm not wearing it for the photo.\"",
         "tone": "fiery",
         "end": "refuse"
        },
        {
         "id": "quiet",
         "label": "Say nothing.",
         "silent": true,
         "end": "photo"
        }
       ]
      }
     },
     "ends": {
      "photo": [
       {
        "text": "{capt.short} nods. \"Fair. It's not our name on the cheque.\"",
        "arc": {
         "set": {
          "path": "photo"
         }
        }
       }
      ],
      "speak": [
       {
        "text": "\"Good. Me too.\" He writes your name on a list in his phone.",
        "npc": [
         {
          "slot": "capt",
          "bond": 4,
          "respect": 4
         }
        ],
        "arc": {
         "set": {
          "path": "speak"
         }
        }
       }
      ],
      "refuse": [
       {
        "text": "\"The chairman will love that.\" He doesn't say don't.",
        "npc": [
         {
          "slot": "capt",
          "bond": 2,
          "respect": 4
         }
        ],
        "remember": [
         {
