# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy these from your Supabase project → Settings → API

# Your project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────────────
# Used by the sign-out redirect (defaults to localhost:3000 if unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API-Football (api-football.com) ───────────────────────────────────────────
# Sign up at api-football.com, get your key from the dashboard
# Used by /admin/football data browser
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io
