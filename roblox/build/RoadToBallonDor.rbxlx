		end
		local sum = Js.O({ carry = 0, drift = 0, driftEnd = 0, apex = 0, bounce = 0, roll = 0, total = 0, tStop = 0 }, { "carry", "drift", "driftEnd", "apex", "bounce", "roll", "total", "tStop" })
		for i = 0, math.ceil(n) - 1 do
