	framingV2Camera = function(sc, hw, tiltDeg)
		if tiltDeg == nil then tiltDeg = 0 end
		if (((if sc.facing ~= nil then sc.facing else "up") ~= "up") or (not M_canvasEngine.goalInView(sc.kind))) then
