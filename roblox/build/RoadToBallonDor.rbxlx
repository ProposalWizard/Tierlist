			do return nil end
		end
		do return Math.max(wageFloorFor(club, division), seasonToWeekly(finalSeasonPrice, division)) end
	end
	exports.agreedWeeklyWage = agreedWeeklyWage
	TRIALIST_STRENGTH_FLOOR = 42
