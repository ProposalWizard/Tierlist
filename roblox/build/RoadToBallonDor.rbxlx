		local r = (Js.parseInt(S.slice(m, 0, 2), 16) / 255)
		local g = (Js.parseInt(S.slice(m, 2, 4), 16) / 255)
		local b = (Js.parseInt(S.slice(m, 4, 6), 16) / 255)
