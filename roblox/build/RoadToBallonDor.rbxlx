				return Js.O({ text = (k.can.name .. ": " .. k.label), sub = (money(k.price) .. " · you have " .. Js.numstr(k.owned)), tone = (if (c.money < k.price) then "dim" else "normal"), action = "buy-can", arg = k.can.id }, { "text", "sub", "tone", "action", "arg" })
			end) }, { "kind", "items" }))
			A.push(s.buttons, back)
