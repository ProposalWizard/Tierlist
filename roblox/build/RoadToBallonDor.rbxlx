	end
	exports.applyLevelResult = applyLevelResult
	TRAINING_LEVELS = 30
	exports.TRAINING_LEVELS = TRAINING_LEVELS
	SKILL_START = 40
	exports.SKILL_START = SKILL_START
	SKILL_MAX = 100
