	local CLUB_WIN_CHANTS = Js.ospread(Js.O({ ["Hull City"] = Js.alit("Mauled by the Tigers"), Arsenal = Js.alit("North London Forever"), Chelsea = Js.alit("Chelsea! Chelsea! Chelsea!"), Liverpool = Js.alit("Allez, Allez, Allez"), ["Manchester United"] = Js.alit("Glory Glory Man United"), ["Tottenham Hotspur"] = Js.alit("Come on you Spurs!", "Oh when the Spurs go marching in"), ["West Ham United"] = Js.alit("I'm Forever Blowing Bubbles"), ["Fulham FC"] = Js.alit("Come on you Whites!") }, { "Hull City", "Arsenal", "Chelsea", "Liverpool", "Manchester United", "Tottenham Hotspur", "West Ham United", "Fulham FC" }), Js.Object.fromEntries(A.map(A.filter(Js.Object.values(M_clubProfiles.CLUB_PROFILES), function(p)
		return p.winChant
	end), function(p)
		return Js.alit(p.club, Js.alit(p.winChant))
	end)))
	exports.CLUB_WIN_CHANTS = CLUB_WIN_CHANTS
	local CLUB_SCORELINE_CHANTS = Js.O({ Arsenal = Js.O({ ["1-0"] = Js.alit("One-Nil to the Arsenal") }, { "1-0" }) }, { "Arsenal" })
	exports.CLUB_SCORELINE_CHANTS = CLUB_SCORELINE_CHANTS
	local CLUB_DRAW_LOSS_CHANTS = Js.O({ Liverpool = Js.alit("You'll Never Walk Alone") }, { "Liverpool" })
	exports.CLUB_DRAW_LOSS_CHANTS = CLUB_DRAW_LOSS_CHANTS
	local PLAYER_GOAL_CHANTS = Js.O({ ["Jude Bellingham"] = Js.alit("Hey Jude!"), ["Mohamed Salah"] = Js.alit("Mo Salah! Mo Salah! Running Down the Wing!"), ["Cole Palmer"] = Js.alit("Cold Palmer 🥶"), ["Bukayo Saka"] = Js.alit("Starboy", "oi saks blud"), ["Jean-Philippe Mateta"] = Js.alit("BOOM BOOM BOOM BOOM"), ["Cristiano Ronaldo"] = Js.alit("Siuuu", "SIUUUUUUUU!!!", "Penaldo 👀", "GOAT", "🐐", "And Then Ronaldo!", "Obrigado", "Cristiano Ronaldo dos Santos Aveiro", "Still Washed", "messi better", "¿Dónde está CR7?"), ["Bruno Fernandes"] = Js.alit("He Comes From Sporting Like Cristiano"), ["Kai Havertz"] = Js.alit("60 MILLION DOWN THE DRAIN"), ["Bryan Mbeumo"] = Js.alit("Shake your bum bum for me and my crew"), ["Declan Rice"] = Js.alit("Rice Rice Baby!"), ["Leon Goretzka"] = Js.alit("GORETZKAAAAAAA!"), Kevin = Js.alit("Moffi's eating good tonight"), ["Marcus Rashford"] = Js.alit("And he's smashed it in!"), ["Amadou Onana"] = Js.alit("Andre at it again"), ["Anthony Elanga"] = Js.alit("Ryhthm is a dancer ANTHONY ELANGA scoring goals from everywhere"), ["Sam Smith"] = Js.alit("Smith up the table, he's putting smith up the table", "I wanna be in that template", "Sam-oh, Sam-oh, Sam-oh", "Samuel is a Smither, Whelan is a Wither", "Smithing the templates, Smithing the templates", "Wheeling Smithers in your Sam Smith house", "Sam Smith on the wing, Sam Sam Smith Smith on the wing", "Mr Burns said he had no chance", "50 templates down the drain!", "he goes by the name of Sam Smitty, Sam Smitty, he goes by the name of Sam Smitty", "he's smithing up the templates and he's doing it so right"), ["Kylian Mbappe"] = Js.alit("Ballon d'or"), ["Lamine Yamal"] = Js.alit("Classique"), ["Bradley Barcola"] = Js.alit("Fonsu Que"), ["Paul Pogba"] = Js.alit("pog", "Dont miss on Pog that's a 2x prem winner"), Vinicius = Js.alit("Chini"), ["Aaron Wan-Bissaka"] = Js.alit("Spider Wan"), ["Lionel Messi"] = Js.alit("Pessi", "GOAT", "🐐", "MESSI MESSI MESSI", "Just give him another ballon dor", "Classic Leo Messi"), ["Morgan Rogers"] = Js.alit("Cold Rogers"), ["João Pedro"] = Js.alit("JP Morgan"), ["Brian Brobbey"] = Js.alit("Stiff Bucku strikes again"), ["Dominic Calvert-Lewin"] = Js.alit("DCL"), ["Romelu Lukaku"] = Js.alit("Dont miss on Big Rom that's a 2x prem winner") }, { "Jude Bellingham", "Mohamed Salah", "Cole Palmer", "Bukayo Saka", "Jean-Philippe Mateta", "Cristiano Ronaldo", "Bruno Fernandes", "Kai Havertz", "Bryan Mbeumo", "Declan Rice", "Leon Goretzka", "Kevin", "Marcus Rashford", "Amadou Onana", "Anthony Elanga", "Sam Smith", "Kylian Mbappe", "Lamine Yamal", "Bradley Barcola", "Paul Pogba", "Vinicius", "Aaron Wan-Bissaka", "Lionel Messi", "Morgan Rogers", "João Pedro", "Brian Brobbey", "Dominic Calvert-Lewin", "Romelu Lukaku" })
	exports.PLAYER_GOAL_CHANTS = PLAYER_GOAL_CHANTS
