				local filled = Js.aspread(best, A.fill(Js.Array.new((11 - Js.alen(best))), exp))
				local avg = (A.reduce(filled, function(s, x)
					return Js.add(s, x)
				end, 0) / 11)
				local adj = Math.max(-8, Math.min(8, ((avg - exp) / 0.533)))
