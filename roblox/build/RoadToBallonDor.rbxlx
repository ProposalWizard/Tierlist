			if (line ~= nil) then
				local onside = function(p)
					if isOffside(p, line, sc.ball.y) then
						p.y = (line + 0.3)
					end
				end
				if sc.runner then
					onside(sc.runner.pos)
				end
				do
					local _arr10 = sc.secondaryRunners
					local _i11 = 0
					while _i11 < Js.alen(_arr10) do
						_i11 += 1
