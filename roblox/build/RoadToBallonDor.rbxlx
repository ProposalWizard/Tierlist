	end
	exports.kibCanEffectLabel = kibCanEffectLabel
	kibCanPrice = function(can, weeklyWage)
		local wage = Math.max(M_economy.WAGE_FLOOR, (if Js.T(weeklyWage) then weeklyWage else 0))
