		if ((knuckles and (r < KNUCKLE_R)) and (power >= KNUCKLE_MIN_POWER)) then
			do return Js.O({ grade = "knuckle", power = 1.04, spread = 1, label = "KNUCKLEBALL" }, { "grade", "power", "spread", "label" }) end
		end
