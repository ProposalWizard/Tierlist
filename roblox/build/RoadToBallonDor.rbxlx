Js.alit("title-race", "went-top", "lost-top"), requires = Js.alit("left", "position"), body = "With {left} matches remaining, {club} sit {position|ordinal}. Title races are not won in {week|ordinal} weeks, but they are certainly lost in them.", weight = 2 }, { "id", "archetype", "events", "requires", "body", "weight" }), Js.O({ id = "bs-relegation", archetype = "broadsheet", events = Js.alit("relegation-fight", "into-the-drop"), requires = Js.alit("left"), body = "{club} have {left} matches to find the points that keep them up. On current form, that is not a comfortable arithmetic." }, { "id", "archetype", "events", "requires", "body" }), Js.O({ id = "bs-manager", archetype = "broadsheet", tags = Js.alit("manager"), requires = Js.alit("manager"), body = "{manager} leaves {club} after a run that made the decision, in the end, straightforward for a board that rarely finds anything straightforward." }, { "id", "archetype", "tags", "requires", "body" }), Js.O({ id = "bs-transfer", archetype = "broadsheet", tags = Js.alit("transfer"), requires = Js.alit("to"), body = "{player} completes a move to {to}. Whether {to} have bought the player of the last six months or the player of the last six years is the question the fee does not answer." }, { "id", "archetype", "tags", "requires", "body" }), Js.O({ id = "bs-champions", archetype = "broadsheet", events = Js.alit("champions", "trophy"), body = "{club} are champions. It has been a season of small margins and one very large one, and the table is the only argument that matters now.", weight = 3 }, { "id", "archetype", "events", "body", "weight" }), Js.O({ id = "bs-form", archetype = "broadsheet", events = Js.alit("in-form", "out-of-form"), requires = Js.alit("average"), body = "{player} is averaging {average} across his last {matches}. Form is temporary, as the cliché has it — the interesting question is which of these is the temporary one." }, { "id", "archetype", "events", "requires", "body" }), Js.O({ id = "bs-generic", archetype = "broadsheet", body = "{club} {score} {opponent}. A result that says less about either side than the table will suggest by Monday.", weight = 0.5 }, { "id", "archetype", "body", "weight" }), Js.O({ id = "tb-hall-record", archetype = "tabloid", events = Js.alit("hall-record"), subject = "you", requires = Js.alit("short", "holderShort"), body = "HISTORY! {short} SMASHES {holderShort}'S RECORD", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "tb-hattrick", archetype = "tabloid", events = Js.alit("hat-trick", "four-goals", "five-goals"), requires = Js.alit("goals", "short"), body = "{short|caps} {goals|caps}!", graphic = "breaking", weight = 4 }, { "id", "archetype", "events", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-late", archetype = "tabloid", events = Js.alit("late-winner"), requires = Js.alit("short", "minute"), body = "{short|caps} SINKS THEM AT {minute}!", graphic = "breaking", weight = 4 }, { "id", "archetype", "events", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-screamer", archetype = "tabloid", events = Js.alit("screamer"), requires = Js.alit("short", "distance"), body = "{distance} YARDS! {short|caps} WITH A ROCKET", graphic = "breaking", weight = 3 }, { "id", "archetype", "events", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-goal", archetype = "tabloid", tags = Js.alit("goal"), subject = "you", requires = Js.alit("short"), frames = Js.alit("hype"), body = "{short|caps} DOES IT AGAIN", threadBody = "{thread.goals} IN {thread.matches}. {short|caps} IS UNSTOPPABLE", weight = 2 }, { "id", "archetype", "tags", "subject", "requires", "frames", "body", "threadBody", "weight" }), Js.O({ id = "tb-derby", archetype = "tabloid", events = Js.alit("derby-win"), requires = Js.alit("short"), excludes = Js.alit("derbyName"), body = "THE CITY IS THEIRS! {club|caps} DO THE DERBY", graphic = "breaking", weight = 3 }, { "id", "archetype", "events", "requires", "excludes", "body", "graphic", "weight" }), Js.O({ id = "tb-derby-named", archetype = "tabloid", events = Js.alit("derby-win"), requires = Js.alit("short", "derbyName"), body = "{club|caps} OWN THE {derbyName|caps}!", graphic = "breaking", weight = 3 }, { "id", "archetype", "events", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-derby-loss", archetype = "tabloid", events = Js.alit("derby-loss"), frames = Js.alit("mock"), excludes = Js.alit("derbyName"), body = "DERBY DAY MISERY FOR {club|caps}", weight = 2 }, { "id", "archetype", "events", "frames", "excludes", "body", "weight" }), Js.O({ id = "tb-derby-loss-named", archetype = "tabloid", events = Js.alit("derby-loss"), frames = Js.alit("mock"), requires = Js.alit("derbyName"), body = "{derbyName|caps} HUMILIATION FOR {club|caps}", weight = 2 }, { "id", "archetype", "events", "frames", "requires", "body", "weight" }), Js.O({ id = "tb-shame", archetype = "tabloid", tags = Js.alit("shame"), frames = Js.alit("mock"), requires = Js.alit("margin"), body = "{margin}-GOAL HUMILIATION. WHERE DOES {club|caps} GO FROM HERE?", graphic = "breaking", weight = 2 }, { "id", "archetype", "tags", "frames", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-collapse", archetype = "tabloid", events = Js.alit("collapse"), requires = Js.alit("lead"), body = "BOTTLED IT! {lead} UP AND THEY STILL LOST", graphic = "breaking" }, { "id", "archetype", "events", "requires", "body", "graphic" }), Js.O({ id = "tb-crisis", archetype = "tabloid", events = Js.alit("losing-run", "drought"), requires = Js.alit("matches"), body = "CRISIS: {matches} AND COUNTING", weight = 2 }, { "id", "archetype", "events", "requires", "body", "weight" }), Js.O({ id = "tb-manager", archetype = "tabloid", tags = Js.alit("manager"), requires = Js.alit("manager"), body = "AXED! {manager|caps} GOES", graphic = "breaking", weight = 3 }, { "id", "archetype", "tags", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-transfer", archetype = "tabloid", tags = Js.alit("transfer", "rumour"), requires = Js.alit("to"), body = "DONE DEAL! {short|caps} TO {to|caps}", graphic = "transfer", weight = 3 }, { "id", "archetype", "tags", "requires", "body", "graphic", "weight" }), Js.O({ id = "tb-trophy", archetype = "tabloid", events = Js.alit("trophy", "champions"), body = "{club|caps} ARE CHAMPIONS!", graphic = "trophy", weight = 4 }, { "id", "archetype", "events", "body", "graphic", "weight" }), Js.O({ id = "tb-relegated", archetype = "tabloid", events = Js.alit("relegated"), body = "DOWN. {club|caps} ARE RELEGATED", graphic = "breaking", weight = 4 }, { "id", "archetype", "events", "body", "graphic", "weight" }), Js.O({ id = "tb-generic", archetype = "tabloid", body = "{club|caps} {us}-{them} {opponent|caps}", weight = 0.5 }, { "id", "archetype", "body", "weight" }))
