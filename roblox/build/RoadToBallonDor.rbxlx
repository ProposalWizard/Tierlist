	exports.realPlayers = realPlayers
	xiAdjustments = function(career)
		local by = Js.Map.new()
		do
			local _arr9 = realPlayers(career)
			local _i10 = 0
			while _i10 < Js.alen(_arr9) do
				_i10 += 1
				local p = _arr9[_i10]
				local xs = (by:get(p.nation) or Js.alit())
