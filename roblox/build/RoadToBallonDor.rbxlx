), subject = "you", body = "{player} lost heavily at a casino this week, according to people who were there. {club} will want a word.", weight = 2 }, { "id", "archetype", "events", "subject", "body", "weight" }), Js.O({ id = "bs-casino-expose", archetype = "broadsheet", events = Js.alit("casino-expose"), subject = "you", body = "This is no longer one night out. {player}'s visits to the casino have become a pattern, and {club} have fined him.", weight = 3 }, { "id", "archetype", "events", "subject", "body", "weight" }), Js.O({ id = "bs-casino-ban", archetype = "broadsheet", events = Js.alit("casino-ban"), subject = "you", body = "{club} have banned {player} from the casino for eight weeks. A club does not step in like this lightly.", weight = 3 }, { "id", "archetype", "events", "subject", "body", "weight" }), Js.O({ id = "fan-casino-spotted", archetype = "fan", events = Js.alit("casino-spotted", "casino-won"), subject = "you", requires = Js.alit("short"), body = "{short} at the casino again? just focus on saturday mate", weight = 2 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "fan-casino-lost", archetype = "fan", events = Js.alit("casino-lost", "casino-expose"), subject = "you", requires = Js.alit("short"), body = "not a good look {short}. sort it out", weight = 2 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "fan-casino-ban", archetype = "fan", events = Js.alit("casino-ban"), subject = "you", requires = Js.alit("short"), body = "the club had to ban him. embarrassing. hope {short} gets help", weight = 2 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "rival-casino", archetype = "rivalFan", events = Js.alit("casino-spotted", "casino-lost", "casino-won", "casino-expose", "casino-ban"), subject = "you", requires = Js.alit("short"), body = "{short} betting on red while {club} are in the red 😂", weight = 2 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }))
	exports.CASINO_TEMPLATES = CASINO_TEMPLATES
