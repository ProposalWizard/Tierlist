	proOffBall = function(sc, st, ball, dt)
		local P = KEEPER_PRO_BRAIN
		local k = sc.keeper
		local g = proG(st.ab.rating)
		if st.claimGo then
			local live = (((not (not k.claim)) and (not ball.loose)) and (ball.lastTouch == "attack"))
			if (not live) then
				st.claimGo = nil
				k.claim = nil
