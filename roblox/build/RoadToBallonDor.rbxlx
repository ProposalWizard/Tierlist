			end
		end
		if (sc.kind == "one_on_one") then
			local ballY = sc.ball.y
			A.forEach(sc.defenders, function(d, i)
				if (d.y < ballY) then
					local spread = (math.fmod(((math.abs(d.x) * 7) + (i * 13)), 100) / 100)
					d.y = ((ballY + 1) + (spread * 2.5))
					local side = (if (d.x >= sc.ball.x) then 1 else -1)
