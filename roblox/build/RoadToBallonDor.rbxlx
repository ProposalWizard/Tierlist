		end
		local onGlass = function(sx, sy, m)
			return (if t then M_cameraTilt.visibleOnScreen(t, sx, sy, m) else ((((sx >= 0) and (sx <= 1)) and (sy >= 0)) and (sy <= 1)))
		end
