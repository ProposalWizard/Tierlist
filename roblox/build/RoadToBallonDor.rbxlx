				if (mode == "new") then
					M_ballPhysics.integrateBallReal(ball, cond, dt)
				else
					M_canvasEngine.integrateBallOld(ball, cond, dt)
				end
				if (not landed) then
					apex = Math.max(apex, ball.z)
					if ((ball.z <= 0) and (t > 0.02)) then
