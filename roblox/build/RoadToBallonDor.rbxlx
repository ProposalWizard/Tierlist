})

-- the buttons, pinned at the bottom
local BUTTON_H = 52
local buttonBar = make("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = C.panel,
	BackgroundTransparency = 0.05,
	BorderSizePixel = 0,
	Parent = column,
}, {
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 18) }),
})

-- a full-screen chooser (house rule: a chooser's list is a full page)
local chooser = make("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.panel,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 20,
	Parent = gui,
})

local busyCover = make("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.55,
	Text = "…",
	TextSize = 40,
	Font = TITLE_FONT,
	TextColor3 = C.gold,
	Visible = false,
	ZIndex = 30,
	Parent = gui,
})

-- ─────────────────────────────────────────────────────────────── drawing ──
local form = {} -- what's been typed and picked on this screen
local current -- the screen on show
local send -- forward

local function clear(frame)
	for _, ch in ipairs(frame:GetChildren()) do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and not ch:IsA("UISizeConstraint") then
			ch:Destroy()
		end
	end
end

local function button(b, order, parent)
	local style = b.style or "secondary"
	local bg = style == "primary" and C.primary or style == "danger" and C.danger or C.secondary
	local fg = style == "primary" and C.primaryText or C.text
	local btn = make("TextButton", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, BUTTON_H),
		BackgroundColor3 = bg,
		BorderSizePixel = 0,
		AutoButtonColor = true, -- press feedback on the button itself
		Text = string.upper(b.label or ""),
		TextSize = 22,
		Font = TITLE_FONT,
		TextColor3 = fg,
		Parent = parent,
	})
	rounded(btn, 14)
	outline(btn, C.outline, 3)
	shine(btn)
	textOutline(btn)
	btn.Activated:Connect(function()
		send(b.action, b.arg)
	end)
	return btn
end

local function panel(order)
	local p = make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Parent = page,
	}, { pad(12), make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	rounded(p, 12)
	outline(p, Color3.new(1, 1, 1), 1.5).Transparency = 0.8
	return p
end

local function openChooser(block, onPick)
	clear(chooser)
	chooser.Visible = true
	local top = make("Frame", { Size = UDim2.new(1, 0, 0, 56 + topSafe), BackgroundColor3 = C.panel2, BorderSizePixel = 0, ZIndex = 21, Parent = chooser })
	label(string.upper(block.label), 22, C.text, TITLE_FONT, { Position = UDim2.new(0, 16, 0, topSafe + 12), Size = UDim2.new(1, -80, 0, 30), AutomaticSize = Enum.AutomaticSize.None, ZIndex = 22, Parent = top })
	local close = make("TextButton", {
		Position = UDim2.new(1, -56, 0, topSafe + 6),
		Size = UDim2.new(0, 44, 0, 44),
		BackgroundTransparency = 1,
		Text = "✕",
		TextSize = 26,
		Font = BODY_BOLD,
		TextColor3 = C.text,
		ZIndex = 22,
		Parent = top,
	})
	close.Activated:Connect(function()
		chooser.Visible = false
	end)
	local search = make("TextBox", {
		Position = UDim2.new(0, 12, 0, 62 + topSafe),
		Size = UDim2.new(1, -24, 0, 40),
		BackgroundColor3 = C.field,
		BorderSizePixel = 0,
		PlaceholderText = "Search",
		Text = "",
		TextSize = 16,
		Font = BODY_FONT,
		TextColor3 = C.text,
		PlaceholderColor3 = C.dim,
		ClearTextOnFocus = false,
		ZIndex = 22,
		Parent = chooser,
	}, { pad(8) })
	local list = make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 110 + topSafe),
		Size = UDim2.new(1, 0, 1, -(110 + topSafe)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ZIndex = 21,
		Parent = chooser,
	}, { make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }), make("UISizeConstraint", { MaxSize = Vector2.new(MAX_WIDTH, math.huge) }) })
	local function fill(filter)
		clear(list)
		local f = string.lower(filter or "")
		for i, opt in ipairs(block.options) do
			if f == "" or string.find(string.lower(opt), f, 1, true) then
				local row = make("TextButton", {
					LayoutOrder = i,
					Size = UDim2.new(1, 0, 0, 48),
					BackgroundColor3 = opt == block.value and C.field or C.panel,
					BorderSizePixel = 0,
					Text = "   " .. opt .. (opt == block.value and "  ✓" or ""),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextSize = 17,
					Font = BODY_FONT,
					TextColor3 = C.text,
					ZIndex = 22,
					Parent = list,
				})
				row.Activated:Connect(function()
					chooser.Visible = false
					onPick(opt)
				end)
			end
		end
	end
	fill("")
	search:GetPropertyChangedSignal("Text"):Connect(function()
		fill(search.Text)
	end)
end

local drawBlock -- forward

local function drawScreen(s)
	current = s
	form = {}
	-- HUD
	if s.hud then
		hud.Visible = true
		hudName.Text = s.hud.name
		hudClub.Text = (s.hud.club ~= "" and (s.hud.club .. " · " .. s.hud.league) or "") .. " · " .. s.hud.season
		hudMoney.Text = s.hud.money
		hudStars.Text = "★ " .. tostring(s.hud.stars)
		local e = math.clamp((s.hud.energy or 0) / 100, 0, 1)
		energyFill.Size = UDim2.new(e, 0, 1, 0)
		local col = e < 0.35 and C.bad or e < 0.6 and C.gold or C.good
		energyFill.BackgroundColor3 = col
		energyFill:FindFirstChildOfClass("UIStroke").Color = col
		energyText.Text = "⚡ " .. tostring(s.hud.energy) .. "%"
	else
		hud.Visible = false
	end
	local y = topSafe + (s.hud and 86 or 0)
	-- tabs
	clear(tabsBar)
	if s.tabs and #s.tabs > 0 then
		tabsBar.Visible = true
		tabsBar.Position = UDim2.new(0, 0, 0, y)
		for i, t in ipairs(s.tabs) do
			local tb = make("TextButton", {
				LayoutOrder = i,
				Size = UDim2.new(1 / #s.tabs, -6, 1, -6),
				BackgroundColor3 = t.active and C.gold or C.panel2,
				BackgroundTransparency = 0,
				BorderSizePixel = 0,
				Text = (TAB_ICON[t.id] and (TAB_ICON[t.id] .. " ") or "") .. t.label,
				TextSize = 16,
				Font = TITLE_FONT,
				TextColor3 = t.active and C.outline or C.text,
				Parent = tabsBar,
			})
			rounded(tb, 12)
			outline(tb, C.outline, 2)
			-- six tabs on a phone: the label shrinks to fit
			tb.TextScaled = true
			make("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 9 }).Parent = tb
			make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }).Parent = tb
			tb.Activated:Connect(function()
				send("tab", t.id)
			end)
		end
		y += 46
	else
		tabsBar.Visible = false
	end
	-- buttons
	clear(buttonBar)
	for i, b in ipairs(s.buttons or {}) do
		button(b, i, buttonBar)
	end
	local barH = #(s.buttons or {}) > 0 and (#s.buttons * (BUTTON_H + 8) + 20) or 0
	page.Position = UDim2.new(0, 0, 0, y)
	page.Size = UDim2.new(1, 0, 1, -(y + barH))
	page.CanvasPosition = Vector2.zero
	-- the page
	clear(page)
	if s.title and s.title ~= "" then
		textOutline(label(string.upper(s.title), 32, C.text, TITLE_FONT, { LayoutOrder = 0, Parent = page }))
	end
	for i, b in ipairs(s.blocks or {}) do
		drawBlock(b, i)
	end
end

drawBlock = function(b, order)
	local k = b.kind
	if k == "heading" then
		label(string.upper(b.text), 20, C.gold, TITLE_FONT, { LayoutOrder = order, Parent = page })
	elseif k == "text" then
		local p = panel(order)
		label(b.text, 16, toneColor(b.tone), b.tone == "gold" and BODY_BOLD or BODY_FONT, { Parent = p })
	elseif k == "stats" then
		local grid = make("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = page,
		}, { make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 66), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
		for i, it in ipairs(b.items or {}) do
			local cell = make("Frame", { LayoutOrder = i, BackgroundColor3 = C.panel, BackgroundTransparency = 0.12, BorderSizePixel = 0, Parent = grid }, { pad(8) })
			rounded(cell, 12)
			outline(cell, Color3.new(1, 1, 1), 1.5).Transparency = 0.8
			label(string.upper(it.label), 12, C.dim, BODY_BOLD, { Size = UDim2.new(1, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.None, Parent = cell })
			label(it.value, 24, toneColor(it.tone), TITLE_FONT, { Position = UDim2.new(0, 0, 0, 18), Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = cell })
		end
	elseif k == "table" then
		local p = panel(order)
		local cols = b.columns or {}
		-- the club column takes the room; the others are narrow
		local widths = {}
		local wide = 2
		local narrow = 0.09
		local nNarrow = #cols - 1
		for i = 1, #cols do
			widths[i] = (i == wide) and (1 - narrow * nNarrow) or narrow
		end
		local function row(cells, idx, isHead, hl)
			local r = make("Frame", {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundColor3 = hl and C.highlight or C.panel,
				BackgroundTransparency = hl and 0.75 or 1,
				BorderSizePixel = 0,
				Parent = p,
			})
			local x = 0
			for i, text in ipairs(cells) do
				label(text, isHead and 12 or 14, isHead and C.dim or C.text, (isHead or hl) and BODY_BOLD or BODY_FONT, {
					Position = UDim2.new(x, 2, 0, 0),
					Size = UDim2.new(widths[i] or narrow, -4, 1, 0),
					AutomaticSize = Enum.AutomaticSize.None,
					TextWrapped = false,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = (i == wide) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
					Parent = r,
				})
				x += widths[i] or narrow
			end
		end
		row(cols, 0, true, false)
		for i, cells in ipairs(b.rows or {}) do
			row(cells, i, false, b.highlight ~= nil and (i - 1) == b.highlight)
		end
	elseif k == "list" then
		local p = panel(order)
		p:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 2)
		for i, it in ipairs(b.items or {}) do
			local holder
			if it.action then
				holder = make("TextButton", {
					LayoutOrder = i,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = C.field,
					BackgroundTransparency = 0.3,
					BorderSizePixel = 0,
					Text = "",
					Parent = p,
				})
				rounded(holder, 10)
				holder.Activated:Connect(function()
					send(it.action, it.arg)
				end)
			else
				holder = make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = p })
			end
			pad(8).Parent = holder
			make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }).Parent = holder
			label(it.text .. (it.action and "  ›" or ""), 16, toneColor(it.tone), it.action and BODY_BOLD or BODY_FONT, { LayoutOrder = 1, Parent = holder })
			if it.sub then
				label(it.sub, 13, C.dim, BODY_FONT, { LayoutOrder = 2, Parent = holder })
			end
		end
	elseif k == "input" then
		form[b.id] = b.value or ""
		local p = panel(order)
		label(string.upper(b.label), 12, C.dim, BODY_BOLD, { Parent = p })
		local box = make("TextBox", {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = C.field,
			BorderSizePixel = 0,
			Text = b.value or "",
			PlaceholderText = b.label,
			PlaceholderColor3 = C.dim,
			TextSize = 18,
			Font = BODY_FONT,
			TextColor3 = C.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Parent = p,
		}, { pad(8) })
		rounded(box, 10)
		box:GetPropertyChangedSignal("Text"):Connect(function()
			form[b.id] = string.sub(box.Text, 1, 24)
		end)
	elseif k == "choice" then
		form[b.id] = b.value
		local p = panel(order)
		label(string.upper(b.label), 12, C.dim, BODY_BOLD, { Parent = p })
		local pick = make("TextButton", {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = C.field,
			BorderSizePixel = 0,
			Text = "  " .. tostring(b.value) .. "  ▾",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 18,
			Font = BODY_BOLD,
			TextColor3 = C.text,
			Parent = p,
		})
		rounded(pick, 10)
		pick.Activated:Connect(function()
			openChooser({ label = b.label, options = b.options, value = form[b.id] }, function(v)
				form[b.id] = v
				pick.Text = "  " .. v .. "  ▾"
			end)
		end)
	end
end

-- ─────────────────────────────────────────────────────────────── talking ──
local sending = false
send = function(action, arg)
	if sending then
		return
	end
	sending = true
	busyCover.Visible = true
	local ok, json
	if action == "play-match" or action == "play-trial" or action == "play-training" or action == "play-relgame" then
		-- played here on the device; the menus wait underneath
		gui.Enabled = false
		if action == "play-match" then
			ok, json = pcall(MatchClient.play, matchRemote)
		elseif action == "play-training" then
			ok, json = pcall(MatchClient.playTraining, trainingRemote, arg)
		elseif action == "play-relgame" then
			ok, json = pcall(MatchClient.playRelGame, relRemote, arg)
		else
			ok, json = pcall(MatchClient.playTrial, trialRemote)
		end
		gui.Enabled = true
		if ok and json == nil then
			ok, json = pcall(function()
				return remote:InvokeServer("get", nil, form)
			end)
		end
	else
		ok, json = pcall(function()
			return remote:InvokeServer(action, arg, form)
		end)
	end
	busyCover.Visible = false
	sending = false
	if not ok then
		warn("Career call failed:", json)
		return
	end
	local decoded, s = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if decoded and s then
		drawScreen(s)
	end
end

send("get")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="340">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[--[[
  The match, played on the player's device.

  The rules are the website's (roblox/game/match.ts, converted): this file
  only draws what roblox/game/matchView.ts says is on the pitch, and passes
  your input in. Nothing about the football is decided here.

  Controls, as on the website:
    - drag back from the ball and let go: aim and power;
    - the strike screen: tap where on the ball to hit it;
    - a swipe while the ball flies: curve (curve boots);
    - the penalty run-up: drag sideways to change where you aim.
  Moving more (Mikey, 27 Oct 2026): after a pass you run your own man with
  W A S D or the thumb stick (Shift / the Sprint button to sprint), and the
  top-down dribble is played the same way (Q / E or the buttons to knock it
  past your man, tap a team-mate to pass).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer

local Match = {}

-- ─────────────────────────────────────────────────────────── the code ──
local Loader, Js, M, V, S, C3
local function loadCode()
	if Loader then
		return
	end
	Loader = require(ReplicatedStorage:WaitForChild("Runtime"):WaitForChild("Loader"))
	Js = Loader.Js
	M = Loader.import("roblox/game/match")
	V = Loader.import("roblox/game/matchView")
	S = Loader.import("roblox/game/strikeScreen")
	C3 = Loader.import("roblox/game/camera3d")
end

-- ─────────────────────────────────────────────────────────── the look ──
local SCALE = 3 -- studs per metre (a Roblox figure is about 5.5 studs, a man 1.83 m)
local PITCH_W, PITCH_Y1, PITCH_Y2 = 68, -8, 105
local TITLE_FONT = Enum.Font.FredokaOne
local BODY_FONT = Enum.Font.Gotham
local BODY_BOLD = Enum.Font.GothamBold
local SKIN = {
	Color3.fromRGB(241, 194, 158),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(141, 85, 54),
	Color3.fromRGB(92, 58, 38),
}
local GRASS_A = Color3.fromHex("3f9b55")
local GRASS_B = Color3.fromHex("37904d")

local function w(x, y, z)
	return Vector3.new(x * SCALE, (z or 0) * SCALE, y * SCALE)
end

local function color(hex, fallback)
	if type(hex) == "string" then
		local ok, c = pcall(Color3.fromHex, (string.gsub(hex, "^#", "")))
		if ok then
			return c
		end
	end
	return fallback or Color3.fromRGB(200, 200, 200)
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

local function make(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, ch in ipairs(children or {}) do
		ch.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function label(text, size, col, font, props)
	local l = make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = col,
		Font = font,
		TextWrapped = true,
	})
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end

-- ─────────────────────────────────────────────────────────── the stadium ──
local function line(folder, x1, y1, x2, y2)
	local len = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
	local mid = w((x1 + x2) / 2, (y1 + y2) / 2, 0.012)
	part({
		Size = Vector3.new(0.12 * SCALE, 0.05, len * SCALE + 0.12 * SCALE),
		CFrame = CFrame.lookAt(mid, mid + Vector3.new((x2 - x1), 0, (y2 - y1))),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function arc(folder, cx, cy, r, a1, a2)
	local n = 24
	for i = 0, n - 1 do
		local t1 = a1 + (a2 - a1) * i / n
		local t2 = a1 + (a2 - a1) * (i + 1) / n
		line(folder, cx + r * math.cos(t1), cy + r * math.sin(t1), cx + r * math.cos(t2), cy + r * math.sin(t2))
	end
end

local function buildStadium(kitUs, kitThem)
	local folder = Instance.new("Folder")
	folder.Name = "MatchWorld"
	-- the grass, in stripes
	local stripe = 5.5
	local y = PITCH_Y1
	local i = 0
	while y < PITCH_Y2 do
		local y2 = math.min(PITCH_Y2, y + stripe)
		part({
			Size = Vector3.new((PITCH_W + 16) * SCALE, 1, (y2 - y) * SCALE),
			Position = w(PITCH_W / 2, (y + y2) / 2, 0) - Vector3.new(0, 0.5, 0),
			Color = i % 2 == 0 and GRASS_A or GRASS_B,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
		y = y2
		i += 1
	end
	-- the lines (IFAB sizes)
	local CXm = PITCH_W / 2
	line(folder, 0, 0, PITCH_W, 0)
	line(folder, 0, 0, 0, PITCH_Y2 - 0.5)
	line(folder, PITCH_W, 0, PITCH_W, PITCH_Y2 - 0.5)
	line(folder, 0, 52.5, PITCH_W, 52.5)
	arc(folder, CXm, 52.5, 9.15, math.pi, 2 * math.pi)
	arc(folder, CXm, 52.5, 9.15, 0, math.pi)
	line(folder, CXm - 20.16, 0, CXm - 20.16, 16.5)
	line(folder, CXm + 20.16, 0, CXm + 20.16, 16.5)
	line(folder, CXm - 20.16, 16.5, CXm + 20.16, 16.5)
	line(folder, CXm - 9.16, 0, CXm - 9.16, 5.5)
	line(folder, CXm + 9.16, 0, CXm + 9.16, 5.5)
	line(folder, CXm - 9.16, 5.5, CXm + 9.16, 5.5)
	local dA = math.acos(5.5 / 9.15)
	arc(folder, CXm, 11, 9.15, math.pi / 2 - dA, math.pi / 2 + dA)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, 0.3 * SCALE, 0.3 * SCALE), CFrame = CFrame.new(w(CXm, 11, 0.015)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.new(1, 1, 1), Parent = folder })
	arc(folder, 0, 0, 1, 0, math.pi / 2)
	arc(folder, PITCH_W, 0, 1, math.pi / 2, math.pi)
	-- the goal: posts, bar and net
	local POST_L, POST_R, BAR = 30.34, 37.66, 2.44
	local postR = 0.06
	local white = Color3.new(1, 1, 1)
	for _, px in ipairs({ POST_L - postR, POST_R + postR }) do
		part({ Size = Vector3.new(postR * 2 * SCALE, (BAR + postR) * SCALE, postR * 2 * SCALE), Position = w(px, -postR, (BAR + postR) / 2), Color = white, Material = Enum.Material.Metal, Parent = folder })
	end
	part({ Size = Vector3.new((POST_R - POST_L + postR * 4) * SCALE, postR * 2 * SCALE, postR * 2 * SCALE), Position = w(CXm, -postR, BAR + postR), Color = white, Material = Enum.Material.Metal, Parent = folder })
	local net = { Color = Color3.fromRGB(235, 235, 235), Transparency = 0.72, Material = Enum.Material.ForceField, Parent = folder }
	local depth = 2
	local function netPart(size, pos)
		local t = table.clone(net)
		t.Size = size
		t.Position = pos
		part(t)
	end
	netPart(Vector3.new((POST_R - POST_L) * SCALE, BAR * SCALE, 0.1), w(CXm, -depth, BAR / 2))
	netPart(Vector3.new((POST_R - POST_L) * SCALE, 0.1, depth * SCALE), w(CXm, -depth / 2, BAR))
	netPart(Vector3.new(0.1, BAR * SCALE, depth * SCALE), w(POST_L, -depth / 2, BAR / 2))
	netPart(Vector3.new(0.1, BAR * SCALE, depth * SCALE), w(POST_R, -depth / 2, BAR / 2))
	-- advertising boards and the stands, in both teams' colours
	local boardCol = { color(kitUs.shirt), Color3.fromHex("0b1220"), color(kitThem.shirt), Color3.fromHex("0b1220") }
	local bi = 0
	for x = 0, PITCH_W - 8, 8 do
		bi += 1
		part({ Size = Vector3.new(8 * SCALE, 0.9 * SCALE, 0.2 * SCALE), Position = w(x + 4, -5, 0.45), Color = boardCol[bi % 4 + 1], Material = Enum.Material.Neon, Parent = folder })
	end
	local function stand(cx, cy, sx, sy, facingX, facingY)
		for row = 0, 7 do
			local step = row * 1.2
			part({
				Size = Vector3.new((sx + (facingX ~= 0 and step * 2 or 0)) * SCALE, 1.1 * SCALE, (sy + (facingY ~= 0 and step * 2 or 0)) * SCALE),
				Position = w(cx - facingX * step, cy - facingY * step, 0.55 + row * 1.1),
				Color = row % 2 == 0 and Color3.fromHex("1e293b") or Color3.fromHex("334155"),
				Parent = folder,
			})
		end
		-- the crowd: dots of colour on the rows
		local rng = Random.new(cx * 1000 + cy)
		for k = 1, 90 do
			local row = rng:NextInteger(0, 7)
			local along = rng:NextNumber(-0.5, 0.5)
			local px = cx - facingX * row * 1.2 + (facingX == 0 and along * sx or 0)
			local py = cy - facingY * row * 1.2 + (facingY == 0 and along * sy or 0)
			local col = rng:NextNumber() < 0.45 and color(kitUs.shirt) or rng:NextNumber() < 0.5 and color(kitThem.shirt) or Color3.fromHSV(rng:NextNumber(), 0.3, 0.9)
			part({ Size = Vector3.new(0.5 * SCALE, 0.7 * SCALE, 0.5 * SCALE), Position = w(px, py, 1.45 + row * 1.1), Color = col, Parent = folder })
		end
	end
	stand(CXm, -9, PITCH_W + 10, 3, 0, 1)
	stand(-7, 50, 3, 120, 1, 0)
	stand(PITCH_W + 7, 50, 3, 120, -1, 0)
	folder.Parent = workspace
	return folder
end

-- ─────────────────────────────────────────────────────────── the figures ──
-- A man in kit: legs, shorts, shirt, arms, head. Blocky, Roblox-style.
local LEG_H, HIP_Y, SHORTS_H, TORSO_H, HEAD_R = 0.86, 0.86, 0.26, 0.6, 0.14

local function newFigure(folder)
	local f = { parts = {} }
	local function add(name, size, shape)
		local p = part({ Name = name, Size = size * SCALE, Parent = folder })
		if shape then
			p.Shape = shape
		end
		f.parts[name] = p
		return p
	end
	add("legL", Vector3.new(0.17, LEG_H, 0.17))
	add("legR", Vector3.new(0.17, LEG_H, 0.17))
	add("shorts", Vector3.new(0.44, SHORTS_H, 0.26))
	add("torso", Vector3.new(0.46, TORSO_H, 0.26))
	add("armL", Vector3.new(0.13, 0.6, 0.13))
	add("armR", Vector3.new(0.13, 0.6, 0.13))
	add("head", Vector3.new(HEAD_R * 2, HEAD_R * 2, HEAD_R * 2), Enum.PartType.Ball)
	add("hair", Vector3.new(HEAD_R * 2.05, HEAD_R * 0.9, HEAD_R * 2.05))
	f.parts.hair.Color = Color3.fromRGB(40, 28, 20)
	local tag = make("BillboardGui", {
		Size = UDim2.fromOffset(120, 20),
		StudsOffset = Vector3.new(0, 1.6, 0),
		AlwaysOnTop = true,
		MaxDistance = 160,
		LightInfluence = 0,
		Parent = f.parts.head,
	})
	f.tag = label("", 14, Color3.new(1, 1, 1), BODY_BOLD, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.4, Parent = tag })
	f.pos = nil
	f.yaw = 0
	f.stride = 0
	f.side = nil
	return f
end

local function dress(f, kit, shorts, skin)
	local shirt = color(kit.shirt)
	local trim = color(kit.trim, shirt)
	f.parts.torso.Color = shirt
	f.parts.armL.Color = shirt
	f.parts.armR.Color = shirt
	f.parts.shorts.Color = shorts or trim
	f.parts.legL.Color = shirt:Lerp(Color3.new(1, 1, 1), 0.15)
	f.parts.legR.Color = shirt:Lerp(Color3.new(1, 1, 1), 0.15)
	f.parts.head.Color = skin
end

local function hideFigure(f)
	for _, p in pairs(f.parts) do
		p.Transparency = 1
	end
	f.tag.Visible = false
	f.hidden = true
end

local function showFigure(f)
	for name, p in pairs(f.parts) do
		p.Transparency = 0
	end
	f.tag.Visible = true
	f.hidden = false
end

-- Pose a figure: feet at `pos` (world), facing `yaw`, legs by `stride`, `roll` to dive.
local function pose(f, pos, yaw, k, roll, list, cfs)
	local root = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, roll)
	local swing = math.sin(f.stride) * 0.75 * k
	local function put(name, cf)
		table.insert(list, f.parts[name])
		table.insert(cfs, cf)
	end
	local s = SCALE
	put("legL", root * CFrame.new(-0.11 * s, HIP_Y * s, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -LEG_H / 2 * s, 0))
	put("legR", root * CFrame.new(0.11 * s, HIP_Y * s, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -LEG_H / 2 * s, 0))
	put("shorts", root * CFrame.new(0, (HIP_Y + 0.02) * s, 0))
	local torsoY = HIP_Y + SHORTS_H / 2 + TORSO_H / 2
	put("torso", root * CFrame.new(0, torsoY * s, 0))
	local shoulderY = torsoY + TORSO_H / 2 - 0.05
	put("armL", root * CFrame.new(-0.3 * s, shoulderY * s, 0) * CFrame.Angles(-swing * 0.8, 0, -0.08) * CFrame.new(0, -0.3 * s, 0))
	put("armR", root * CFrame.new(0.3 * s, shoulderY * s, 0) * CFrame.Angles(swing * 0.8, 0, 0.08) * CFrame.new(0, -0.3 * s, 0))
	local headY = torsoY + TORSO_H / 2 + HEAD_R + 0.02
	put("head", root * CFrame.new(0, headY * s, 0))
	put("hair", root * CFrame.new(0, (headY + HEAD_R * 0.55) * s, 0.02 * s))
end

-- ─────────────────────────────────────────────────────────── the camera ──
-- roblox/game/camera3d.ts works out where to stand (pitch metres); this turns it into studs
local function toCFrame(cam)
	return CFrame.lookAt(w(cam.pos.x, cam.pos.y, cam.pos.h), w(cam.target.x, cam.target.y, cam.target.h))
end

-- ─────────────────────────────────────────────────────────── the screen ──
local C = {
	panel = Color3.fromHex("0b1220"),
	panel2 = Color3.fromHex("111a2e"),
	text = Color3.new(1, 1, 1),
	dim = Color3.fromHex("b6c2d4"),
	good = Color3.fromHex("34d399"),
	bad = Color3.fromHex("f87171"),
	gold = Color3.fromHex("fde047"),
	ink = Color3.fromHex("0b1220"),
	button = Color3.fromHex("1e293b"),
}

local function bigButton(text, parent, props)
	local b = make("TextButton", {
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = C.gold,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Text = text,
		TextSize = 20,
		Font = TITLE_FONT,
		TextColor3 = C.ink,
		Parent = parent,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 12) }),
		make("UIStroke", { Color = C.ink, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		make("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)) }),
	})
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	return b
end

local function buildHud()
	local gui = make("ScreenGui", { Name = "MatchHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })
	local h = { gui = gui }
	-- the score
	local bar = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.fromOffset(300, 40), BackgroundColor3 = C.panel, BackgroundTransparency = 0.1, BorderSizePixel = 0, Parent = gui }, { make("UICorner", { CornerRadius = UDim.new(0, 8) }) })
	h.score = label("", 22, C.text, TITLE_FONT, { Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(8, 0), Parent = bar })
	h.minute = label("", 20, C.gold, TITLE_FONT, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0, 56, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = bar })
	local eBack = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 88), Size = UDim2.fromOffset(220, 10), BackgroundColor3 = Color3.fromHex("1e293b"), BorderSizePixel = 0, Parent = gui }, { make("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	h.energy = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.good, BorderSizePixel = 0, Parent = eBack }, { make("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	-- the big word (GOAL!, SAVED)
	h.banner = label("", 64, C.gold, TITLE_FONT, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(1, 0, 0, 80), TextStrokeTransparency = 0.2, Visible = false, Parent = gui })
	-- the chance's commentary
	h.feed = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Size = UDim2.new(0.6, 0, 0, 84), BackgroundTransparency = 1, Parent = gui }, {
		make("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	h.feedLines = {}
	for i = 1, 3 do
		h.feedLines[i] = label("", 16, C.text, BODY_BOLD, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.35, Parent = h.feed })
	end
	-- the buttons on the right
	h.side = make("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.fromOffset(150, 260), BackgroundTransparency = 1, Parent = gui }, {
