	smoothRGB = function(d, w, h, rad)
		if (rad <= 0) then
			do return end
		end
		local src = Js.typedArray(d)
		local sc = ((2 * 26) * 26)
		local ss = ((2 * rad) * rad)
		for y = 0, math.ceil(h) - 1 do
			for x = 0, math.ceil(w) - 1 do
				local i = (((y * w) + x) * 4)
				if (src[Js.key((i + 3))] == 0) then
					do continue end
				end
				local r = 0
				local g = 0
				local b = 0
				local tw = 0
				do
					local dy = (-rad)
					local _first19 = true
					while true do
						if not _first19 then
