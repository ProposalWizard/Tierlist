	assistRace = function(career)
		local squads = (if career.leagueSquads ~= nil then career.leagueSquads else Js.alit())
		local out = Js.alit()
		do
			local _arr7 = squads
			local _i8 = 0
			while _i8 < Js.alen(_arr7) do
				_i8 += 1
				local sq = _arr7[_i8]
				if (sq.club == career.player.club) then
