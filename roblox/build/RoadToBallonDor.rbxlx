				do break end
			end
		end
		do return advanceEuroBracket(Js.ospread(br, Js.O({ rounds = rounds }, { "rounds" })), you, str, sim, rng) end
	end
	exports.settleYourKoTie = settleYourKoTie
	koAggregate = function(t)
