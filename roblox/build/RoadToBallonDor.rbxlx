	AREA = Js.O({ x1 = 20, x2 = 48, y1 = 4.5, y2 = 30 }, { "x1", "x2", "y1", "y2" })
	MARKER_BOX = Js.O({ x1 = 18.5, x2 = 49.5, y1 = 1.5, y2 = 33.5 }, { "x1", "x2", "y1", "y2" })
