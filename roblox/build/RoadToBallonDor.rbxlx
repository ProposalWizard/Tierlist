		local g = Math.max(-1, Math.min(1, (cx / AIR_TAP_POST_CX)))
		do return (M_pitch.CX - (g * ((M_pitch.GOAL_W / 2) - AIR_TAP_INSET_M))) end
	end
	exports.airTapAimX = airTapAimX
