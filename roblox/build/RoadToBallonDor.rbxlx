	dragRoomCamera = function(cam, sc, hw, tiltDeg)
		if tiltDeg == nil then tiltDeg = 0 end
		local fits = function(v)
			local m = (DRAG_ROOM_SHARE * (v.x2 - v.x1))
			do return ((sc.ball.x >= ((v.x1 + m) - 0.000001)) and (sc.ball.x <= ((v.x2 - m) + 0.000001))) end
