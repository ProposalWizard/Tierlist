			do return Js.O({ sx = (1 - fy), sy = fx }, { "sx", "sy" }) end
		end
		if (facing == "left") then
			do return Js.O({ sx = fy, sy = (1 - fx) }, { "sx", "sy" }) end
		end
		do return Js.O({ sx = fx, sy = fy }, { "sx", "sy" }) end
