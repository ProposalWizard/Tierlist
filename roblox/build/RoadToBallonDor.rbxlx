			m.fpDribble = Js.O({ waveSizes = M_firstPersonDribble.pickWaveSizes(rng, Js.O({ minRounds = 3 }, { "minRounds" })), seed = math.floor((rng() * 1000000000)) }, { "waveSizes", "seed" })
			clearChance(m)
