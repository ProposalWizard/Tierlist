	end
	exports.looksLikeSkin = looksLikeSkin
	medianColour = function(px)
		if (not Js.T(Js.alen(px))) then
			do return nil end
		end
		local ch = function(i)
			local v = A.sort(A.map(px, function(p)
				return p[i + 1]
