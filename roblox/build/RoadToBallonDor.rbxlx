	end
	exports.leadingScorer = leadingScorer
	monthlyAward = function(career)
		if ((career.week < MONTH_WEEKS) or (math.fmod(career.week, MONTH_WEEKS) ~= 0)) then
			do return nil end
		end
		if (Js.alen(career.form) < 3) then
			do return nil end
