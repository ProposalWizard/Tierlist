	exports.topSpeedScale = topSpeedScale
	POWER_POINTS = Js.alit(0, 20, 40, 60, 80, 100)
	exports.POWER_POINTS = POWER_POINTS
	DEFAULT_POWER_SPEEDS = Js.alit(18, 19.5, 21, 23.4, 30.6, 32.76)
