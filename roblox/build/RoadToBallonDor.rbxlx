								local dc = ((((src[Js.key(j)] - src[Js.key(i)]) ^ 2) + ((src[Js.key((j + 1))] - src[Js.key((i + 1))]) ^ 2)) + ((src[Js.key((j + 2))] - src[Js.key((i + 2))]) ^ 2))
								local wt = Math.exp((((-((dx * dx) + (dy * dy))) / ss) - (dc / sc)))
								r += (src[Js.key(j)] * wt)
