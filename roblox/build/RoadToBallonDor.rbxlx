			do return M_kit.ev("appearance-milestone", M_kit.you(r), (if (hit >= 200) then 74 else 52), Js.alit("milestone", "record"), Js.ospread(M_kit.base(r), Js.O({ milestone = hit, goals = r.you.careerGoals }, { "milestone", "goals" })), "hour") end
		end
