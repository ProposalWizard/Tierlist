		if (m.st.minute > m.minute) then
			local cur = m.minute
			local target = (cur + 1)
			if (((not m.halfTimeShown) and (target > M_matchLog.HALF_TIME_MINUTE)) and (cur >= M_matchLog.HALF_TIME_MINUTE)) then
				m.halfTimeShown = true
