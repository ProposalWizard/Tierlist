		do return Js.O({ powerMult = (1 + ((POWER_SHOT_MAX_MULT - 1) * q)), driftDeg = (side * (0.5 + ((POWER_SHOT_MAX_DRIFT_DEG - 0.5) * (1 - q)))) }, { "powerMult", "driftDeg" }) end
	end
