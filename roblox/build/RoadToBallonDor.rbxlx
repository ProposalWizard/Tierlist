	exports.meanAgeChange = meanAgeChange
	leoMeanAgeChange = function(age)
		if (age <= 17) then
			do return 4.5 end
		end
		if (age == 18) then
			do return 4 end
		end
		if (age == 19) then
			do return 3.5 end
