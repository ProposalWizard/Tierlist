		do
			local _arr3 = sc.defenders
			local _i4 = 0
			while _i4 < Js.alen(_arr3) do
				_i4 += 1
				local d = _arr3[_i4]
				if (d.baseRole == "hold") then
					do continue end
				end
				local tx = nil
