"broadsheet", events = Js.alit("cheeky-miss"), subject = "you", requires = Js.alit("chip", "short", "opponent"), body = "{short} tried to be clever against {opponent} and got it wrong. A chip only looks inspired when it comes off; this one didn't.", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "bs-cheeky-middle", archetype = "broadsheet", events = Js.alit("cheeky-miss"), subject = "you", requires = Js.alit("middle", "short", "opponent"), body = "{short} went straight down the middle from the spot against {opponent} and missed. It is the bravest penalty there is, and the most exposed when it goes wrong.", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "pu-cheeky-chip", archetype = "pundit", events = Js.alit("cheeky-miss"), subject = "you", requires = Js.alit("chip", "short", "score"), body = "You chip it when you're three up. Not at {score}. {short} will hear about that one in the dressing room.", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "pu-cheeky-middle", archetype = "pundit", events = Js.alit("cheeky-miss"), subject = "you", requires = Js.alit("middle", "short"), body = "Down the middle is a great penalty right up until it isn't. {short} has to take that more seriously.", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "weight" }), Js.O({ id = "meme-cheeky", archetype = "meme", events = Js.alit("cheeky-miss"), subject = "you", requires = Js.alit("short"), body = "{short} walking back after that penalty:", graphic = "thumbnail", weight = 3 }, { "id", "archetype", "events", "subject", "requires", "body", "graphic", "weight" }))
