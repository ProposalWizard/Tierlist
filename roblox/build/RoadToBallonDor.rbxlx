	local A, S, N, Math = Js.A, Js.S, Js.N, Js.Math
	local PRESS_TEMPLATES = Js.alit(Js.O({ id = "bs-report-win", archetype = "broadsheet", events = Js.alit("win", "rout"), frames = Js.alit("analyse", "report"), body = "{club} {winVerb} {venue} against {opponent}, a {score} that will feel more comfortable in the morning than it did at the time.", weight = 2 }, { "id", "archetype", "events", "frames", "body", "weight" }), Js.O({ id = "bs-report-loss", archetype = "broadsheet", events = Js.alit("loss", "hammered"), frames = Js.alit("analyse", "report"), body = "{club} {lossVerb} {venue}. {opponent} deserved the {score}, and the questions that follow will not be about the scoreline alone.", weight = 2 }, { "id", "archetype", "events", "frames", "body", "weight" }), Js.O({ id = "bs-rout", archetype = "broadsheet", events = Js.alit("rout"), requires = Js.alit("margin"), body = "{club} {bigWin} {venue}. {margin} clear, and for long spells {opponent} looked like a side hoping the whistle would come early." }, { "id", "archetype", "events", "requires", "body" }), Js.O({ id = "bs-hammered", archetype = "broadsheet", events = Js.alit("hammered", "embarrassed"), requires = Js.alit("margin"), body = "{club} {bigLoss}. A {score} defeat that raises harder questions than any single afternoon should have to answer." }, { "id", "archetype", "events", "requires", "body" }), Js.O({ id = "bs-goal", archetype = "broadsheet", tags = Js.alit("goal"), subject = "you", requires = Js.alit("goals"), excludes = Js.alit("matches"), body = "{player} took {goals}, and on this evidence there is little sign of it stopping.", threadBody = "{player} has {thread.goals} goals in {thread.matches} matches — a run that has quietly become the story of {club|possessive} season.", weight = 2 }, { "id", "archetype", "tags", "subject", "requires", "excludes", "body", "threadBody", "weight" }), Js.O({ id = "bs-hall-record", archetype = "broadsheet", events = Js.alit("hall-record"), subject = "you", requires = Js.alit("holder", "was", "now"), body = "{holder} set