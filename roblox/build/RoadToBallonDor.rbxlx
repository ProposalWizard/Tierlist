	CLEAR = Js.O({ weather = "clear", pitch = 0, label = "Clear", note = "Perfect conditions.", drag = 1, friction = 1, bounce = 1, wind = 0 }, { "weather", "pitch", "label", "note", "drag", "friction", "bounce", "wind" })
end
