		end
		local passes = passesInTrack(b, durS)
		local nearestName = function(t)
			local ball = ballAt(t)
			local best = ""
			local bd = 3
			do
				local _arr3 = b.men
				local _i4 = 0
				while _i4 < Js.alen(_arr3) do
					_i4 += 1
					local m = _arr3[_i4]
					local p = along(m.path, Math.min(durS, t), function(q)
						return Js.alit(q.x, q.y)
					end)
					local d = Math.hypot((p[1] - ball.x), (p[2] - ball.y))
