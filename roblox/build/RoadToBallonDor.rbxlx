	end
	exports.retirementAgeFor = retirementAgeFor
	meanAgeChange = function(age)
		if (age >= DECLINE_START) then
			do return (LEO_DECLINE[Math.min((Js.alen(LEO_DECLINE) - 1), (age - DECLINE_START)) + 1] * DECLINE_SCALE) end
		end
		if (age > 25) then
