			end)
			do return v[Js.shr(Js.alen(v), 1) + 1] end
		end
		do return Js.alit(ch(0), ch(1), ch(2)) end
	end
	exports.medianColour = medianColour
	hasCutout = function(data, w, h)
		local clear = 0
		local n = 0
		do
			local x = 0
