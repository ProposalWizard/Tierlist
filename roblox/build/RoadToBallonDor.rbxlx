	local simOdds, SIM_RUN_CLEARED, simulateOwnMatch
	simOdds = function(kind, s, keeper)
		if keeper == nil then keeper = 83 end
		local shotQ = ((s.power + s.technique) / 200)
		local passQ = ((s.technique + s.vision) / 200)
