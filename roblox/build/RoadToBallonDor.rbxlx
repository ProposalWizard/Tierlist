		end
		local env = Math.min(1, ((t - kn.onset) / 0.25))
		local lat = (((kn.amp * env) * (Math.sin(((kn.freq * t) + kn.phase)) + (0.55 * Math.sin((((2.37 * kn.freq) * t) + kn.phase2))))) / 1.55)
