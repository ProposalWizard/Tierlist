	exports.sampleSkin = sampleSkin
	backgroundMask = function(d, w, h, keep)
		local bg = Js.typedArray((w * h))
		local mr = 0
		local mg = 0
		local mb = 0
		local n = 0
		local edge = Js.alit()
		for x = 0, math.ceil(w) - 1 do
			A.push(edge, x, (((h - 1) * w) + x))
		end
		for y = 0, math.ceil(h) - 1 do
			A.push(edge, (y * w), (((y * w) + w) - 1))
		end
