		local plus = (if (can.restore > 0) then (" + " .. Js.numstr(can.restore) .. " energy") else "")
		if (can.effect == "curve") then
			do return ("Swerve boots' curve for your next match" .. plus) end
		end
		if (can.effect == "extraTouch") then
