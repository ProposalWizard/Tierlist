	end
	exports.afterSigning = afterSigning
	loadRealSquads = function(g)
		local c = g.career
		local club = c.player.club
		local clubs = A.map(c.league, function(t)
			return t.name
		end)
		local squad = Js.await(M_realSquad.fetchRealSquad(club))
