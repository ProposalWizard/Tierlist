		local table_ = A.map(clubs, function(c)
			return Js.O({ name = c.name, played = 0, won = 0, drawn = 0, lost = 0, goalsFor = 0, goalsAgainst = 0, points = 0, isYou = false }, { "name", "played", "won", "drawn", "lost", "goalsFor", "goalsAgainst", "points", "isYou" })
