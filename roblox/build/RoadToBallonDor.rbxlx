					local _e18 = _arr16[_i17]
					local nx = _e18[1]
					local ny = _e18[2]
					if ((((nx < 0) or (ny < 0)) or (nx >= w)) or (ny >= h)) then
						do continue end
					end
					local q = ((ny * w) + nx)
					if (Js.T(bg[Js.key(q)]) or keep(nx, ny)) then
						do continue end
					end
