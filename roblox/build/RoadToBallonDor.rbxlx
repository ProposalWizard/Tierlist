		local midX = ((Math.min(Js.unpack(Js.aspread(A.map(men, function(b)
			return b.sx
		end), A.map(goal, function(b)
			return b.sx
		end)))) + Math.max(Js.unpack(Js.aspread(A.map(men, function(b)
			return b.sx
		end), A.map(goal, function(b)
			return b.sx
