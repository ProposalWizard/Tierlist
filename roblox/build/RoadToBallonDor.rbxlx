	h.shadow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 11, Parent = h.strike }, { make("UICorner", { CornerRadius = UDim.new(1, 0) }) })
