	h.pow = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.5), BorderSizePixel = 0, ZIndex = 13, Parent = powBack }, { make("UICorner", { CornerRadius = UDim.new(1, 0) }) })
