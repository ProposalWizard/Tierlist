		local marks = Js.alit(50, 100, 150, 200, 250, 300, 400, 500)
		local hit = A.find(marks, function(m)
			return (r.you.careerAppearances == m)
		end)
		local clubHit = A.find(marks, function(m)
			return (r.you.clubAppearances == m)
