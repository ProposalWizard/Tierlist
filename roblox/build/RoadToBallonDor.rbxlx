			do return M_kit.ev("club-appearance-milestone", M_kit.you(r), (if (clubHit >= 200) then 68 else 46), Js.alit("milestone"), Js.ospread(M_kit.base(r), Js.O({ milestone = clubHit }, { "milestone" })), "hour") end
		end
