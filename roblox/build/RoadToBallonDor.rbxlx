			end), function(id)
				return byId:get(id)
			end), function(p)
				return (not (not p))
			end), 0, 9)
			local onBench = Js.Set.new(A.map(savedPicks, function(p)
				return p.id
			end))
			local topUp = (if (Js.alen(savedPicks) < 9) then A.slice(A.sort(A.filter(pool, function(p)
				return ((not started:has(p.id)) and (not onBench:has(p.id)))
