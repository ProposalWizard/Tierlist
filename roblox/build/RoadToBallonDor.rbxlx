			local incoming = Js.O({ vx = ball.vel.x, vy = ball.vel.y, vz = ball.vz, z = ball.z, spin = ball.spin }, { "vx", "vy", "vz", "z", "spin" })
			local mateProbe = M_credit.probeMatePlays(sc)
