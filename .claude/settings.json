{
  "permissions": {
    "allow": [
      "mcp__Adobe_for_creativity__*",
      "Bash",
      "mcp__Vercel__*",
      "mcp__Google_Drive__*",
      "mcp__github__*",
      "mcp__Supabase__list_*",
      "mcp__Supabase__get_*",
      "mcp__claude-code-remote__*",
      "Artifact",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-lock.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/engine-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/hooks/guard-stop.mjs",
            "timeout": 120,
            "statusMessage": "One-engine guard: checking this turn's code"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/hooks/post-status-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/hooks/recordings-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
