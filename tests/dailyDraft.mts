import assert from "node:assert/strict";
import { dailySpinOrder, nextDailySpin, topPercent, shareText, pickSquare, dailyStreak } from "../lib/draft/daily";
const clubs = [{ name: "Arsenal", seasons: [2007, 2008, 2009] }, { name: "Chelsea", seasons: [2008, 2009] }, { name: "Everton", seasons: [2007, 2009] }];
const a = dailySpinOrder(clubs, "2026-11-27");
const b = dailySpinOrder([...clubs].reverse(), "2026-11-27");
assert.deepEqual(a, b, "same spins for everyone, whatever order the list arrives in");
assert.equal(a.length, 7, "every club-season once");
assert.equal(new Set(a.map((s) => s.club + s.year)).size, a.length);
assert.notDeepEqual(dailySpinOrder(clubs, "2026-11-28"), a, "a new day, new spins");
assert.deepEqual(nextDailySpin(a, new Set([`${a[0].club}-${a[0].year}`])), a[1]);
assert.equal(topPercent(80, [1, 2, 3]), null);
assert.equal(topPercent(80, [90, 80, 70, 60, 50, 40, 30, 20, 10, 5]), 20);
assert.equal(pickSquare(85, 85), "🟩"); assert.equal(pickSquare(81, 85), "🟨"); assert.equal(pickSquare(70, 85), "🟧");
const t = shareText("2026-11-27", "🟩".repeat(14), 86, 2, 12);
assert.ok(t.includes("27 Nov") && t.includes("86 pts · finished 2nd · top 12%") && t.includes("knowitball.co.uk/draft"), t);
assert.ok(shareText("2026-11-27", "🟩", 50, 11, null).includes("finished 11th"));
assert.ok(shareText("2026-11-27", "🟩", 50, 3, null).includes("finished 3rd"));
assert.equal(dailyStreak(["2026-11-25", "2026-11-26"], "2026-11-27"), 2);
console.log("dailyDraft: ok");
